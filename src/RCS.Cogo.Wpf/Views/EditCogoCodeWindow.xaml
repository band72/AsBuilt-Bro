<Window x:Class="RCS.Cogo.Wpf.Views.EditCogoCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Cogo Code" Height="480" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ───────────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBand}">
            <TextBlock Text="🔖  Edit Cogo Code"
                       VerticalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextPrimary}"/>
        </Border>

        <!-- ── Form ─────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16">

                <!-- Local Code -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="LOCAL CODE"/>
                <TextBox x:Name="txtLocalCode" Margin="0,0,0,12"/>

                <!-- System Code (read-only) -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="SYSTEM CODE  (read-only)"/>
                <TextBox x:Name="txtSystemCode" IsReadOnly="True"
                         ToolTip="System Codes are Read-Only"
                         Margin="0,0,0,12"/>

                <!-- Description (read-only) -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="DESCRIPTION  (read-only)"/>
                <TextBox x:Name="txtDescription" IsReadOnly="True"
                         ToolTip="Descriptions are Read-Only"
                         Margin="0,0,0,12"/>

                <!-- DXF Block -->
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="DXF BLOCK"
                           ToolTip="Select the DWG block to INSERT for this code when exporting to DXF.&#x0a;Sourced from the RCS_Blocks library."/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbBlock"
                              IsEditable="True" IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              TextSearch.TextPath="."
                              TextBoxBase.TextChanged="OnBlockTextChanged"/>
                    <Button Grid.Column="1" Content="⟳" Width="32" Margin="6,0,0,0"
                            Foreground="{StaticResource BrAccent}"
                            ToolTip="Smart-match closest block name from the library."
                            Click="OnAutoMatchBlock"/>
                </Grid>

                <!-- Block Scale -->
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="BLOCK SCALE"
                           ToolTip="DXF INSERT scale factor (X=Y=Z). 1.0 = full size."/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtBlockScale" Text="1.0"/>
                    <TextBlock Grid.Column="1" Text="  (1.0 = full size)"
                               VerticalAlignment="Center" FontStyle="Italic"
                               Foreground="{StaticResource BrTextMuted}"/>
                </Grid>

                <!-- Symbol Preview -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Symbol Preview:" VerticalAlignment="Center"
                               Foreground="{StaticResource BrTextSecondary}"
                               Margin="0,0,10,0"/>
                    <Image x:Name="imgPreview" Width="34" Height="34" Stretch="Uniform"/>
                    <TextBlock x:Name="lblBlockMatch" VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="{StaticResource BrAccent}" FontSize="11"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer ───────────────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource WindowFooterBand}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save"   Style="{StaticResource BtnPrimary}"
                        Width="90" Margin="0,0,8,0" Click="btnSave_Click"/>
                <Button Content="Delete" Style="{StaticResource BtnDanger}"
                        Width="90" Margin="0,0,8,0" Click="btnDelete_Click"/>
                <Button Content="Close"  Style="{StaticResource BtnGhost}"
                        Width="90" Click="btnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
