<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RCS.Cogo.Core\RCS.Cogo.Core.csproj" />
    <ProjectReference Include="..\RCS.Cogo.App\RCS.Cogo.App.csproj" />
    <ProjectReference Include="..\RCS.Piping.Core\RCS.Piping.Core.csproj" />
    <ProjectReference Include="..\RCS.Services\RCS.Services.csproj" />
    <ProjectReference Include="..\RCS.Data\RCS.Data.csproj" />
    <Content Include="validation_rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\AsBuiltDemo\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>AsBuiltDemo\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RCS.Cogo.AI\RCS.Cogo.AI.csproj" />
    <ProjectReference Include="..\RCS.Alignments.Core\RCS.Alignments.Core.csproj" />
    <ProjectReference Include="..\RCS.Geo.Wpf\RCS.Geo.Wpf.csproj" />
    <ProjectReference Include="..\RCS.Geo.ProjNet\RCS.Geo.ProjNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="EPPlus" Version="7.6.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.26">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.26" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Release identity -->
    <Version>3.0.3</Version>
    <AssemblyVersion>3.0.3.0</AssemblyVersion>
    <FileVersion>3.0.3.0</FileVersion>
    <AssemblyTitle>RCS COGO Enterprise</AssemblyTitle>
    <Company>Banks &amp; Banks Consulting</Company>
    <Copyright>© 2025 Banks &amp; Banks Consulting. All rights reserved.</Copyright>
    <Description>Advanced Survey and Utility Data Platform</Description>
  </PropertyGroup>

</Project>
