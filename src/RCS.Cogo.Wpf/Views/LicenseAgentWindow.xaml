<Window x:Class="RCS.Cogo.Wpf.Views.LicenseAgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RCS Licensing Agent" Height="550" Width="450"
        Background="{StaticResource BrBg}" Foreground="{StaticResource BrTextPrimary}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="RCS COGO Registration" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Chat with our secure virtual agent to activate your device." FontSize="12" Foreground="{StaticResource BrTextSecondary}" HorizontalAlignment="Center"/>
            <Separator Margin="0,10,0,0" Background="{StaticResource BrCard}"/>
        </StackPanel>

        <!-- Chat History -->
        <ListBox x:Name="ChatHistory" Grid.Row="1" Background="{StaticResource BrSurface}" BorderBrush="{StaticResource BrBorder}" Margin="0,0,0,10"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding Messages}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding AvatarColor}" CornerRadius="15" Width="30" Height="30" VerticalAlignment="Top" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Initial}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                        <Border Grid.Column="1" Background="{Binding BubbleColor}" CornerRadius="8" Padding="10">
                            <TextBlock Text="{Binding Text}" Foreground="{Binding TextColor}" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="TypingIndicator" Grid.Row="2" Text="Agent is typing..." Foreground="{StaticResource BrTextMuted}" FontStyle="Italic" Visibility="Collapsed" Margin="0,0,0,5"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" Height="40" Background="{StaticResource BrHeader}" Foreground="White" BorderBrush="{StaticResource BrBorder}" 
                     Padding="5" VerticalContentAlignment="Center" KeyDown="InputBox_KeyDown"/>
            <Button x:Name="SendBtn" Grid.Column="1" Content="Send" Width="80" Margin="10,0,0,0" 
                    Background="{StaticResource BrAccentDim}" Foreground="White" FontWeight="Bold" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
