<Window x:Class="RCS.Cogo.Wpf.Views.ValidationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Validation Settings" Height="700" Width="920"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">

    <Grid Background="{StaticResource BrBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBand}">
            <TextBlock Text="✅  Validation Rules Configuration"
                       VerticalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextPrimary}"/>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource BrSurface}"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding NoExplicitValidation}"
                          Content="Bypass All Validation Rules"
                          VerticalAlignment="Center"
                          Margin="0,0,24,0"
                          ToolTip="If checked, none of the rules below are enforced."/>
                <Button Content="Check All"  Command="{Binding CheckAllCommand}"
                        Width="90" Margin="0,0,8,0"/>
                <Button Content="Clear All"  Command="{Binding ClearAllCommand}"
                        Width="90"/>
            </StackPanel>
        </Border>

        <!-- Rules list -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,0"
                Margin="10,6,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CategoryGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Header="{Binding CategoryName}" IsExpanded="True"
                                      Foreground="{StaticResource BrTextSecondary}"
                                      Background="{StaticResource BrCard}"
                                      BorderBrush="{StaticResource BrBorder}"
                                      Margin="0,0,0,6">
                                <StackPanel Margin="12,6">
                                    <ItemsControl ItemsSource="{Binding Rules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="220"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsEnabled}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding FieldName}"
                                                               Foreground="{StaticResource BrAccent}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding RuleDescription, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             ToolTip="{Binding RuleDescription, Mode=OneWay}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Style="{StaticResource WindowFooterBand}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save &amp; Close" Click="Save_Click"
                        Style="{StaticResource BtnPrimary}" Width="130"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
