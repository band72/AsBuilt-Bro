<Window x:Class="RCS.Cogo.Wpf.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RCS.Cogo.Wpf.ViewModels"
        xmlns:views="clr-namespace:RCS.Cogo.Wpf.Views"
        xmlns:geo="clr-namespace:RCS.Geo.Wpf.Views;assembly=RCS.Geo.Wpf"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="800" Width="1200">

    <!-- BoolToVis shipped globally in RcsTheme.xaml — referenced as {StaticResource BoolToVis} -->

    <Grid Background="{StaticResource BrBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Padding="5,2">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Command="{Binding CloseCommand}"/>
                <Separator/>
                <MenuItem Header="_Export">
                    <MenuItem Header="Create Upload Package..." Command="{Binding CreateUploadPackageCommand}"/>
                    <Separator/>
                    <MenuItem Header="JEA As-Built Cogo Mix Script (.txt)..." Command="{Binding ExportJeaMixScriptCommand}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Project">
                <MenuItem Header="New Project..." Command="{Binding NewProjectCommand}"/>
                <MenuItem Header="Edit Project Details..." Command="{Binding EditProjectCommand}"/>
                <Separator/>
                <MenuItem Header="Save Project" Command="{Binding SaveProjectCommand}"/>
                <MenuItem Header="Save Project As..." Command="{Binding SaveProjectAsCommand}"/>
                <MenuItem Header="Open Project..." Command="{Binding OpenProjectCommand}"/>
                <MenuItem Header="Recent Files" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="Close Project" Command="{Binding CloseProjectCommand}"/>
                <Separator/>
                <MenuItem Header="Save Piping Network..." Command="{Binding SavePipingCommand}"/>
                <MenuItem Header="Load Piping Network..." Command="{Binding LoadPipingCommand}"/>
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="Report Configuration..." Command="{Binding OpenReportSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="Database Maintenance">
                    <MenuItem Header="Compact Database" Command="{Binding CompactDbCommand}"/>
                    <MenuItem Header="Verify Integrity" Command="{Binding VerifyDbCommand}"/>
                    <MenuItem Header="Repair Database" Command="{Binding RepairDbCommand}"/>
                    <Separator/>
                    <MenuItem Header="Export Database to CSV..." Command="{Binding ExportDbCsvCommand}"/>
                    <Separator/>
                </MenuItem>
                <MenuItem Header="General Settings" Command="{Binding OpenGeneralSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="Validation" Command="{Binding OpenValidationSettingsCommand}"/>
                <MenuItem Header="Pipe Characteristics..." Command="{Binding OpenPipeCharacteristicsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Data">
                <MenuItem Header="Convert Image..." Command="{Binding OpenConvertImageCommand}"/>
                <Separator/>
                <MenuItem Header="_Import">
                    <MenuItem Header="Process Batch Script..." Command="{Binding ImportBatchCommand}"/>
                    <MenuItem Header="Import DXF Linework..." Command="{Binding ImportDxfCommand}"/>
                    <Separator/>
                    <MenuItem Header="📥 Import JEA As-Built Template (.xlsx)..."
                              Command="{Binding ImportJeaTemplateCommand}"
                              FontWeight="SemiBold" Foreground="{StaticResource BrSuccess}"
                              ToolTip="Read a filled JEA As-Built Excel file and import records into the current project"/>
                    <MenuItem Header="🛠️ Generate 3D Piping Linework From JEA SQL Nodes..."
                              Command="{Binding GenerateJeaLineworkCommand}"
                              FontWeight="SemiBold" Foreground="{StaticResource BrInfo}"
                              ToolTip="Automatically generates structural nodes and dynamic pipe runs based on the internal database."/>
                    <MenuItem Header="🚀 New Project from Segment1A Excel (.xlsx)..."
                              Command="{Binding ImportS1AProjectCommand}"
                              FontWeight="Bold" Foreground="{StaticResource BrAmber}"
                              ToolTip="Creates the 70498-S1A project and imports all Segment1A tables in one step"/>
                </MenuItem>
                <MenuItem Header="_Export">
                    <!-- ═══ JEA As-Built Deliverable ═════════════════════ -->
                    <MenuItem Command="{Binding ValidateJeaCommand}"
                              FontWeight="SemiBold" Foreground="{StaticResource BrAmber}"
                              ToolTip="Check all project assets against JEA validation rules before export">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍 Validate JEA Data..."/>
                                <!-- Live issue-count badge — visible only after a validation run -->
                                <Border Background="{StaticResource BrError}" CornerRadius="6"
                                        Margin="8,0,0,0" Padding="5,1"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding JeaValidationBadgeVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding JeaValidationBadgeText}"
                                               Foreground="White" FontSize="11"
                                               FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Header="🏛 Export JEA As-Built Template (.xlsx)..."
                              Command="{Binding ExportJeaTemplateCommand}"
                              FontWeight="SemiBold" Foreground="{StaticResource BrInfo}"
                              ToolTip="Fill the JEA As-Built Template with all project utility data and save as .xlsx"/>
                    <Separator/>
                    <!-- ═════════════════════════════════════════════════== -->
                    <MenuItem Header="Export Output Log to TXT..." Command="{Binding ExportOutputLogCommand}"/>
                    <Separator/>
                    <MenuItem Header="Export Script..." Command="{Binding ExportScriptCommand}"/>
                    <Separator/>
                    <MenuItem Header="Export Points (TXT)..." Command="{Binding ExportPointsTxtCommand}"/>
                    <MenuItem Header="Export Points (XML)..." Command="{Binding ExportPointsXmlCommand}"/>
                    <Separator/>
                    <MenuItem Header="Save Piping Network..." Command="{Binding SavePipingCommand}"/>
                    <Separator/>
                    <MenuItem Header="Export Installed Assets Report..." Command="{Binding ExportInstalledAssetsCommand}"/>
                    <Separator/>
                    <MenuItem Header="Export to DXF..." Command="{Binding ExportDxfCommand}"/>
                    <MenuItem Header="Export BOM to CSV..." Command="{Binding ExportBomCommand}"/>
                    <Separator/>
                    <MenuItem Header="Export EPANET INP..." Command="{Binding ExportEpanetCommand}"/>
                    <MenuItem Header="Export Appurtenance Schedule..." Command="{Binding ExportScheduleCommand}"/>
                </MenuItem>

            </MenuItem>
            <MenuItem Header="_Figures" Command="{Binding OpenFiguresWindowCommand}"/>
            <MenuItem Header="_Alignments">
                <MenuItem Header="Edit Alignment..." Command="{Binding OpenAlignmentWindowCommand}"/>
                <MenuItem Header="Cross Sections..." Command="{Binding OpenCrossSectionWindowCommand}"/>
                <Separator/>

                <MenuItem Header="Save Horizontal Alignment" Command="{Binding SaveHorizontalAlignmentCommand}"/>
                <MenuItem Header="Save Vertical Alignment" Command="{Binding SaveVerticalAlignmentCommand}"/>
                <Separator/>
                <MenuItem Header="Delete Horizontal Alignment..." Command="{Binding DeleteHorizontalAlignmentCommand}"/>
                <MenuItem Header="Delete Vertical Alignment..." Command="{Binding DeleteVerticalAlignmentCommand}"/>
                <Separator/>
                <MenuItem Header="Settings..." Command="{Binding OpenAlignmentSettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Assets">
                <MenuItem Header="PAP (Points Along Pipe)" Command="{Binding OpenPapCommand}"/>
            </MenuItem>
            <MenuItem Header="_Reports">
                <MenuItem Header="Water" Command="{Binding ReportWaterCommand}"/>
                <MenuItem Header="Sewer" Command="{Binding ReportSewerCommand}"/>
                <MenuItem Header="Gas" Command="{Binding ReportGasCommand}"/>
                <MenuItem Header="Electric" Command="{Binding ReportElectricCommand}"/>
                <MenuItem Header="Drainage" Command="{Binding ReportDrainageCommand}"/>
                <Separator/>
                <MenuItem Header="Utility Report-0-ft" Command="{Binding ReportUtilityZeroFootCommand}"/>
                <Separator/>
                <MenuItem Header="All Assets CSV" Command="{Binding ReportAllAssetsCsvCommand}"/>
                <MenuItem Header="All Assets TXT" Command="{Binding ReportAllAssetsTxtCommand}"/>
                <MenuItem Header="All Assets XLS" Command="{Binding ReportAllAssetsXlsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tables">
                <MenuItem Header="🗂 Force Main Fittings..."
                          Command="{Binding OpenTablesCommand}" CommandParameter="0"
                          ToolTip="Force Main Fitting Location Table → export to DXF"/>
                <MenuItem Header="🗂 Sanitary Manholes..."
                          Command="{Binding OpenTablesCommand}" CommandParameter="1"
                          ToolTip="Sanitary Manholes → export to DXF"/>
                <MenuItem Header="🗂 Water Main Fittings..."
                          Command="{Binding OpenTablesCommand}" CommandParameter="2"
                          ToolTip="Water Main Fitting Location Table → export to DXF"/>
                <MenuItem Header="🗂 Water Valve Detail..."
                          Command="{Binding OpenTablesCommand}" CommandParameter="3"
                          ToolTip="Water Valve Detail Table → export to DXF"/>
                <MenuItem Header="🗂 Hydrant Table..."
                          Command="{Binding OpenTablesCommand}" CommandParameter="4"
                          ToolTip="Hydrant Table → export to DXF"/>
                <MenuItem Header="🗂 Water Services..."
                          Command="{Binding OpenTablesCommand}" CommandParameter="5"
                          ToolTip="Water Services Table → export to DXF"/>
                <MenuItem Header="🗂 Locate Wire Boxes..."
                          Command="{Binding OpenTablesCommand}" CommandParameter="6"
                          ToolTip="Locate Wire Box Table → export to DXF"/>
                <Separator/>
                <MenuItem Header="📐 All Tables (all tabs)..."
                          Command="{Binding OpenTablesCommand}" CommandParameter="-1"
                          FontWeight="SemiBold" Foreground="{StaticResource BrTeal}"
                          ToolTip="Open all 7 tables in one window"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <!-- ═══ EXAMPLE PROJECT — recommended first stop ═══ -->
                <MenuItem Header="🚀 Example Project (Oakwood Water Main)" FontWeight="Bold" Foreground="{StaticResource BrSuccess}">
                    <MenuItem Header="📋 Step-by-Step Walkthrough Guide"
                              Command="{Binding OpenExampleWalkthroughCommand}"
                              FontWeight="SemiBold"
                              ToolTip="Opens the full end-to-end project walkthrough in your default text editor.&#x0a;Covers: project creation → MAPCHECK → DXF export → submission checklist."/>
                    <MenuItem Header="📂 Load Oakwood Example Script into Editor"
                              Command="{Binding LoadOakwoodExampleCommand}"
                              ToolTip="Loads the JEA_Oakwood_WaterMain_70498-W1A.cogo script into the Script Editor.&#x0a;Run it to see a complete as-built project in action."/>
                    <Separator/>
                    <MenuItem Header="📥 Data Import Reference Guide"
                              Command="{Binding OpenImportReferenceCommand}"
                              ToolTip="All import formats explained: COGO script, PNEZD text file, JEA Excel template, Pipe CSV.&#x0a;Includes column layouts, examples, rules, and common error fixes."/>
                </MenuItem>
                <Separator/>
                <!-- ═══ AS-BUILT DEMO PROJECT ═══ -->
                <MenuItem Header="🏗 AsBuilt Demo  (W-04471)" FontWeight="Bold" Foreground="{StaticResource BrTeal}">
                    <MenuItem Header="📂 Open Demo Project Folder"
                              Click="OpenAsBuiltDemoFolder_Click"
                              ToolTip="Opens the pre-built JEA W-04471 demo project in File Explorer.&#x0a;Folder: Desktop\AsBuilt_Demo\JEA-2024-W-04471_Rev1_04122025"/>
                    <MenuItem Header="📋 Open Load Order Guide"
                              Click="OpenAsBuiltDemoReadme_Click"
                              ToolTip="Opens README_LOAD_ORDER.txt — step-by-step import guide for the demo project."/>
                    <MenuItem Header="📍 Load Demo Points into Editor"
                              Click="LoadAsBuiltDemoPnezd_Click"
                              ToolTip="Loads W-04471_PNEZD.csv into the Script Editor so you can see the survey point format."/>
                    <MenuItem Header="📜 Load Demo COGO Script into Editor"
                              Click="LoadAsBuiltDemoCogo_Click"
                              ToolTip="Loads W-04471_COGO.cogo into the Script Editor — shows full PRUN network syntax."/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="📖 User Manual" Command="{Binding OpenManualCommand}"/>
                <MenuItem Header="Survey Commands" Command="{Binding OpenSurveyCommandsCommand}"/>
                <MenuItem Header="Pipe Commands" Command="{Binding OpenPipeCommandsCommand}"/>
                <MenuItem Header="🎓 Survey Tutorials" FontWeight="SemiBold" Foreground="{StaticResource BrSuccess}">
                    <MenuItem Header="T01: Coordinates and Inverse" Command="{Binding OpenTutorial01Command}"/>
                    <MenuItem Header="T02: Traverse" Command="{Binding OpenTutorial02Command}"/>
                    <MenuItem Header="T03: Rotation" Command="{Binding OpenTutorial03Command}"/>
                    <MenuItem Header="T04: Translation" Command="{Binding OpenTutorial04Command}"/>
                    <MenuItem Header="T05: Alignment, Profile &amp; Cross Section" Command="{Binding OpenTutorial05Command}"/>
                    <MenuItem Header="T06: Horizontal Curves" Command="{Binding OpenTutorial06Command}"/>
                    <MenuItem Header="T07: Full Road Design" Command="{Binding OpenTutorial07Command}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Azimuth Script" Command="{Binding OpenExampleCogoCommand}"/>
                <MenuItem Header="Bearing Script" Command="{Binding OpenExampleBearingCommand}"/>
                <MenuItem Header="Pipe Script" Command="{Binding OpenExamplePipeCommand}"/>
                <MenuItem Header="Mix Script" Command="{Binding OpenExampleMixCommand}"/>
                <MenuItem Header="Cogo Figures" Command="{Binding OpenExampleFiguresCommand}"/>
                <MenuItem Header="Angle Script" Command="{Binding OpenExampleAngleCommand}"/>
                <Separator/>
                <MenuItem Header="🗃 Civil 3D Table Extraction" FontWeight="SemiBold" Foreground="{StaticResource BrAmber}">
                    <MenuItem.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="420">
                                <TextBlock Text="Civil 3D → Excel Extraction Workflow" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                    Text="Extracts data from Civil 3D Point Tables (Water Fittings, Valves, Wire Boxes, Top-of-Pipe) and imports them into the JEA As-Built template."/>

                                <TextBlock Text="STEP 1 — Run LISP inside Civil 3D:" FontWeight="Bold" Foreground="{StaticResource BrAmber}" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="1. In Civil 3D, type APPLOAD → load export_tables.lsp"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="2. Type DUMPTABLE → press Enter"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="3. Select the exploded *U block references → press Enter"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="4. Output CSV saved to: C:\Temp\table_dump.txt  (repeat for each table)"/>

                                <TextBlock Text="STEP 2 — Convert dumps to Excel:" FontWeight="Bold" Foreground="{StaticResource BrAmber}" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="Run export_acad_tables.py to convert all 4 dump files into individual .xlsx files with columns remapped to JEA template column order."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource BrTextMuted}"
                                    Text="python export_acad_tables.py"/>

                                <TextBlock Text="STEP 3 — Import into this app:" FontWeight="Bold" Foreground="{StaticResource BrAmber}" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap"
                                    Text="Use Data → Import → 🚀 New Project from Segment1A Excel (.xlsx)... to load all tables in one step."/>

                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource BrTextMuted}" FontStyle="Italic"
                                    Text="Files: export_tables.lsp  |  export_acad_tables.py  (repo root)"/>
                            </StackPanel>
                        </ToolTip>
                    </MenuItem.ToolTip>
                    <MenuItem Header="📋 Step 1: Load DUMPTABLE into Civil 3D"
                              IsEnabled="False" Foreground="{StaticResource BrTextMuted}"
                              ToolTip="In Civil 3D: APPLOAD → export_tables.lsp → type DUMPTABLE → select table blocks → Enter"/>
                    <MenuItem Header="⚙ Step 2: Convert Dumps to Excel (export_acad_tables.py)"
                              IsEnabled="False" Foreground="{StaticResource BrTextMuted}"
                              ToolTip="Run: python export_acad_tables.py  —  reads C:\...\table-ssmc\table_dump*.txt and writes 4 xlsx files"/>
                    <MenuItem Header="📥 Step 3: Import via Data → Import → Segment1A Excel"
                              IsEnabled="False" Foreground="{StaticResource BrTextMuted}"
                              ToolTip="Use the 🚀 New Project from Segment1A Excel command to load all 4 tables into the project database"/>
                    <Separator/>
                    <MenuItem Header="📁 Open Extraction Scripts Folder" Command="{Binding OpenExtractionScriptsFolderCommand}"
                              ToolTip="Opens the repo root folder containing export_tables.lsp and export_acad_tables.py"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Test C++ Security Integration" Command="{Binding TestNativeSecurityCommand}"/>
                <MenuItem Header="Licensing Agent Chat" Command="{Binding OpenLicensingAgentCommand}"/>
                <Separator/>
                <!-- Discipline Divider -->
                <MenuItem Header="Discipline Examples" IsEnabled="False" FontWeight="Bold"/>
                <MenuItem Header="Gas Script" Command="{Binding OpenExampleGasCommand}"/>
                <MenuItem Header="Electric Script" Command="{Binding OpenExampleElectricCommand}"/>
                <MenuItem Header="Water Script" Command="{Binding OpenExampleWaterCommand}"/>
                <MenuItem Header="Waste Water Script" Command="{Binding OpenExampleWwCommand}"/>
                <MenuItem Header="Storm Script" Command="{Binding OpenExampleStormCommand}"/>
                <MenuItem Header="Reclaimed Script" Command="{Binding OpenExampleRcCommand}"/>
                <MenuItem Header="Chilled Script" Command="{Binding OpenExampleChCommand}"/>
                <Separator/>
                <MenuItem Header="Robust Test Scripts V2" IsEnabled="False" FontWeight="Bold"/>
                <MenuItem Header="Cogo Script V2" Command="{Binding OpenExampleCogoV2Command}"/>
                <MenuItem Header="Water Script V2" Command="{Binding OpenExampleWaterV2Command}"/>
                <MenuItem Header="Storm Script V2" Command="{Binding OpenExampleStormV2Command}"/>
                <MenuItem Header="Sewer Script V2" Command="{Binding OpenExampleSewerV2Command}"/>
                <MenuItem Header="Waste Water Script V2" Command="{Binding OpenExampleWwV2Command}"/>
                <MenuItem Header="Gas Script V2" Command="{Binding OpenExampleGasV2Command}"/>
                <MenuItem Header="Electric Script V2" Command="{Binding OpenExampleElectricV2Command}"/>
                <Separator/>
                <MenuItem Header="Report a Bug / Error..." Command="{Binding OpenErrorReportCommand}" Foreground="{StaticResource BrError}" FontWeight="Bold"/>
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="594"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="260"/>

            </Grid.RowDefinitions>

        <!-- Left Pane: Console / History -->
        <Grid Grid.Column="0" Grid.Row="0" Margin="10">
            <TabControl Background="{StaticResource BrSurface}" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}" SelectionChanged="TabControl_SelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="2">
                                        <ContentPresenter x:Name="ContentSite"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ContentSource="Header"
                                            Margin="10,2"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC" />
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter Property="Foreground" Value="#CCCCCC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="TabControl">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabControl">
                                    <Grid Background="{StaticResource BrSurface}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <!-- Tab strip — WrapPanel lets tabs flow to a second row -->
                                        <Border Grid.Row="0"
                                                Background="{StaticResource BrHeader}"
                                                BorderBrush="{StaticResource BrBorder}"
                                                BorderThickness="0,0,0,1">
                                            <WrapPanel IsItemsHost="True"
                                                       Background="Transparent"
                                                       Orientation="Horizontal"/>
                                        </Border>
                                        <!-- Content row -->
                                        <Border Grid.Row="1"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                BorderBrush="{TemplateBinding BorderBrush}">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Background="Transparent"
                                                          Padding="0,0,10,0">
                                                <ContentPresenter ContentSource="SelectedContent"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
                </TabControl.Resources>
                
                <!-- Tab 1: Points -->
                <TabItem Header="Points">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                 <ColumnDefinition Width="Auto"/>
                                 <ColumnDefinition Width="Auto"/>
                                 <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Import -->
                            <Button Grid.Column="0" Content="Import Text..."
                                    Command="{Binding ImportPointsListCommand}"
                                    Padding="10,5" Margin="0,0,8,0"
                                    Background="{StaticResource BrHeader}" Foreground="White"/>
                            <!-- Export TXT -->
                            <Button Grid.Column="1" Content="Export TXT"
                                    Command="{Binding ExportPointsTxtCommand}"
                                    Padding="10,5" Margin="0,0,8,0"
                                    Background="{StaticResource BrHeader}" Foreground="White"/>
                            <!-- Export XML -->
                            <Button Grid.Column="2" Content="Export XML"
                                    Command="{Binding ExportPointsXmlCommand}"
                                    Padding="10,5" Margin="0,0,8,0"
                                    Background="{StaticResource BrHeader}" Foreground="White"/>
                            <!-- Save -->
                            <Button Grid.Column="3" Content="Save"
                                    Command="{Binding SavePointsCommand}"
                                    Padding="10,5" Margin="0,0,8,0"
                                    Background="{StaticResource BrSuccess}" Foreground="White" FontWeight="Bold"
                                    ToolTip="Save Points to Database"/>
                            <!-- Refresh -->
                            <Button Grid.Column="4" Content="Refresh"
                                    Command="{Binding RefreshPointsCommand}"
                                    Padding="10,5" Margin="0,0,0,0"
                                    Background="{StaticResource BrBg}" Foreground="White"
                                    BorderBrush="{StaticResource BrBorder}" BorderThickness="1"
                                    ToolTip="Validate points against local codes"/>

                            <!-- ── Live Quick-Filter ─────────────────────────────── -->
                            <Grid Grid.Column="6" Width="220" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBox x:Name="PointsFilterBox"
                                         Text="{Binding PointsFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="4,3" FontFamily="Segoe UI" FontSize="13"
                                         ToolTip="Filter by Point# or Description"
                                         Background="{StaticResource BrSurface}" Foreground="{StaticResource BrTextPrimary}"
                                         BorderBrush="{StaticResource BrBorder}" BorderThickness="1"/>
                                <!-- Placeholder hint (visible only when empty) -->
                                <TextBlock IsHitTestVisible="False" Text="🔍  Filter points..."
                                           Foreground="{StaticResource BrTextMuted}" FontSize="12"
                                           VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PointsFilter}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Clear filter button -->
                            <Button Grid.Column="7" Content="✕"
                                    Command="{Binding ClearPointsFilterCommand}"
                                    Width="26" Margin="4,0,0,0"
                                    Background="{StaticResource BrBorder}" Foreground="{StaticResource BrTextMuted}"
                                    BorderThickness="0" FontWeight="Bold"
                                    ToolTip="Clear filter"/>


                            <!-- ── KML Export ── -->
                            <Button Grid.Column="8"
                                    Content="&#x1F5FA; KML"
                                    Command="{Binding ExportKmlCommand}"
                                    Padding="8,5" Margin="4,0,0,0"
                                    ToolTip="Export all points as KML for Google Earth / Maps"
                                    Background="#1A2535" Foreground="#61AFEF"
                                    BorderBrush="#1A4A6E" BorderThickness="1"/>
                            <!-- ── KML Import ── -->
                            <Button Grid.Column="9"
                                    Content="&#x1F4E5; KML"
                                    Command="{Binding ImportKmlCommand}"
                                    Padding="8,5" Margin="4,0,0,0"
                                    ToolTip="Import points from a KML file (Google Earth / Maps)"
                                    Background="#1A2535" Foreground="#98C379"
                                    BorderBrush="#3A6A3A" BorderThickness="1"/>

                            <!-- ── GPS Columns toggle ── -->
                            <ToggleButton Grid.Column="10"
                                          Content="&#x1F30D; GPS"
                                          IsChecked="{Binding ShowGpsColumnsInGrid}"
                                          Padding="8,5" Margin="4,0,0,0"
                                          ToolTip="Show / hide Latitude &amp; Longitude columns"
                                          Background="#1A2535" Foreground="#98C379"
                                          BorderBrush="#3A6A3A" BorderThickness="1"/>
                        </Grid>

                        <!-- ── GPS Zone Warning Banner ── -->
                        <Border Grid.Row="1" Background="#2A2000" CornerRadius="4" Margin="0,4,0,0" Padding="10,6"
                                Visibility="{Binding GpsZoneWarningVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding GpsZoneWarning}"
                                       Foreground="#FFD700" FontWeight="Bold" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>


                        <DataGrid Grid.Row="2" ItemsSource="{Binding PointsView}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                                  BorderThickness="1" BorderBrush="{StaticResource BrBorder}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Point Number" SortMemberPath="NumericId" Width="80" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Padding="5">
                                                <Hyperlink Command="{Binding DataContext.ZoomToImportedPointCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                           CommandParameter="{Binding}" Foreground="{StaticResource BrAccent}" TextDecorations="Underline">
                                                    <TextBlock Text="{Binding Id}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Northing" Binding="{Binding Northing, StringFormat=F3}" Width="*"/>
                                <DataGridTextColumn Header="Easting" Binding="{Binding Easting, StringFormat=F3}" Width="*"/>
                                <DataGridTextColumn Header="Elevation" Binding="{Binding Elevation, StringFormat=F3}" Width="80"/>
                                 <!-- ── GPS Lat/Lon columns (toggleable) ── -->
                                 <DataGridTextColumn Header="Latitude" Binding="{Binding LatitudeDisplay}"
                                                     Width="*" IsReadOnly="True"
                                                     Visibility="{Binding DataContext.ShowGpsColumnsInGrid,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid},
                                                                  Converter={StaticResource BoolToVis}}"/>
                                 <DataGridTextColumn Header="Longitude" Binding="{Binding LongitudeDisplay}"
                                                     Width="*" IsReadOnly="True"
                                                     Visibility="{Binding DataContext.ShowGpsColumnsInGrid,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid},
                                                                  Converter={StaticResource BoolToVis}}"/>
                                
                                <DataGridTemplateColumn Header="Description" SortMemberPath="Description" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Description}" VerticalAlignment="Center" Margin="2,0"/>
                                                
                                                <!-- Feedback Icon -->
                                                <TextBlock Grid.Column="1" Text="✔" Foreground="LimeGreen" FontWeight="Bold" Margin="5,0"
                                                           Visibility="{Binding IsValidCode, Converter={StaticResource BoolToVis}}"/>
                                                
                                                <!-- 
                                                Actually, I need to Highlight RED if INCORRECT.
                                                If IsValidCode is false, show Red X or background?
                                                "Highlight in green and with a check mark those codes that match... Highlight in red missing or incorrect matches." 
                                                -->
                                                <TextBlock Grid.Column="1" Text="❌" Foreground="Red" FontWeight="Bold" Margin="5,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsValidCode}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <!-- ContextMenu: GPS Coordinates & Zoom to Point -->
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="&#127758;  Show GPS Coordinates"
                                              Command="{Binding PlacementTarget.DataContext.ShowGpsCoordinatesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              ToolTip="Display and copy Lat/Lon (DD or DMS per Settings) for the selected point"/>
                                    <Separator/>
                                    <MenuItem Header="&#128269;  Zoom to Point"
                                              Command="{Binding PlacementTarget.DataContext.ZoomToImportedPointCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                     <Separator/>
                                     <MenuItem Header="&#127759;  Open in Google Maps"
                                               Command="{Binding PlacementTarget.DataContext.OpenInGoogleMapsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                               CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                               ToolTip="Open selected point coordinates in Google Maps (default browser)"/>
                                     <Separator/>
                                     <MenuItem Header="&#9888;  Detect GPS Zone"
                                               Command="{Binding PlacementTarget.DataContext.AnalyzeGpsZoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                               ToolTip="Analyze loaded point Eastings to verify the correct FL State Plane zone is selected"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>

                            
                            <!-- Row Style for Red Highlight on mismatch? 
                                 "Highlight in green... codes that match... Highlight in red missing or incorrect matches."
                                 Maybe highlight the cell background or text? 
                                 Let's do Description Cell Style. -->
                            <!-- 
                            Actually, DataGridTemplateColumn handles the content. 
                            Let's add a style to the DataGridRow or Cell to change background slightly.
                            -->
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Cogo (Renamed from Cogo Manual) -->
                <TabItem Header="Cogo" FocusManager.FocusedElement="{Binding ElementName=CogoInputTextBox}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <ListBox Grid.Row="0" ItemsSource="{Binding CommandLog}" Margin="0,0,0,10"
                                 Background="{StaticResource BrBg}" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" Foreground="{StaticResource BrTextPrimary}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <!-- Floating Command Hint -->
                        <Border Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                                Background="{StaticResource BrSurface}" Margin="5,0,0,5" Padding="8,5" CornerRadius="3" MinWidth="100">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CommandHint}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CommandHint}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CommandHint}" Foreground="White" FontFamily="Consolas" FontSize="14"/>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CogoInputTextBox" Grid.Column="0" Text="{Binding CommandInput, UpdateSourceTrigger=PropertyChanged}" 
                                     FontFamily="Consolas" FontSize="16" Height="30">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SubmitCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="✨ AI Helper" Command="{Binding OpenConvertImageCommand}" 
                                    Margin="5,0,0,0" Padding="15,0" Background="{StaticResource BrAccentDim}" Foreground="White" FontWeight="Bold" ToolTip="Open AI Vision to COGO Translator"/>
                        </Grid>
                    </Grid>
                </TabItem>
                
                <!-- Tab 2: Batch Script -->
                <TabItem Header="Cogo Script">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Toolbar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Import Script" Command="{Binding ImportBatchCommand}" 
                                    Padding="10,5" Margin="0,0,10,0" Background="{StaticResource BrHeader}" Foreground="White"/>
                            <Button Content="Run Script" Command="{Binding RunBatchCommand}" 
                                    Padding="10,5" Margin="0,0,10,0" Background="{StaticResource BrAccentDim}" Foreground="White" FontWeight="Bold"/>
                            <Button Content="Walk Script" Command="{Binding WalkBatchCommand}" 
                                    Padding="10,5" Margin="0,0,10,0" Background="{StaticResource BrSuccess}" Foreground="White" FontWeight="Bold"/>

                            <ToggleButton Content="P" IsChecked="{Binding ShowPointNumbers}" 
                                    Width="30" Margin="0,0,5,0" Background="{StaticResource BrCard}" Foreground="White" FontWeight="Bold" ToolTip="Toggle Point Numbers"/>
                            <ToggleButton Content="X" IsChecked="{Binding ShowPointMarkers}" 
                                    Width="30" Margin="0,0,5,0" Background="{StaticResource BrCard}" Foreground="White" FontWeight="Bold" ToolTip="Toggle Point Markers"/>
                            <ToggleButton Content="L" IsChecked="{Binding ShowFigureLabels}" 
                                    Width="30" Margin="0,0,10,0" Background="{StaticResource BrCard}" Foreground="White" FontWeight="Bold" ToolTip="Toggle Figure Labels"/>

                            <Button Content="DXF" Command="{Binding ExportDxfCommand}" 
                                    Padding="10,5" Margin="0,0,10,0" Background="{StaticResource BrHeader}" Foreground="White"/>
                            <Button Content="TXT" Command="{Binding ExportScriptCommand}" 
                                    Padding="10,5" Margin="0,0,10,0" Background="{StaticResource BrHeader}" Foreground="White"/>
                            <Button Content="Save Figures" Command="{Binding SaveFiguresCommand}" 
                                    Padding="10,5" Margin="0,0,10,0" Background="{StaticResource BrAccentDim}" Foreground="White" FontWeight="Bold" ToolTip="Save all figures to database"/>
                            <Button Content="✨ AI" Command="{Binding AnalyzeScriptCommand}" 
                                    Padding="10,5" Background="{StaticResource BrAccentDim}" Foreground="White" FontWeight="Bold" ToolTip="AI Script Validator"/>
                        </StackPanel>
                        
                        <!-- Editor -->
                        <TextBox Grid.Row="1" Text="{Binding BatchScriptContent}"
                                 FontFamily="Consolas" FontSize="14"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Padding="8,6"
                                 Background="{StaticResource BrBg}"
                                 Foreground="{StaticResource BrTextPrimary}"
                                 BorderThickness="1"/>
                                 
                        <Grid Grid.Row="2" Margin="0,5,0,0">
                            <TextBlock Text="Use // for comments" Foreground="Gray" FontStyle="Italic"/>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRunningScript, Converter={StaticResource BoolToVis}}">
                                <ProgressBar IsIndeterminate="True" Width="200" Height="10" Margin="0,0,10,0" Foreground="{StaticResource BrSuccess}"/>
                                <TextBlock Text="Running Script..." Foreground="{StaticResource BrSuccess}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                
                <!-- Tab 3: Curve Solver -->
                <TabItem Header="Curve Solver">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Enter exactly two values:" Margin="0,0,0,10" Foreground="Gray" FontStyle="Italic"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Radius (R):" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurveRadius, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tangent (T):" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurveTangent, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
                        
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Chord (C):" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurveChord, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
                        
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Arc Length (L):" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurveArc, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
                        
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Delta (DD):" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurveDelta, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
                        
                        <!-- DMS Output -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Delta (DMS):" VerticalAlignment="Center" Margin="0,5,10,5" Foreground="Gray"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding CurveDeltaDms, Mode=OneWay}" IsReadOnly="True" Margin="0,5" Background="{StaticResource BrBg}" BorderThickness="0"/>
                        
                        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Content="Solve" Command="{Binding SolveCurveCommand}" 
                                    Width="75" Margin="0,0,10,0" Padding="10,5" 
                                    Background="{StaticResource BrHeader}" Foreground="White" BorderBrush="White" BorderThickness="1" FontWeight="Bold"/>
                            <Button Command="{Binding ClearCurveSolverCommand}" Content="Clear" 
                                    Width="75" Padding="10,5"
                                    Background="{StaticResource BrHeader}" Foreground="White" BorderBrush="White" BorderThickness="1" FontWeight="Bold"/>
                        </StackPanel>

                        <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="Results will update above and in Output Log." Margin="0,10,0,0" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"/>
                        
                        <!-- Utilities Section -->
                        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Margin="0,20,0,0">
                            <Rectangle Height="1" Fill="#3E3E42" Margin="0,0,0,10"/>
                            <TextBlock Text="Utilities" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                            
                            <!-- DMS Converter -->
                            <TextBlock Text="Decimal to DMS Converter:" Foreground="{StaticResource BrTextSecondary}" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding UtilDecInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter Decimal Degrees" Margin="0,0,5,0"/>
                                <Button Grid.Column="1" Command="{Binding UtilConvertCommand}" Content="Convert" Padding="10,2" Background="{StaticResource BrCard}" Foreground="White"/>
                            </Grid>
                            <TextBlock Text="{Binding UtilDmsOutput}" Foreground="Cyan" Margin="0,0,0,15" FontWeight="Bold" HorizontalAlignment="Right"/>

                            <!-- DMS to DD Converter -->
                            <TextBlock Text="DMS to Decimal Converter:" Foreground="{StaticResource BrTextSecondary}" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding UtilDmsInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter DMS" Margin="0,0,5,0"/>
                                <Button Grid.Column="1" Command="{Binding UtilConvertDmsToDdCommand}" Content="Convert" Padding="10,2" Background="{StaticResource BrCard}" Foreground="White"/>
                            </Grid>
                            <TextBlock Text="{Binding UtilDdOutput}" Foreground="Cyan" Margin="0,0,0,15" FontWeight="Bold" HorizontalAlignment="Right"/>

                            <!-- Supplement Finder -->
                            <TextBlock Text="Supplement Finder (180 - Angle):" Foreground="{StaticResource BrTextSecondary}" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding UtilSuppInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter Angle (Decimal Degrees)" Margin="0,0,5,0"/>
                                <Button Grid.Column="1" Command="{Binding UtilSupplementCommand}" Content="Convert" Padding="10,2" Background="{StaticResource BrCard}" Foreground="White"/>
                            </Grid>
                            <TextBlock Text="{Binding UtilSuppOutput}" Foreground="Cyan" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,0,15"/>

                            <!-- Bearing Math -->
                            <TextBlock Text="Add or Subtract:" Foreground="{StaticResource BrTextSecondary}" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBox Width="120" Text="{Binding Bearing1Input, UpdateSourceTrigger=PropertyChanged}" ToolTip="First Bearing (DMS)" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <StackPanel Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Button Content="+" Command="{Binding AddBearingsCommand}" Padding="5,0" Background="{StaticResource BrCard}" Foreground="White" Margin="0,0,0,2" Width="30"/>
                                    <Button Content="-" Command="{Binding SubtractBearingsCommand}" Padding="5,0" Background="{StaticResource BrCard}" Foreground="White" Width="30"/>
                                </StackPanel>
                                <TextBox Width="120" Text="{Binding Bearing2Input, UpdateSourceTrigger=PropertyChanged}" ToolTip="Second Bearing (DMS)" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="{Binding BearingMathDdOutput}" Foreground="Cyan" FontWeight="Bold"/>
                                <TextBlock Text="{Binding BearingMathDmsOutput}" Foreground="Cyan" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>
                
                <!-- Tab 4: Piping Network -->
                <TabItem Header="Piping">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 0 Header Pipe -->
                            <RowDefinition Height="Auto"/> <!-- 1 From -->
                            <RowDefinition Height="Auto"/> <!-- 2 To -->
                            <RowDefinition Height="Auto"/> <!-- 3 Dia -->
                            <RowDefinition Height="Auto"/> <!-- 4 Inverts -->
                            <RowDefinition Height="Auto"/> <!-- 5 Slope/Calc -->
                            <RowDefinition Height="Auto"/> <!-- 6 Add Button -->
                            <RowDefinition Height="150"/>  <!-- 7 Pipe List -->
                            <RowDefinition Height="Auto"/> <!-- 8 Divider -->
                            <RowDefinition Height="Auto"/> <!-- 9 Header Struct -->
                            <RowDefinition Height="Auto"/> <!-- 10 Pt ID -->
                            <RowDefinition Height="Auto"/> <!-- 11 Type -->
                            <RowDefinition Height="Auto"/> <!-- 12 Add Struct Button -->
                            <RowDefinition Height="*"/>    <!-- 13 Struct List -->
                            <RowDefinition Height="Auto"/> <!-- 14 Validate -->
                            <RowDefinition Height="Auto"/> <!-- 16 Sync -->
                            <RowDefinition Height="Auto"/> <!-- 15 Save/Load -->
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- PIPES -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Pipe Runs" FontWeight="Bold" Margin="0,0,0,5" Foreground="Cyan"/>
                        
                        <TextBlock Grid.Row="1" Text="From:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PipeFromId, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>

                        <TextBlock Grid.Row="2" Text="To:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PipeToId, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>

                        <TextBlock Grid.Row="3" Text="Dia:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PipeDiameter, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>

                        <!-- Inverts -->
                        <TextBlock Grid.Row="4" Text="Inverts:" VerticalAlignment="Center" Margin="0,2"/>
                        <Grid Grid.Row="4" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PipeInvStart, UpdateSourceTrigger=PropertyChanged}" Margin="5,2" ToolTip="Start Invert"/>
                            <TextBox Grid.Column="1" Text="{Binding PipeInvEnd, UpdateSourceTrigger=PropertyChanged}" Margin="5,2" ToolTip="End Invert"/>
                        </Grid>

                        <!-- Slope -->
                        <TextBlock Grid.Row="5" Text="Slope:" VerticalAlignment="Center" Margin="0,2"/>
                        <Grid Grid.Row="5" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PipeSlope}" IsReadOnly="True" Margin="5,2" Background="{StaticResource BrSurface}" Foreground="LightGreen"/>
                            <Button Grid.Column="1" Content="CALC" Command="{Binding CalculateSlopeCommand}" Padding="5,0" Margin="5,2"/>
                        </Grid>

                        <Button Grid.Row="6" Grid.ColumnSpan="2" Content="ADD PIPE" Command="{Binding AddPipeCommand}" 
                                Margin="0,5" Padding="10,2" Background="{StaticResource BrHeader}" Foreground="White" BorderThickness="1" BorderBrush="{StaticResource BrBorder}"/>

                        <DataGrid Grid.Row="7" Grid.ColumnSpan="2" ItemsSource="{Binding PipeRuns}" AutoGenerateColumns="False" Margin="0,5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="From" Binding="{Binding FromPointId}" Width="40"/>
                                <DataGridTextColumn Header="To" Binding="{Binding ToPointId}" Width="40"/>
                                <DataGridTextColumn Header="D" Binding="{Binding Diameter}" Width="30"/>
                                <DataGridTextColumn Header="Slope %" Binding="{Binding SlopePercent, StringFormat={}{0:F1}%}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- DIVIDER -->
                        <Rectangle Grid.Row="8" Grid.ColumnSpan="2" Height="1" Fill="#3E3E42" Margin="0,10"/>

                        <!-- PARTS -->
                        <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="Part" FontWeight="Bold" Margin="0,0,0,5" Foreground="Magenta"/>
                        
                        <TextBlock Grid.Row="10" Text="Pt ID:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding StructPointId, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>

                        <TextBlock Grid.Row="11" Text="Type:" VerticalAlignment="Center" Margin="0,2"/>
                        <Grid Grid.Row="11" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" 
                                      ItemsSource="{Binding AvailableFeatureTypes}" 
                                      SelectedValue="{Binding StructType}"
                                      IsEditable="True"
                                      IsReadOnly="False"
                                      Text="{Binding StructType}"
                                      Margin="5,2" ToolTip="Select or Type Code"/>
                        </Grid>

                        <Button Grid.Row="12" Grid.ColumnSpan="2" Content="ADD PART" Command="{Binding AddStructureCommand}" 
                                Margin="0,5" Padding="10,2" Background="{StaticResource BrHeader}" Foreground="White" BorderThickness="1" BorderBrush="{StaticResource BrBorder}"/>

                        <DataGrid Grid.Row="13" Grid.ColumnSpan="2" ItemsSource="{Binding Structures}" AutoGenerateColumns="False" Margin="0,5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding PointId}" Width="50"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <Grid Grid.Row="14" Grid.ColumnSpan="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- VALIDATE -->
                            <Button Grid.Column="0" Content="VALIDATE NETWORK" Command="{Binding ValidateNetworkCommand}"
                                    Padding="10,5" Background="{StaticResource BrHeader}" Foreground="White" BorderBrush="White" BorderThickness="1" FontWeight="Bold"/>

                            <!-- SYNC -->
                            <Button Grid.Column="2" Content="SYNC TO ASSETS" Command="{Binding SyncToAssetsCommand}"
                                    Padding="10,5" Background="{StaticResource BrHeader}" Foreground="White" BorderBrush="White" BorderThickness="1" FontWeight="Bold"
                                    ToolTip="Manually sync processed piping/structure data to Installed Assets DB."/>
                        </Grid>

                        <!-- SAVE / LOAD -->
                        <Grid Grid.Row="16" Grid.ColumnSpan="2" Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="SAVE NETWORK" Command="{Binding SavePipingCommand}" Margin="0,0,5,0" Padding="5,5" Background="{StaticResource BrHeader}" Foreground="White"/>
                            <Button Grid.Column="1" Content="LOAD NETWORK" Command="{Binding LoadPipingCommand}" Margin="5,0,0,0" Padding="5,5" Background="{StaticResource BrHeader}" Foreground="White"/>
                        </Grid>

                    </Grid>
                </TabItem>
                
                <!-- Tab: Piping Script -->
                <TabItem Header="Piping Script">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <DockPanel Grid.Row="0" Margin="0,0,0,5" LastChildFill="False">
                            <TextBlock Text="Enter Piping Script:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                            <Button Content="Import..." Command="{Binding ImportPipingScriptCommand}" Padding="5,2" Margin="0,0,5,0" Background="{StaticResource BrHeader}" Foreground="White" DockPanel.Dock="Left"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DockPanel.Dock="Left" Margin="20,0,0,0">
                                <ToggleButton x:Name="btnToggleLineNumbers" Content="#" Click="btnToggleLineNumbers_Click" Width="30" Margin="0,0,5,0" Padding="4,0" Background="{StaticResource BrCard}" Foreground="White" FontWeight="Bold" ToolTip="Toggle Line Numbers"/>
                                <Button Content="C" Click="btnCommentPipingScript_Click" Width="30" Margin="0,0,5,0" Padding="4,0" Background="{StaticResource BrCard}" Foreground="White" FontWeight="Bold" ToolTip="Comment Selected Lines"/>
                                <Button Content="U" Click="btnUncommentPipingScript_Click" Width="30" Margin="0,0,5,0" Padding="4,0" Background="{StaticResource BrCard}" Foreground="White" FontWeight="Bold" ToolTip="Uncomment Selected Lines"/>
                                <Button Content="MIX" Click="btnMixPipingScript_Click" Width="38" Margin="0,0,10,0" Padding="4,0" Background="{StaticResource BrCard}" Foreground="White" FontWeight="Bold" ToolTip="Insert Mixed Engine Directives"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <ToggleButton Content="P" IsChecked="{Binding ShowPointNumbers}" Width="30" Margin="0,0,5,0" Background="{StaticResource BrCard}" Foreground="White" FontWeight="Bold" ToolTip="Toggle Point Numbers"/>
                                <ToggleButton Content="X" IsChecked="{Binding ShowPointMarkers}" Width="30" Margin="0,0,5,0" Background="{StaticResource BrCard}" Foreground="White" FontWeight="Bold" ToolTip="Toggle Point Markers"/>
                                <ToggleButton Content="L" IsChecked="{Binding ShowFigureLabels}" Width="30" Margin="0,0,10,0" Background="{StaticResource BrCard}" Foreground="White" FontWeight="Bold" ToolTip="Toggle Figure Labels"/>
                                <Button Content="DXF" Command="{Binding ExportDxfCommand}" Padding="10,5" Margin="0,0,5,0" Background="{StaticResource BrHeader}" Foreground="White"/>
                                <Button Content="TXT" Command="{Binding ExportPipingScriptCommand}" Padding="10,5" Background="{StaticResource BrHeader}" Foreground="White"/>
                                <Button Content="✨ AI" Command="{Binding AnalyzePipingScriptCommand}" Padding="10,5" Margin="5,0,0,0" Background="{StaticResource BrAccentDim}" Foreground="White" FontWeight="Bold" ToolTip="AI Script Validator"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- Floating Piping Script Hint -->
                        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                                Background="{StaticResource BrSurface}" Margin="5,0,0,5" Padding="8,5" CornerRadius="3" MinWidth="100" Panel.ZIndex="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PipingScriptHint}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PipingScriptHint}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding PipingScriptHint}" Foreground="White" FontFamily="Consolas" FontSize="14"/>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtPipingLineNumbers" IsReadOnly="True" Background="{StaticResource BrHeader}" Foreground="{StaticResource BrTextMuted}" 
                                     BorderThickness="0" TextAlignment="Right" Padding="5,5,5,5" 
                                     FontFamily="Consolas" VerticalScrollBarVisibility="Hidden"
                                     Visibility="Collapsed" MinWidth="30" Margin="0,0,2,0" />
                            <TextBox x:Name="txtPipingScript" Grid.Column="1" Text="{Binding PipingScriptText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="14"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Padding="8,6" Panel.ZIndex="1"
                                     Background="{StaticResource BrBg}"
                                     Foreground="{StaticResource BrTextPrimary}"
                                     BorderThickness="1" BorderBrush="{StaticResource BrBorder}"
                                     TextChanged="txtPipingScript_TextChanged"
                                     ScrollViewer.ScrollChanged="txtPipingScript_ScrollChanged"/>
                        </Grid>
                        
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Process Script" Command="{Binding ProcessPipingScriptCommand}" 
                                    Padding="10,5" Background="{StaticResource BrHeader}" Foreground="White" BorderBrush="White" BorderThickness="1" FontWeight="Bold"/>
                            <Button Grid.Column="2" Content="✨ AI Chat" Command="{Binding OpenAiChatCommand}" 
                                    Padding="20,5" Background="{StaticResource BrAccentDim}" Foreground="White" BorderBrush="White" BorderThickness="1" FontWeight="Bold" ToolTip="Start AI Chat Assistant"/>
                            <Button Grid.Column="4" Content="Sync To Assets" Command="{Binding SyncToAssetsCommand}" 
                                    Padding="10,5" Background="{StaticResource BrHeader}" Foreground="White" BorderBrush="White" BorderThickness="1" FontWeight="Bold"/>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,5,0,0">
                            <TextBlock Text="Use // for comments" Foreground="Gray" FontStyle="Italic"/>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRunningScript, Converter={StaticResource BoolToVis}}">
                                <ProgressBar IsIndeterminate="True" Width="200" Height="10" Margin="0,0,10,0" Foreground="{StaticResource BrSuccess}"/>
                                <TextBlock Text="Processing Piping Script..." Foreground="{StaticResource BrSuccess}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Tab 5: Codes -->
                <TabItem Header="Codes">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Toolbar -->
                            <RowDefinition Height="*"/>    <!-- DataGrid -->
                        </Grid.RowDefinitions>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="Import CSV" Command="{Binding ImportCodesCommand}" Padding="10,5" Margin="0,0,10,0" Background="{StaticResource BrHeader}" Foreground="White" BorderThickness="1" BorderBrush="White"/>
                                <Button Content="Export CSV" Command="{Binding ExportCodesCommand}" Padding="10,5" Margin="0,0,10,0" Background="{StaticResource BrHeader}" Foreground="White" BorderThickness="1" BorderBrush="White"/>
                                <Button Content="Clear DB" Command="{Binding ClearCodesCommand}" Padding="10,5" Margin="0,0,10,0" Background="{StaticResource BrHeader}" Foreground="White" FontWeight="Bold" ToolTip="Deletes ALL codes from the Master Database" BorderThickness="1" BorderBrush="White"/>
                                <Button Content="Symbol Manager..." Command="{Binding OpenSymbolManagerCommand}" Padding="10,5" Margin="0,0,10,0" Background="{StaticResource BrAccentDim}" Foreground="White" FontWeight="Bold" BorderThickness="0" ToolTip="Open the graphical Symbol Manager"/>
                                <Button Content="⚡ Auto-Match Blocks" Command="{Binding AutoMatchBlocksCommand}" Padding="10,5" Margin="0,0,10,0"
                                        Background="{StaticResource BrAccentGlow}" Foreground="{StaticResource BrSuccess}" FontWeight="Bold" BorderThickness="1" BorderBrush="{StaticResource BrSuccess}"
                                        ToolTip="Automatically matches each unassigned code to the best-fit block in the RCS_Blocks library (exact → prefix → keyword)."/>
                                <Button Content="S" Command="{Binding SaveCodesCommand}" Padding="10,5" Background="{StaticResource BrSuccess}" Foreground="White" FontWeight="Bold" ToolTip="Save Grid to Database"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox Text="{Binding CodeSearchText, UpdateSourceTrigger=PropertyChanged}" Width="108" Height="25" VerticalAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Left" Background="{StaticResource BrBg}" Foreground="White" BorderThickness="1" BorderBrush="Gray" Padding="2,0,0,0" ToolTip="Search Codes (wildcard * accepted)"/>
                                <Button Content="..." Command="{Binding SearchCodesCommand}" Width="25" Height="25" VerticalAlignment="Center" Background="{StaticResource BrHeader}" Foreground="White" BorderThickness="1" BorderBrush="White" ToolTip="Search Codes"/>
                            </StackPanel>
                        </Grid>
                        
                        <DataGrid Grid.Row="1" ItemsSource="{Binding CogoCodes}" SelectedItem="{Binding SelectedCogoCode}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,5">
                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCogoCodeCommand}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Symbol" Width="60" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding SymbolImagePath}" Width="20" Height="20" Margin="0" Stretch="Uniform"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Local Code" Binding="{Binding LocalCode}" Width="*"/>
                                <DataGridTextColumn Header="System Code" Binding="{Binding SystemCode}" Width="*" IsReadOnly="True" Foreground="{StaticResource BrTextSecondary}"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" IsReadOnly="True" Foreground="{StaticResource BrTextSecondary}"/>
                                <DataGridTextColumn Header="Block (DWG)" Binding="{Binding Block}" Width="1.5*"/>
                                <DataGridTextColumn Header="Scale" Binding="{Binding BlockScale, StringFormat='{}{0:G}'}" Width="60" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                
                <!-- Tab 6: Materials -->
                <TabItem Header="Materials">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Master Catalog Header -->
                            <RowDefinition Height="Auto"/> <!-- Filters -->
                            <RowDefinition Height="260"/>  <!-- Master Catalog Grid -->
                            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                            <RowDefinition Height="Auto"/> <!-- Project List Header -->
                            <RowDefinition Height="*"/>    <!-- Project List Grid -->
                            <RowDefinition Height="Auto"/> <!-- Footer -->
                        </Grid.RowDefinitions>
                        
                        <DockPanel Grid.Row="0" Margin="0,0,0,5">
                            <TextBlock Text="Master Catalog (Validation List)" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="Import CSV..." Command="{Binding ImportCatalogCommand}" HorizontalAlignment="Right" Padding="10,2" Background="{StaticResource BrHeader}" Foreground="White" BorderThickness="1" BorderBrush="{StaticResource BrBorder}" DockPanel.Dock="Right"/>
                        </DockPanel>
                        
                        <!-- Filters -->
                        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,5">
                                <TextBlock Text="Disc:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox ItemsSource="{Binding AvailableDisciplines}" SelectedItem="{Binding FilterDiscipline}" Width="60"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,5">
                                <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox ItemsSource="{Binding AvailableFeatureTypes}" SelectedItem="{Binding FilterFeatureType}" Width="80"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,5">
                                <TextBlock Text="Size:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox ItemsSource="{Binding AvailableSizes}" SelectedItem="{Binding FilterSize}" Width="60"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,5">
                                <TextBlock Text="Mat:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox ItemsSource="{Binding AvailableMaterials}" SelectedItem="{Binding FilterMaterial}" Width="60"/>
                            </StackPanel>
                            <Button Content="Reset Filters" Command="{Binding ClearCurveSolverCommand}"
                                    Padding="8,2" Margin="4,0"/>
                        </WrapPanel>
                        
                        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredCatalog}" SelectedItem="{Binding SelectedCatalogItem}" AutoGenerateColumns="False" Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PartKey" Binding="{Binding PartKey}" Width="80"/>
                                <DataGridTextColumn Header="Disc" Binding="{Binding Discipline}" Width="40"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding FeatureType}" Width="60"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="50"/>
                                <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="60"/>
                                <DataGridTextColumn Header="Manuf" Binding="{Binding Manufacturer}" Width="*"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="80"/>
                                <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="50"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                            <Button Content="Add Selected to Project" Command="{Binding AddMaterialToProjectCommand}" Padding="20,5" Background="{StaticResource BrAccentDim}" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Row="4" Text="Project Schedule of Materials" FontWeight="Bold" Margin="0,10,0,5"/>
                        
                        <DataGrid Grid.Row="5" ItemsSource="{Binding ProjectMaterials}" AutoGenerateColumns="False" Margin="0,0,0,5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PartKey" Binding="{Binding PartKey}" Width="80"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="50"/>
                                <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="60"/>
                                <DataGridTextColumn Header="Manuf" Binding="{Binding Manufacturer}" Width="*"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="80"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="40"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <Button Grid.Row="6" Content="Export Project Schedule (CSV)" Command="{Binding ExportMaterialsCommand}" HorizontalAlignment="Right" Padding="10,5" Background="{StaticResource BrHeader}" Foreground="White" BorderThickness="1" BorderBrush="{StaticResource BrBorder}"/>
                    </Grid>
                </TabItem>
                <!-- Tab 8: Coordinate Transform -->
                <TabItem Header="GPS Proj">
                    <Grid Margin="10">
                        <geo:CoordinateTransformControl DataContext="{Binding CoordinateTransformVm}" />
                    </Grid>
                </TabItem>

                <!-- ══ Tab 9: As-Built Production Workspace ══════════════════════════
                     When active, the workspace view is injected as a ContentControl
                     that covers the full Row-1 area (all three columns) so it can
                     render its own four-pane layout without being squeezed into the
                     594-px left-column.
                 ═══════════════════════════════════════════════════════════════════ -->
                <TabItem Header="🏗 As-Built">
                    <!-- Placeholder shown inside the tab strip; the real workspace
                         is overlaid on the entire Row-1 content area and toggled by
                         AsBuiltTabOverlay visibility — see ShellWindow.xaml.cs.     -->
                    <Grid Height="60">
                        <TextBlock Text="As-Built workspace is overlaying the main window…"
                                   Foreground="{StaticResource BrTextMuted}" FontFamily="Segoe UI" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- Grid Splitter -->
        <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BrBorder}"/>

        <!-- Center Pane: Graphics -->
        <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource BrBg}" Margin="5,10" CornerRadius="5" ClipToBounds="True">
            <Grid x:Name="ViewportGrid"
                  Background="Transparent"
                  MouseWheel="OnMouseWheel" 
                  MouseRightButtonDown="OnMouseRightButtonDown" 
                  MouseRightButtonUp="OnMouseRightButtonUp"
                  PreviewMouseLeftButtonDown="ViewportGrid_PreviewMouseDown"
                  PreviewMouseMove="ViewportGrid_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="ViewportGrid_PreviewMouseUp">
                <!-- Canvas -->
                <Canvas x:Name="ViewportCanvas">
                    <Canvas.RenderTransform>
                        <MatrixTransform x:Name="WorldTransform"/>
                    </Canvas.RenderTransform>
                
                <!-- Grid/Axis? -->
                
                <!-- Figures -->
                <ItemsControl ItemsSource="{Binding Figures}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <!-- Base pipe polyline — stroke thickness scales with zoom -->
                                <Polyline Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeLineJoin="Round"
                                          StrokeThickness="{Binding DataContext.LineMarkerScale, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <!-- Highlight overlay — cyan glow when run is selected in AsBuilt grid (thickness via HighlightThickness) -->
                                <Polyline Points="{Binding Points}" StrokeLineJoin="Round"
                                          Stroke="#00FFFF" Opacity="0.65" IsHitTestVisible="False"
                                          StrokeThickness="{Binding HighlightThickness}"
                                          Visibility="{Binding IsHighlighted, Converter={StaticResource BoolToVis}}"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Figure Labels -->
                <ItemsControl ItemsSource="{Binding Figures}" Visibility="{Binding DataContext.ShowFigureLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Labels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Easting}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Northing}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas ClipToBounds="False">
                                            <Canvas.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding DataContext.PointMarkerScale, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                ScaleY="{Binding DataContext.PointMarkerScale, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </Canvas.RenderTransform>
                                            
                                            <!-- Center the text block roughly by shifting it left/up by half its approx size -->
                                            <Border Background="#AA0F0F17" CornerRadius="2" Padding="2" Canvas.Left="-30" Canvas.Top="5">
                                                <Border.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleY="-1"/>
                                                        <RotateTransform Angle="{Binding RotationDegrees}"/>
                                                    </TransformGroup>
                                                </Border.RenderTransform>
                                                <TextBlock Text="{Binding Text}" Foreground="{StaticResource BrAmber}" FontSize="12" TextAlignment="Center" FontWeight="SemiBold"/>
                                            </Border>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                <!-- Points -->

                <ItemsControl ItemsSource="{Binding Points}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Easting}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Northing}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Survey Coordinates: N=Y, E=X. 
                                 We bind Canvas.Left/Top in ItemContainerStyle.
                                 Grid serves as the anchor point. We translate it -0.5,-0.5 to center it on the coordinate.
                             -->
                            <!-- Point Graphic + Number (No clipping bounds) -->
                            <Canvas ClipToBounds="False">
                                 <!-- Dynamic global scale for Points -->
                                 <Canvas.RenderTransform>
                                     <ScaleTransform ScaleX="{Binding DataContext.PointMarkerScale, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     ScaleY="{Binding DataContext.PointMarkerScale, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                 </Canvas.RenderTransform>

                                 <!-- ── Selection highlight ring — shown when IsSelected = True ── -->
                                 <Ellipse Width="28" Height="28"
                                          Canvas.Left="-14" Canvas.Top="-14"
                                          Stroke="#FFD700" StrokeThickness="2.5"
                                          Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                          IsHitTestVisible="False">
                                     <Ellipse.Effect>
                                         <BlurEffect Radius="5"/>
                                     </Ellipse.Effect>
                                 </Ellipse>
                                 <Ellipse Width="20" Height="20"
                                          Canvas.Left="-10" Canvas.Top="-10"
                                          Fill="#FFD700" Opacity="0.35"
                                          Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                          IsHitTestVisible="False"/>

                                 <!-- The Green X -->
                                 <Line X1="-5" Y1="-5" X2="5" Y2="5" Stroke="#00FF00" StrokeThickness="1.5"
                                       Visibility="{Binding DataContext.ShowPointMarkers, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                 <Line X1="5" Y1="-5" X2="-5" Y2="5" Stroke="#00FF00" StrokeThickness="1.5"
                                       Visibility="{Binding DataContext.ShowPointMarkers, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                                 <!-- The Point Number Label — turns gold when selected -->
                                 <TextBlock Text="{Binding Id}"
                                            FontSize="{Binding DataContext.PointNumberSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                            FontWeight="Bold"
                                            Visibility="{Binding DataContext.ShowPointNumbers, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                            Canvas.Left="8" Canvas.Top="22">
                                      <TextBlock.RenderTransform>
                                          <ScaleTransform ScaleY="-1"/>
                                      </TextBlock.RenderTransform>
                                      <TextBlock.Style>
                                          <Style TargetType="TextBlock">
                                              <Setter Property="Foreground" Value="#00FF00"/>
                                              <Style.Triggers>
                                                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                      <Setter Property="Foreground" Value="#FFD700"/>
                                                      <Setter Property="FontSize"   Value="16"/>
                                                  </DataTrigger>
                                              </Style.Triggers>
                                          </Style>
                                      </TextBlock.Style>
                                 </TextBlock>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Structures (inside WorldTransform so they align with pipes/figures) -->
                <ItemsControl ItemsSource="{Binding StructureGraphics}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Easting}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Northing}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="28" Height="28"
                                  MouseLeftButtonDown="StructureSymbol_Click"
                                  Cursor="Hand"
                                  Tag="{Binding}">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="-14" Y="-14"/>
                                </Grid.RenderTransform>
                                <!-- Selection highlight ring -->
                                <Ellipse Width="34" Height="34" Canvas.Left="-17" Canvas.Top="-17"
                                         Stroke="#FFD700" StrokeThickness="2"
                                         Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                         IsHitTestVisible="False" Opacity="0.85">
                                    <Ellipse.Effect><BlurEffect Radius="4"/></Ellipse.Effect>
                                </Ellipse>
                                <ContentControl Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="ContentTemplate" Value="{StaticResource Symbol_Default}"/>
                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                     <ScaleTransform ScaleX="{Binding DataContext.MarkerScale, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     ScaleY="{Binding DataContext.MarkerScale, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SymbolType}" Value="Manhole">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource Symbol_Manhole}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SymbolType}" Value="Valve">
                                                     <Setter Property="ContentTemplate" Value="{StaticResource Symbol_WaterValve}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SymbolType}" Value="Hydrant">
                                                     <Setter Property="ContentTemplate" Value="{StaticResource Symbol_Hydrant}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SymbolType}" Value="Meter">
                                                     <Setter Property="ContentTemplate" Value="{StaticResource Symbol_Meter}"/>
                                                </DataTrigger>
                                                 <DataTrigger Binding="{Binding SymbolType}" Value="Fitting">
                                                     <Setter Property="ContentTemplate" Value="{StaticResource Symbol_Fitting}"/>
                                                </DataTrigger>
                                                 <DataTrigger Binding="{Binding SymbolType}" Value="Inlet">
                                                     <Setter Property="ContentTemplate" Value="{StaticResource Symbol_Manhole}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SymbolType}" Value="Pole">
                                                     <Setter Property="ContentTemplate" Value="{StaticResource Symbol_ElectricPole}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SymbolType}" Value="Box">
                                                     <Setter Property="ContentTemplate" Value="{StaticResource Symbol_ElectricBox}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                                <!-- Asset ID Label below symbol -->
                                <TextBlock Text="{Binding Label}"
                                           Visibility="{Binding DataContext.ShowAssetLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                           FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrAmber}"
                                           Background="#880F0F17"
                                           Padding="1,0"
                                           Canvas.Left="16" Canvas.Top="14"
                                           IsHitTestVisible="False">
                                    <TextBlock.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleY="-1"
                                                ScaleX="{Binding DataContext.MarkerScale, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <TranslateTransform X="14" Y="-14"/>
                                        </TransformGroup>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Highlight/Crossing Markers (inside WorldTransform so they align with pipes) -->
                <ItemsControl ItemsSource="{Binding HighlightedAssets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Easting}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Northing}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="3" Height="3" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="-1.5" Y="-1.5"/>
                                </Grid.RenderTransform>
                                <Ellipse Stroke="#FFFF00" StrokeThickness="0.3" Width="3" Height="3">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:1" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Fill="#FFFF00" Opacity="0.3" Width="3" Height="3"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                </Canvas>
                <!-- Zoom Window rubber-band rectangle (screen-space, outside the world-transform Canvas) -->
                <Rectangle x:Name="ZoomRect"
                           Stroke="#00CFFF" StrokeThickness="1.5"
                           StrokeDashArray="4 2"
                           Fill="#1800CFFF"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Width="0" Height="0"
                           Visibility="Collapsed"
                           IsHitTestVisible="False"/>

                <!-- ── Asset Inspector Popup ─────────────────────────────────────
                     Appears bottom-right when user clicks a symbol on the canvas. -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,12,12" Width="280" MaxHeight="450"
                        Background="{StaticResource BrBg}" BorderBrush="{StaticResource BrAccent}" BorderThickness="1.5"
                        CornerRadius="6" Padding="12" Panel.ZIndex="50"
                        Visibility="{Binding InspectorVisible, Converter={StaticResource BoolToVis}}">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="14" Opacity="0.7" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Header row -->
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="✕" Width="22" Height="22"
                                    Command="{Binding ClearInspectorCommand}"
                                    Background="Transparent" Foreground="{StaticResource BrTextMuted}"
                                    BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                            <TextBlock Text="{Binding SelectedStructure.Label}"
                                       Foreground="{StaticResource BrInfo}" FontWeight="Bold" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedStructure.Type}"
                                   Foreground="{StaticResource BrTextMuted}" FontSize="10" Margin="0,0,0,6"/>
                        <Rectangle Height="1" Fill="#334472C4" Margin="0,0,0,8"/>
                        <!-- Attribute key/value list -->
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedStructure.AssetData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}"
                                                       Foreground="{StaticResource BrTextMuted}" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     Foreground="{StaticResource BrTextPrimary}" Background="Transparent" BorderBrush="{StaticResource BrBorderLight}" 
                                                     BorderThickness="1" Padding="2" FontSize="10" FontWeight="SemiBold" 
                                                     TextWrapping="Wrap" IsReadOnly="{Binding IsReadOnly}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <!-- Footer export button -->
                        <Rectangle Height="1" Fill="#334472C4" Margin="0,10,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="💾 Save DB"
                                    Command="{Binding SaveInspectorCommand}"
                                    Padding="5" Background="{StaticResource BrAccentGlow}" Foreground="{StaticResource BrInfo}"
                                    BorderBrush="{StaticResource BrAccent}" BorderThickness="1" FontWeight="Bold"/>

                            <Button Grid.Column="2" Content="⬇ DXF"
                                    Command="{Binding ExportDxfCommand}"
                                    Padding="5" Background="{StaticResource BrAccentGlow}" Foreground="{StaticResource BrInfo}"
                                    BorderBrush="{StaticResource BrAccent}" BorderThickness="1" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>


                <!-- Zoom State Text Overlay -->
                <TextBlock Text="{Binding CurrentViewScale, StringFormat='Zoom Scale: {0:F4}x'}" 
                           Foreground="{StaticResource BrTextMuted}" FontSize="12" Margin="10"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                
                <!-- Zoom Toolbar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                    <StackPanel.Resources>
                        <!-- Locally override Button style so these viewport buttons
                             are fully self-contained and never hidden by theme issues -->
                        <Style TargetType="Button">
                            <Setter Property="Height"          Value="32"/>
                            <Setter Property="FontFamily"      Value="Segoe UI"/>
                            <Setter Property="FontWeight"      Value="Bold"/>
                            <Setter Property="Cursor"          Value="Hand"/>
                            <Setter Property="Foreground"      Value="White"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="White"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       FontFamily="{TemplateBinding FontFamily}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.35"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Height"          Value="32"/>
                            <Setter Property="FontFamily"      Value="Segoe UI"/>
                            <Setter Property="FontWeight"      Value="Bold"/>
                            <Setter Property="Cursor"          Value="Hand"/>
                            <Setter Property="Foreground"      Value="White"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="White"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="White"/>
                                                <Setter TargetName="bd" Property="Opacity"     Value="1.0"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <ToggleButton IsChecked="{Binding ShowAssetLabels}"
                                  Content="LABELS" Width="52" Margin="0,0,4,0"
                                  Background="#1E3A5A" BorderBrush="#4F9EF8" FontSize="10"
                                  ToolTip="Toggle Asset Labels"/>
                    <Button Command="{Binding FindCrossingsCommand}"
                            Content="CROSS" Width="44" Margin="0,0,4,0"
                            Background="#2A1A4A" BorderBrush="#9B59B6" FontSize="10"
                            ToolTip="Find Overlapping Crossings"/>
                    <ToggleButton IsChecked="{Binding IsPanModeActive}"
                                  Content="&#x270B;" Width="38" Margin="0,0,4,0"
                                  Background="#1A3A1A" BorderBrush="#27AE60" FontSize="16"
                                  ToolTip="Pan / Hand Tool — left-click drag to pan"/>
                    <Button Command="{Binding ZoomWindowCommand}"
                            Content="&#x2B1A;" Width="38" Margin="0,0,4,0"
                            Background="#1A3A1A" BorderBrush="#27AE60" FontSize="16"
                            ToolTip="Zoom Window — drag a rectangle to zoom"/>
                    <Button Command="{Binding ZoomInCommand}"
                            Content="  +  " Width="36" Margin="0,0,4,0"
                            Background="#1A3A1A" BorderBrush="#27AE60" FontSize="16"
                            ToolTip="Zoom In"/>
                    <Button Command="{Binding ZoomOutCommand}"
                            Content="  −  " Width="36" Margin="0,0,4,0"
                            Background="#1A3A1A" BorderBrush="#27AE60" FontSize="16"
                            ToolTip="Zoom Out"/>
                    <Button Command="{Binding ZoomExtentsCommand}"
                            Content="&#x26F6;" Width="38"
                            Background="#1A3A1A" BorderBrush="#27AE60" FontSize="16"
                            ToolTip="Zoom Extents — fit all geometry"/>
                </StackPanel>

                <!-- Symbol Legend -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,10,10,10" Background="{StaticResource BrSurface}" BorderBrush="{StaticResource BrBorder}" BorderThickness="1" CornerRadius="4" Padding="10" Visibility="{Binding ShowViewportLegend, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Symbol Legend" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" TextAlignment="Center"/>
                        
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl ContentTemplate="{StaticResource Symbol_Manhole}" Width="28" Height="28">
                                <ContentControl.RenderTransform>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" CenterX="14" CenterY="14"/>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                            <TextBlock Grid.Column="1" Text="Manhole" Foreground="{StaticResource BrTextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl ContentTemplate="{StaticResource Symbol_WaterValve}" Width="28" Height="28">
                                <ContentControl.RenderTransform>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" CenterX="14" CenterY="14"/>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                            <TextBlock Grid.Column="1" Text="Water Valve" Foreground="{StaticResource BrTextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl ContentTemplate="{StaticResource Symbol_Hydrant}" Width="28" Height="28">
                                <ContentControl.RenderTransform>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" CenterX="14" CenterY="14"/>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                            <TextBlock Grid.Column="1" Text="Fire Hydrant" Foreground="{StaticResource BrTextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl ContentTemplate="{StaticResource Symbol_Inlet}" Width="28" Height="28">
                                <ContentControl.RenderTransform>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" CenterX="14" CenterY="14"/>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                            <TextBlock Grid.Column="1" Text="Catch Basin / Inlet" Foreground="{StaticResource BrTextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl ContentTemplate="{StaticResource Symbol_Meter}" Width="28" Height="28">
                                <ContentControl.RenderTransform>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" CenterX="14" CenterY="14"/>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                            <TextBlock Grid.Column="1" Text="Vault / Meter" Foreground="{StaticResource BrTextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl ContentTemplate="{StaticResource Symbol_Fitting}" Width="28" Height="28">
                                <ContentControl.RenderTransform>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" CenterX="14" CenterY="14"/>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                            <TextBlock Grid.Column="1" Text="Fitting" Foreground="{StaticResource BrTextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right Pane: Point Grid -->
        <!-- Right Pane: Point Grid (Collapsable) -->
        <!-- Right Pane: Installed Assets (Collapsible) -->
        <!-- Right Side Splitter -->
        <GridSplitter Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource BrBorder}"/>

        <!-- Right Pane: Installed Assets (Collapsible) -->
        <Expander Grid.Column="4" Grid.Row="0" Grid.RowSpan="2" ExpandDirection="Left" IsExpanded="True" 
                  Background="{StaticResource BrBg}" BorderThickness="0">
            <Expander.Header>
                <TextBlock Text="Installed Assets" FontWeight="Bold" Foreground="{StaticResource BrTextPrimary}" RenderTransformOrigin="0.5,0.5" Margin="0,10">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Expander.Header>

            <views:InstalledAssetsView DataContext="{Binding InstalledAssets}"/>
        </Expander>
        
        <!-- Bottom Pane: Output Window -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Computation Output" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Grid.Row="1" Text="{Binding ResultLogText}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     VerticalContentAlignment="Top"
                     FontFamily="Consolas"
                     FontSize="13"
                     Padding="8,6"
                     Background="{StaticResource BrSurface}"
                     Foreground="White"
                     BorderThickness="0"/>
        </Grid>
    </Grid>

    <!-- ══ As-Built Workspace Overlay ══════════════════════════════════════════
         Direct child of the outer 2-row window Grid (Grid.Row=1).
         Visibility toggled by ShellWindow.xaml.cs when the As-Built tab is
         selected; ZIndex=10 ensures it floats above the normal three-column
         layout without disrupting it.
     ═══════════════════════════════════════════════════════════════════════════ -->
    <Grid x:Name="AsBuiltTabOverlay"
          Grid.Row="1"
          Visibility="Collapsed"
          Panel.ZIndex="10"
          Background="{StaticResource BrBg}">
        <!-- AsBuiltWorkspaceView is injected here by ShellWindow code-behind
             on first activation (lazy):
               AsBuiltOverlayContent.Content = _asBuiltView;               -->
        <ContentPresenter x:Name="AsBuiltOverlayContent"/>
    </Grid>

    <!-- ══ Job Dashboard Overlay ════════════════════════════════════════════════
         Visible when ShowDashboard = true (no job open).
         ZIndex=11 floats above the main three-pane layout AND the as-built overlay.
         ShellWindow.xaml.cs toggles this based on ShellViewModel.ShowDashboard.
     ═══════════════════════════════════════════════════════════════════════════ -->
    <Grid x:Name="JobDashboardOverlay"
          Grid.Row="1"
          Panel.ZIndex="11"
          Visibility="{Binding ShowDashboard, Converter={StaticResource BoolToVis}}"
          Background="{StaticResource BrBg}">
        <views:JobDashboardView DataContext="{Binding Dashboard}"/>
    </Grid>

    <!-- ══ Workflow Navigator Sidebar ═══════════════════════════════════════════
         Always visible when a job is active (ShowWorkspace = true).
         Left-docked 172px sidebar overlaying the main content pane at ZIndex=9.
         ShellWindow.xaml.cs sets Visibility when the AsBuilt tab is activated.
     ═══════════════════════════════════════════════════════════════════════════ -->
    <Grid x:Name="WorkflowNavigatorSidebar"
          Grid.Row="1"
          Panel.ZIndex="9"
          HorizontalAlignment="Left"
          Width="172"
          Visibility="Collapsed">
        <views:WorkflowNavigator DataContext="{Binding Navigator}"/>
    </Grid>

    <!-- ══ Diagnostics Pane ══════════════════════════════════════════════════════
         Bottom-docked 170px pane, visible when a job is active.
         ZIndex=8 renders below the navigator but above the tabbed main content.
         DataContext inherits the ShellViewModel.Diagnostics sub-VM.
     ═══════════════════════════════════════════════════════════════════════════ -->
    <Grid x:Name="DiagnosticsPaneOverlay"
          Grid.Row="1"
          Panel.ZIndex="8"
          VerticalAlignment="Bottom"
          Height="170"
          Visibility="Collapsed">
        <views:DiagnosticsPane DataContext="{Binding Diagnostics}"/>
    </Grid>

</Grid>
</Window>

