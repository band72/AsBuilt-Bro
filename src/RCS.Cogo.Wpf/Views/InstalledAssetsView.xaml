                             <DataGridTextColumn Header="Pipe Material" Binding="{Binding Material}" />
                             <DataGridTextColumn Header="Pipe Lining Manufacturer" Binding="{Binding LiningManufacturer}" />
                             <DataGridTextColumn Header="Pipe Lining Material" Binding="{Binding LiningMaterial}" />
                             <DataGridTextColumn Header="Finished Grade Elevation (Feet)" Binding="{Binding GradeElevation}" />
                             <DataGridTextColumn Header="Pipe Top Elevation (Feet)" Binding="{Binding TopElevation}" />
                             <DataGridTextColumn Header="Pipe Cover (Feet)" Binding="{Binding Cover}" />
                             <DataGridTextColumn Header="X Coord (State Plane Easting Feet)" Binding="{Binding Easting}" />
                             <DataGridTextColumn Header="Y Coord (State Plane Northing Feet)" Binding="{Binding Northing}" />
                             <DataGridTextColumn Header="Latitude (Decimal Degrees)" Binding="{Binding Latitude}" />
