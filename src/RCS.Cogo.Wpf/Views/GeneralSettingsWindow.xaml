<Window x:Class="RCS.Cogo.Wpf.Views.GeneralSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="General Settings" Height="680" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" MinWidth="380" MinHeight="500">

    <Grid Background="{StaticResource BrBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>   <!-- Header band -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ── Header band ──────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBand}">
            <TextBlock Text="⚙️  General Settings"
                       VerticalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextPrimary}"/>
        </Border>

        <!-- ── Content ──────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16">

                <!-- Symbol Scale -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="VIEWPORT SYMBOL SCALE"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailableSymbolScales}"
                              SelectedItem="{Binding SymbolScaleMultiplier}"/>
                    <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BrTextSecondary}"/>
                </Grid>

                <!-- Options -->
                <TextBlock Style="{StaticResource TbSection}" Text="DISPLAY OPTIONS"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding ShowViewportLegend}"
                                  Content="Show Symbol Legend in Viewport"
                                  Margin="0,0,0,8"/>
                        <CheckBox IsChecked="{Binding IsOutputLogDescending}"
                                  Content="Output Log Descending (newest at top)"
                                  ToolTip="Tick to show newest logs at the top"/>
                    </StackPanel>
                </Border>

                <!-- JEA Settings -->
                <TextBlock Style="{StaticResource TbSection}" Text="JEA AS-BUILT SETTINGS"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="BLANK JEA TEMPLATE PATH"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding JeaTemplatePath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Path to the blank JEA As Built Template 2024.xlsx"/>
                            <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0"
                                    Style="{StaticResource BtnPrimary}"
                                    Width="72" Click="BrowseJeaTemplate_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="STATE PLANE ZONE"/>
                        <ComboBox ItemsSource="{Binding AvailableStatePlaneZones}"
                                  SelectedItem="{Binding JeaStatePlaneZone}"/>
                    </StackPanel>
                </Border>

                <!-- Script Auto-Save -->
                <TextBlock Style="{StaticResource TbSection}" Text="SCRIPT AUTO-SAVE PATH"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="DEFAULT FOLDER FOR .COGO SCRIPTS"/>
                        <TextBlock Foreground="{StaticResource BrTextMuted}" FontSize="10"
                                   Text="System creates a timestamped subfolder automatically."
                                   Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CogoScriptDefaultSavePath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Full path to the default script save folder."/>
                            <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0"
                                    Style="{StaticResource BtnPrimary}"
                                    Width="72" Click="BrowseCogoScriptPath_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- DXF Blocks Library -->
                <TextBlock Style="{StaticResource TbSection}" Text="DXF BLOCKS LIBRARY"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="RCS_BLOCKS DIRECTORY PATH"/>
                        <TextBlock Foreground="{StaticResource BrTextMuted}" FontSize="10"
                                   Text="Leave blank to auto-detect from application folder."
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding RcsBlocksPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Full path to the folder containing *.dwg block files."/>
                            <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0"
                                    Style="{StaticResource BtnPrimary}"
                                    Width="72" Click="BrowseBlocksPath_Click"/>
                        </Grid>
                        <TextBlock x:Name="BlocksPathStatus" FontSize="10"
                                   Foreground="{StaticResource BrTextMuted}"
                                   Text="Auto-detect: path will be resolved at runtime if left blank."/>
                    </StackPanel>
                </Border>

                <!-- Cogo Marker -->
                <TextBlock Style="{StaticResource TbSection}" Text="COGO MARKER &amp; VIEWPORT"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Point Marker Size" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrTextSecondary}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePointMarkerSizes}"
                                      SelectedItem="{Binding PointMarkerSize}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Point Number Size" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrTextSecondary}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePointNumberSizes}"
                                      SelectedItem="{Binding PointNumberSize}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Figure Line Width" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrTextSecondary}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFigureLineWidths}"
                                      SelectedItem="{Binding FigureLineWidth}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Closure Tolerance" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrTextSecondary}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableClosureTolerances}"
                                      SelectedItem="{Binding MapCheckClosureTolerance}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Min Boundary Area (sf)" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrTextSecondary}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding MinimumBoundaryArea, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer ───────────────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource WindowFooterBand}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource BtnGhost}"
                        Width="90" Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
