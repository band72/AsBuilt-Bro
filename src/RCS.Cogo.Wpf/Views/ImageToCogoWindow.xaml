<Window x:Class="RCS.Cogo.Wpf.Views.ImageToCogoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convert Image to COGO Script (AI)" Height="600" Width="800"
        Background="#1E1E1E" Foreground="#D4D4D4"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- API Settings -->
            <RowDefinition Height="Auto"/> <!-- Image Picker -->
            <RowDefinition Height="Auto"/> <!-- Action -->
            <RowDefinition Height="Auto"/> <!-- Loading -->
            <RowDefinition Height="*"/>    <!-- Result -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="AI Vision to COGO Translator" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="Cyan"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="API Key:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="ApiKeyBox" Grid.Column="1" Background="#252526" Foreground="White" BorderBrush="#3E3E42" Padding="5" ToolTip="OpenAI or compatible Vision API Key"/>
            
            <TextBlock Grid.Column="2" Text="Engine:" VerticalAlignment="Center" Margin="20,0,10,0"/>
            <ComboBox x:Name="EngineComboBox" Grid.Column="3" Background="#252526" Foreground="White" SelectedIndex="0" Padding="5">
                <ComboBoxItem Content="gemini-2.5-pro"/>
                <ComboBoxItem Content="gemini-1.5-pro"/>
                <ComboBoxItem Content="gpt-4o"/>
                <ComboBoxItem Content="gpt-4-vision-preview"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Survey Image:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="ImagePathBox" Grid.Column="1" IsReadOnly="True" Background="#252526" Foreground="White" BorderBrush="#3E3E42" Padding="5"/>
            <Button Grid.Column="2" Content="Browse..." Click="BrowseButton_Click" Padding="10,5" Margin="10,0,0,0" Background="#2D2D30" Foreground="White"/>
        </Grid>

        <Button Grid.Row="3" x:Name="AnalyzeButton" Content="ANALYZE IMAGE AND GENERATE SCRIPT" Click="AnalyzeButton_Click" 
                Padding="10,10" Background="#007ACC" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="4" x:Name="LoadingPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="True" Width="200" Height="10" Margin="0,0,10,0" Foreground="#28A745"/>
            <TextBlock x:Name="LoadingText" Text="AI is analyzing the survey drawing... This may take a minute." Foreground="#28A745" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Generated Output:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="ResultScriptBox" Grid.Row="1" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="White" BorderBrush="#3E3E42" Padding="5" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
