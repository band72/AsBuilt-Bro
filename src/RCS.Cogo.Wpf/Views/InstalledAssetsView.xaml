                             <DataGridTextColumn Header="Meter Box Number" Binding="{Binding PartKey}" />
                             <DataGridTextColumn Header="Proposed Meter Size" Binding="{Binding Size}" />
                             <DataGridTextColumn Header="Meter Box Subtype" Binding="{Binding Subtype}" />
                             <DataGridTextColumn Header="Facility Owner" Binding="{Binding FacilityOwner}" />
                             <DataGridTextColumn Header="Meter Box Orientation" Binding="{Binding Orientation}" />
                             <DataGridTextColumn Header="Meter Box Manufacturer/Supplier" Binding="{Binding Manufacturer}" />
                             <DataGridTextColumn Header="Meter Box Material" Binding="{Binding Material}" />
                             <DataGridTextColumn Header="X Coord (State Plane Easting Feet)" Binding="{Binding Easting}" />
                             <DataGridTextColumn Header="Y Coord (State Plane Northing Feet)" Binding="{Binding Northing}" />
                             <DataGridTextColumn Header="Latitude (Decimal Degrees)" Binding="{Binding Latitude}" />
                             <DataGridTextColumn Header="Longitude (Decimal Degrees)" Binding="{Binding Longitude}" />
                         </DataGrid.Columns>
                    </DataGrid>
                </Expander>
                 <Expander Header="Water Locate Box">
                    <DataGrid ItemsSource="{Binding WaterLocateBoxes}" RowEditEnding="DataGrid_RowEditEnding">
                         <DataGrid.Columns>
                             <DataGridTextColumn Header="Locate Box Number" Binding="{Binding PartKey}" />
                             <DataGridTextColumn Header="Locate Box Subtype" Binding="{Binding Subtype}" />
                             <DataGridTextColumn Header="X Coord (State Plane Easting Feet)" Binding="{Binding Easting}" />
                             <DataGridTextColumn Header="Y Coord (State Plane Northing Feet)" Binding="{Binding Northing}" />
                             <DataGridTextColumn Header="Latitude (Decimal Degrees)" Binding="{Binding Latitude}" />
                             <DataGridTextColumn Header="Longitude (Decimal Degrees)" Binding="{Binding Longitude}" />
                         </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <!-- WW Section -->
                <StackPanel Orientation="Horizontal" Margin="10,5">
                    <TextBlock Text="WW" Foreground="LimeGreen" FontWeight="Bold" Margin="0,0,5,0"/>
                    <TextBlock Text="Waste Water" FontWeight="Bold" Foreground="White" />
                </StackPanel>
                
                <Expander Header="WW Gravity Pipe Run">
                    <DataGrid ItemsSource="{Binding WWGravityPipes}" RowEditEnding="DataGrid_RowEditEnding">
                         <DataGrid.Columns>
                             <DataGridTextColumn Header="Sewer Pipe Run Number (GM#)" Binding="{Binding PartKey}" />
                             <DataGridTextColumn Header="Sewer Pipe Subtype" Binding="{Binding Subtype}" />
                             <DataGridTextColumn Header="Facility Owner" Binding="{Binding FacilityOwner}" />
                             <DataGridTextColumn Header="Pipe Size (Inches)" Binding="{Binding Size}" />
                             <DataGridTextColumn Header="Pipe Class" Binding="{Binding PipeClass}" />
                             <DataGridTextColumn Header="Pipe Manufacturer" Binding="{Binding Manufacturer}" />
                             <DataGridTextColumn Header="Pipe Material" Binding="{Binding Material}" />
                             <DataGridTextColumn Header="Pipe Lining Manufacturer" Binding="{Binding LiningManufacturer}" />
                             <DataGridTextColumn Header="Pipe Lining Material" Binding="{Binding LiningMaterial}" />
                             <DataGridTextColumn Header="Pipe Run Length (feet)" Binding="{Binding Length}" />
                             <DataGridTextColumn Header="Downstream Pipe Invert Elevation (feet)" Binding="{Binding DownstreamInvert}" />
                             <DataGridTextColumn Header="Downstream Grade Elevation at Invert (feet)" Binding="{Binding DownstreamGrade}" />
                             <DataGridTextColumn Header="Upstream Pipe Invert Elevation (feet)" Binding="{Binding UpstreamInvert}" />
                             <DataGridTextColumn Header="Upstream Grade Elevation at Invert (feet)" Binding="{Binding UpstreamGrade}" />
                             <DataGridTextColumn Header="Slope (percent)" Binding="{Binding Slope}" />
                         </DataGrid.Columns>
                    </DataGrid>
                </Expander>
