<Window x:Class="RCS.Cogo.Wpf.Views.InvertCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invert Calculator" Height="650" Width="360"
        Background="#1E1E1E" Foreground="#D4D4D4"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Part Number / Search -->
            <RowDefinition Height="Auto"/> <!-- Top Elevator -->
            <RowDefinition Height="Auto"/> <!-- Outer Diameter -->
            <RowDefinition Height="Auto"/> <!-- Nominal Diameter -->
            <RowDefinition Height="Auto"/> <!-- Thickness -->
            <RowDefinition Height="Auto"/> <!-- Inner Diameter -->
            <RowDefinition Height="Auto"/> <!-- Deflection -->
            <RowDefinition Height="Auto"/> <!-- Note -->
            <RowDefinition Height="Auto"/> <!-- Calculation -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Part Number (Specification Lookup):" FontWeight="Bold" Foreground="CornflowerBlue"/>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtPartNumber" Text="{Binding PartNumber, UpdateSourceTrigger=PropertyChanged}" Background="#252526" Foreground="White" Padding="5"/>
                <Button Grid.Column="1" Content="Load Specs" Click="LoadSpecs_Click" Width="80" Margin="5,0,0,0" Background="#2D2D30" Foreground="White"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Top Outside Wall Elevation:"/>
            <TextBox x:Name="TxtTopElev" Text="{Binding TopOutsideWallElev, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:F3\}}" Background="#252526" Foreground="White" Padding="5"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="Outer Diameter (OD):"/>
                <TextBox x:Name="TxtOuterDia" Text="{Binding OuterDiameter, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:F3\}}" Background="#252526" Foreground="White" Padding="5"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="Nominal Diameter:"/>
                <TextBox x:Name="TxtNominalDia" Text="{Binding NominalDiameter, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:F3\}}" Background="#252526" Foreground="White" Padding="5"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Wall Thickness (Top):"/>
            <TextBox x:Name="TxtThickness" Text="{Binding OuterWallThicknessTop, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:F3\}}" Background="#252526" Foreground="White" Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="Inner Diameter:"/>
            <TextBox x:Name="TxtInnerDia" Text="{Binding InnerDiameter, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:F3\}}" Background="#252526" Foreground="White" Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,10">
            <TextBlock Text="Deflection (optional, informational):"/>
            <TextBox x:Name="TxtDeflection" Text="{Binding Deflection, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:F3\}}" Background="#252526" Foreground="White" Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Margin="0,0,0,15">
            <TextBlock Text="Part Note:"/>
            <TextBox x:Name="TxtNote" Text="{Binding PartNote, UpdateSourceTrigger=PropertyChanged}" Background="#252526" Foreground="White" Padding="5" Height="40" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Margin="0,10,0,10">
            <TextBlock Text="Computed Invert:" Foreground="CornflowerBlue" FontWeight="Bold"/>
            <TextBlock x:Name="TxtResult" Text="{Binding EstimatedInvert, Mode=OneWay, StringFormat=\{0:F3\}}" FontSize="16" Foreground="LightGreen" FontWeight="Bold" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Cancel" Click="Cancel_Click" Background="#2D2D30" Foreground="White" Padding="10,8" Margin="0,0,5,0"/>
            <Button Grid.Column="1" Content="Apply &amp; Save Specs" Click="Apply_Click" Background="#007ACC" Foreground="White" Padding="10,8" Margin="5,0,0,0"/>
        </Grid>
    </Grid>
</Window>
