<Window x:Class="RCS.Cogo.Wpf.Views.GeneralSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="General Settings" Height="550" Width="420" 
        Background="#1E1E1E" Foreground="White" WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="General Settings" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Symbol Scale -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Viewport Symbol Scale:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableSymbolScales}" SelectedItem="{Binding SymbolScaleMultiplier}" Width="80" Background="#333333" Foreground="White" />
            <TextBlock Grid.Column="2" Text="x" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </Grid>

        <!-- Legend -->
        <CheckBox Grid.Row="2" IsChecked="{Binding ShowViewportLegend}" Content="Show Symbol Legend in Viewport" Foreground="White" Background="#1E1E1E" Margin="0,0,0,15"/>

        <!-- Log Order -->
        <CheckBox Grid.Row="3" IsChecked="{Binding IsOutputLogDescending}" Content="Output Log Descending" Foreground="White" Background="#1E1E1E" ToolTip="Tick to show newest logs at the top (Descending)" Margin="0,0,0,15"/>

        <!-- JEA Settings -->
        <GroupBox Grid.Row="4" Header="JEA As-Built Settings" Foreground="#56CCF2"
                  BorderBrush="#2C4060" Margin="0,0,0,15">
            <StackPanel Margin="10">
                <!-- Template Path -->
                <TextBlock Text="Blank JEA Template Path:" Foreground="#AABBCC" Margin="0,0,0,4" FontSize="11"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="JeaTemplatePathBox"
                             Text="{Binding JeaTemplatePath, UpdateSourceTrigger=PropertyChanged}"
                             Background="#252932" Foreground="White" BorderBrush="#2C4060"
                             Padding="4,3" VerticalContentAlignment="Center"
                             ToolTip="Path to the blank JEA As Built Template 2024.xlsx"/>
                    <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0"
                            Background="#1A3048" Foreground="#56CCF2" BorderBrush="#2C4060"
                            Padding="10,3" Click="BrowseJeaTemplate_Click"/>
                </Grid>
                <!-- StatePlane Zone -->
                <TextBlock Text="State Plane Zone (for Lat/Lon auto-compute):" Foreground="#AABBCC" Margin="0,0,0,4" FontSize="11"/>
                <ComboBox x:Name="StatePlaneZoneBox"
                          ItemsSource="{Binding AvailableStatePlaneZones}"
                          SelectedItem="{Binding JeaStatePlaneZone}"
                          Background="#252932" Foreground="White" BorderBrush="#2C4060"/>
            </StackPanel>
        </GroupBox>

        <!-- Cogo Marker GroupBox -->
        <GroupBox Grid.Row="5" Header="Cogo Marker" Foreground="White" BorderBrush="#555555" Margin="0,0,0,15">
            <StackPanel Margin="10">
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Point Marker Size:" VerticalAlignment="Center" Foreground="White"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePointMarkerSizes}" SelectedItem="{Binding PointMarkerSize}" Background="#333333" Foreground="White"/>
                </Grid>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Point Number Size:" VerticalAlignment="Center" Foreground="White"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePointNumberSizes}" SelectedItem="{Binding PointNumberSize}" Background="#333333" Foreground="White"/>
                </Grid>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Figure Line Width:" VerticalAlignment="Center" Foreground="White"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFigureLineWidths}" SelectedItem="{Binding FigureLineWidth}" Background="#333333" Foreground="White"/>
                </Grid>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Closure Tolerance:" VerticalAlignment="Center" Foreground="White"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableClosureTolerances}" SelectedItem="{Binding MapCheckClosureTolerance}" Background="#333333" Foreground="White"/>
                </Grid>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Min Boundary Area (sf):" VerticalAlignment="Center" Foreground="White"/>
                    <TextBox Grid.Column="1" Text="{Binding MinimumBoundaryArea, UpdateSourceTrigger=PropertyChanged}" Background="#333333" Foreground="White" BorderThickness="0" Padding="2" VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Save button is basically Close -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Click="Close_Click" Padding="20,5" Background="#2D2D30" Foreground="White" BorderBrush="#3E3E42" BorderThickness="1"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
