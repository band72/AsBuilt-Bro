<Window x:Class="RCS.Cogo.Wpf.Views.EditPointsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Points" Height="450" Width="600"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="#D4D4D4">
    <Window.Resources>
        <!-- Style to make button look like text -->
        <Style x:Key="TextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Edit Project Points" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid x:Name="PointsGrid" Grid.Row="1" ItemsSource="{Binding Points}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  Background="#252526" BorderThickness="1" BorderBrush="#3E3E42" RowBackground="#1E1E1E" AlternatingRowBackground="#2D2D30">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Point Number" Binding="{Binding Id}" Width="100" IsReadOnly="True">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="#333333"/>
                            <Setter Property="Foreground" Value="#A0A0A0"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Northing" Binding="{Binding Northing, StringFormat=F3}" Width="100"/>
                <DataGridTextColumn Header="Easting" Binding="{Binding Easting, StringFormat=F3}" Width="100"/>
                <DataGridTextColumn Header="Elevation" Binding="{Binding Elevation, StringFormat=F3}" Width="100"/>
                
                <DataGridTemplateColumn Header="Description (Click to Edit)" SortMemberPath="Description" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Description, TargetNullValue='[Empty]'}" 
                                    Style="{StaticResource TextButtonStyle}"
                                    Command="{Binding DataContext.EditDescriptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" IsCancel="True" Width="80" Background="#3E3E42" Foreground="White" BorderThickness="0" Padding="5"/>
        </StackPanel>
    </Grid>
</Window>
