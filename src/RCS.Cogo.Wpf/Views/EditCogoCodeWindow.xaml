<Window x:Class="RCS.Cogo.Wpf.Views.EditCogoCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Cogo Code" Height="380" Width="400"
        WindowStartupLocation="CenterOwner" 
        Background="#1E1E1E" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Local Code -->
            <RowDefinition Height="Auto"/> <!-- System Code -->
            <RowDefinition Height="Auto"/> <!-- Description -->
            <RowDefinition Height="Auto"/> <!-- Block -->
            <RowDefinition Height="Auto"/> <!-- Symbol Preview -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Edit Cogo Code" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <!-- Local Code -->
        <TextBlock Grid.Row="1" Text="Local Code:" Margin="0,0,0,5" Foreground="White" />
        <TextBox x:Name="txtLocalCode" Grid.Row="1" Margin="90,0,0,15" Padding="5" Background="#2D2D30" Foreground="White" BorderThickness="1" BorderBrush="#3F3F46" />

        <!-- System Code -->
        <TextBlock Grid.Row="2" Text="System Code:" Margin="0,0,0,5" Foreground="Gray" ToolTip="System Codes are Read-Only"/>
        <TextBox x:Name="txtSystemCode" Grid.Row="2" Margin="90,0,0,15" Padding="5" IsReadOnly="True" Background="#1E1E1E" Foreground="Gray" BorderThickness="1" BorderBrush="#3F3F46" ToolTip="System Codes are Read-Only"/>

        <!-- Description -->
        <TextBlock Grid.Row="3" Text="Description:" Margin="0,0,0,5" Foreground="Gray" ToolTip="Descriptions are Read-Only"/>
        <TextBox x:Name="txtDescription" Grid.Row="3" Margin="90,0,0,15" Padding="5" IsReadOnly="True" Background="#1E1E1E" Foreground="Gray" BorderThickness="1" BorderBrush="#3F3F46" ToolTip="Descriptions are Read-Only"/>

        <!-- Block -->
        <TextBlock Grid.Row="4" Text="Block:" Margin="0,0,0,5" Foreground="White" />
        <TextBox x:Name="txtBlock" Grid.Row="4" Margin="90,0,0,15" Padding="5" Background="#2D2D30" Foreground="White" BorderThickness="1" BorderBrush="#3F3F46" />

        <!-- Preview Image -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Symbol Preview:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="Gray"/>
            <Image x:Name="imgPreview" Width="30" Height="30" Stretch="Uniform" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Width="80" Padding="5" Margin="0,0,10,0" Background="#007ACC" Foreground="White" BorderThickness="0" Click="btnSave_Click"/>
            <Button Content="Delete" Width="80" Padding="5" Margin="0,0,10,0" Background="#A1260D" Foreground="White" BorderThickness="0" Click="btnDelete_Click"/>
            <Button Content="Close" Width="80" Padding="5" Background="#2D2D30" Foreground="White" BorderThickness="1" BorderBrush="#3F3F46" Click="btnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
