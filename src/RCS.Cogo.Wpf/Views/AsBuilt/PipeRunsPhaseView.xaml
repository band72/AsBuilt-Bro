<UserControl x:Class="RCS.Cogo.Wpf.Views.AsBuilt.PipeRunsPhaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="2*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#11111B" Padding="10,6"
                BorderBrush="#1E1E2E" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="Pipe" Foreground="#CDD6F4" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Pipe Runs" FontSize="13" FontWeight="Bold"
                           Foreground="#CDD6F4" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Separator Width="1" Background="#1E1E2E" Margin="12,0"/>
                <Button x:Name="BtnAddRun" Padding="10,4" Background="#1C1C2E" Foreground="#CDD6F4" BorderBrush="#313244" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Margin="0,0,6,0" Click="BtnAddRun_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Add Run" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnComputeSlopes" Padding="10,4" Background="#1C1C2E" Foreground="#89DCEB" BorderBrush="#313244" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Margin="0,0,6,0" Click="BtnComputeSlopes_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Calculator" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Compute Slopes" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnAutoChain" Padding="10,4" Background="#1C1C2E" Foreground="#9B59B6" BorderBrush="#313244" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Margin="0,0,6,0" Click="BtnAutoChain_Click" ToolTip="Sort runs into a continuous chain using shared structure points">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Link" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Auto-Chain" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnReverseFlow" Padding="10,4" Background="#1C1C2E" Foreground="#FAB387" BorderBrush="#313244" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Margin="0,0,6,0" Click="BtnReverseFlow_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="SwapHorizontal" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Flip Flow" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnGraphProfile" Padding="10,4" Background="#1E1E2E" Foreground="#F5C2E7" BorderBrush="#F5C2E7" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Margin="0,0,6,0" Click="BtnGraphProfile_Click" ToolTip="View interactive 2D profile and intersection cross-sections.">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ChartLine" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Graph Profile" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Separator Width="1" Background="#1E1E2E" Margin="12,0"/>
                <TextBlock x:Name="TxtRunCount" Text="0 runs"
                           FontSize="11" Foreground="#BAC2DE"
                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Runs Grid -->
        <DataGrid Grid.Row="1" x:Name="RunsGrid"
                  AutoGenerateColumns="False" CanUserAddRows="True"
                  CanUserDeleteRows="True" SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  Background="#0F0F17" RowBackground="#11111B"
                  AlternatingRowBackground="#181825"
                  Foreground="#CDD6F4" BorderThickness="0"
                  FontFamily="Consolas" FontSize="12"
                  ColumnHeaderHeight="30" RowHeight="26"
                  SelectionChanged="RunsGrid_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E1E2E"/>
                    <Setter Property="Foreground" Value="#BAC2DE"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="FontSize"   Value="10"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding"    Value="8,0"/>
                    <Setter Property="BorderBrush" Value="#1E1E2E"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Run ID"    Binding="{Binding Id}"           Width="90"/>
                <DataGridTextColumn Header="From Pt"   Binding="{Binding FromPointId}"  Width="75"/>
                <DataGridTextColumn Header="To Pt"     Binding="{Binding ToPointId}"    Width="75"/>
                <DataGridTextColumn Header="Dia (in)"  Binding="{Binding Diameter}"     Width="65"/>
                <DataGridTextColumn Header="Material"  Binding="{Binding Material}"     Width="80"/>
                <DataGridTextColumn Header="Inv Start" Binding="{Binding InvertStart, StringFormat=F2}" Width="80"/>
                <DataGridTextColumn Header="Inv End"   Binding="{Binding InvertEnd,   StringFormat=F2}" Width="80"/>
                <DataGridTextColumn Header="Slope %"   Binding="{Binding SlopePercent, StringFormat=F3}" Width="70"/>
                <DataGridCheckBoxColumn Header="Reversed" Binding="{Binding FlowReversed}" Width="70"/>
                <DataGridTextColumn Header="Part Key"  Binding="{Binding PartKey}"      Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#1E1E2E"/>

        <!-- Calculation trace for selected run -->
        <Border Grid.Row="3" Background="#11111B"
                BorderBrush="#1E1E2E" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="RUN DETAILS" FontSize="9" FontWeight="SemiBold"
                           Foreground="#BAC2DE" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" x:Name="TxtRunDetail"
                           Text="Select a run to see calculated properties."
                           Foreground="#BAC2DE" FontFamily="Consolas" FontSize="11"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
