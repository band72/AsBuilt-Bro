<Window x:Class="RCS.Cogo.Wpf.Views.FiguresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Figures" Height="800" Width="1000"
        Background="{StaticResource BrBg}" Foreground="{StaticResource BrTextPrimary}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Filter by Name Prefix: " VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="NamePrefixFilterComboBox" Width="100" SelectionChanged="NamePrefixFilterComboBox_SelectionChanged" Background="#E0E0E0" Foreground="Black" BorderBrush="Gray" Margin="0,0,10,0" IsEditable="True" IsReadOnly="True">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#E0E0E0"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <Button Content="Set Material..." Width="120" Margin="20,0,0,0" Click="MaterialButton_Click" Background="{StaticResource BrAccentDim}" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            <Button Content="Active Viewer" Width="120" Margin="20,0,0,0" Click="ActiveViewerButton_Click" Background="{StaticResource BrSuccess}" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            <Button Content="Sync Figures" Width="120" Margin="20,0,0,0" Click="SyncButton_Click" Background="#007acc" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            <Button Content="Delete Selected Figure" Width="150" Margin="20,0,0,0" Click="DeleteButton_Click" Background="{StaticResource BrError}" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Grid -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="1.5*"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="FiguresDataGrid" Grid.Row="0" AutoGenerateColumns="False" SelectionChanged="FiguresDataGrid_SelectionChanged" IsReadOnly="False" RowEditEnding="FiguresDataGrid_RowEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PartKey" Binding="{Binding PartKey}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Subtype" Binding="{Binding Subtype}"/>
                        <DataGridTextColumn Header="Discipline" Binding="{Binding Discipline}"/>
                        <DataGridTextColumn Header="FeatureType" Binding="{Binding FeatureType}"/>
                        <DataGridTextColumn Header="Material" Binding="{Binding Material}"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}"/>
                        <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}"/>
                        <DataGridTextColumn Header="Model" Binding="{Binding ManufacturerPartNo}"/>
                        <DataGridTextColumn Header="Year" Binding="{Binding YearManufactured}"/>
                        <DataGridTextColumn Header="Facility Owner" Binding="{Binding FacilityOwner}"/>
                        <DataGridTextColumn Header="Layer" Binding="{Binding Layer}"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding DescriptionText}"/>
                        <DataGridCheckBoxColumn Header="Closed" Binding="{Binding IsClosed}" IsReadOnly="True" />
                        <DataGridCheckBoxColumn Header="Visible" Binding="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{StaticResource BrBorder}"/>

                <Grid Grid.Row="2" Background="{StaticResource BrBg}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    
                    <DataGrid x:Name="PointsDataGrid" Grid.Column="0" AutoGenerateColumns="False" SelectionChanged="PointsDataGrid_SelectionChanged" IsReadOnly="True" Margin="0,0,5,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding OrderIndex}"/>
                            <DataGridTextColumn Header="PointID" Binding="{Binding PointId}"/>
                            <DataGridTextColumn Header="Northing" Binding="{Binding Point.Northing, StringFormat=N4}"/>
                            <DataGridTextColumn Header="Easting" Binding="{Binding Point.Easting, StringFormat=N4}"/>
                            <DataGridTextColumn Header="Bulge" Binding="{Binding Bulge, StringFormat=N4}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PointEditForm" IsEnabled="False" Background="{StaticResource BrSurface}" Margin="0">
                        <TextBlock Text="Edit Vertex" FontWeight="Bold" Margin="5"/>
                        <TextBlock Text="Order Index:" Margin="5,0"/>
                        <TextBox x:Name="TxtOrderIndex" Margin="5,0,5,5" Background="{StaticResource BrBorder}" Foreground="White" BorderThickness="0" Padding="2"/>
                        <TextBlock Text="Bulge:" Margin="5,0"/>
                        <TextBox x:Name="TxtBulge" Margin="5,0,5,5" Background="{StaticResource BrBorder}" Foreground="White" BorderThickness="0" Padding="2"/>
                        
                        <TextBlock Text="Northing:" Margin="5,0"/>
                        <TextBox x:Name="TxtNorthing" Margin="5,0,5,5" Background="{StaticResource BrBorder}" Foreground="White" BorderThickness="0" Padding="2" TextChanged="VertexCoordinate_TextChanged"/>
                        <TextBlock Text="Easting:" Margin="5,0"/>
                        <TextBox x:Name="TxtEasting" Margin="5,0,5,5" Background="{StaticResource BrBorder}" Foreground="White" BorderThickness="0" Padding="2" TextChanged="VertexCoordinate_TextChanged"/>
                        <TextBlock Text="Elevation:" Margin="5,0"/>
                        <TextBox x:Name="TxtElevation" Margin="5,0,5,5" Background="{StaticResource BrBorder}" Foreground="White" BorderThickness="0" Padding="2" TextChanged="VertexCoordinate_TextChanged"/>

                        <Border Background="{StaticResource BrBorder}" Margin="5,5,5,5" Padding="5" CornerRadius="2">
                            <StackPanel>
                                <TextBlock x:Name="LblSlopePrev" Text="Slope from Prev: N/A" Foreground="{StaticResource BrTextSecondary}" Margin="0,0,0,2" FontSize="11"/>
                                <TextBlock x:Name="LblSlopeNext" Text="Slope to Next: N/A" Foreground="{StaticResource BrTextSecondary}" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Save Vertex" Click="SavePointButton_Click" Background="{StaticResource BrSuccess}" Foreground="White" BorderThickness="0" FontWeight="Bold" Margin="5,10,5,5" Padding="5"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BrBorder}"/>

            <!-- Right: Viewer -->
            <Border Grid.Column="2" BorderThickness="1" BorderBrush="{StaticResource BrBorder}" Background="#121212" Margin="5,0,0,0">
                <Grid>
                    <TextBlock Text="Figure Viewer" Margin="10" FontWeight="Bold" Foreground="{StaticResource BrTextMuted}"/>
                    <Canvas x:Name="FigureCanvas" Margin="10,30,10,10" SizeChanged="FigureCanvas_SizeChanged" ClipToBounds="True"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
