<Window x:Class="RCS.Cogo.Wpf.Views.EditDescriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Description" Height="220" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">

    <Grid Background="{StaticResource BrBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBand}">
            <TextBlock Text="✏️  Edit Description"
                       VerticalAlignment="Center"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextPrimary}"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,14">
            <TextBlock Style="{StaticResource FieldLabel}" Text="DESCRIPTION"/>
            <TextBox x:Name="DescriptionTextBox"
                     Text="{Binding SelectedDescription, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="SELECT LOCAL CODE"/>
            <ComboBox x:Name="LocalCodesComboBox"
                      ItemsSource="{Binding AvailableCodes}"
                      SelectedItem="{Binding SelectedDescription}"
                      IsEditable="True" StaysOpenOnEdit="True"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource WindowFooterBand}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Update" IsDefault="True" Click="Update_Click"
                        Style="{StaticResource BtnPrimary}" Width="90" Margin="0,0,8,0"/>
                <Button Content="Cancel" IsCancel="True"
                        Style="{StaticResource BtnGhost}" Width="90"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
