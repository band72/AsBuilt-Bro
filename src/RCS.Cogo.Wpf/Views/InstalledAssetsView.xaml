                             <DataGridTextColumn Header="Lining Manufacturer" Binding="{Binding LiningManufacturer}" />
                             <DataGridTextColumn Header="Lining Material" Binding="{Binding LiningMaterial}" />
                             <DataGridTextColumn Header="Fitting Top Elevation (Feet)" Binding="{Binding TopElevation}" />
                             <DataGridTextColumn Header="Finished Grade Elevation (Feet)" Binding="{Binding GradeElevation}" />
                             <DataGridTextColumn Header="Fitting Depth (Feet)" Binding="{Binding Depth}" />
                             <DataGridTextColumn Header="X Coord (State Plane Easting Feet)" Binding="{Binding Easting}" />
                             <DataGridTextColumn Header="Y Coord (State Plane Northing Feet)" Binding="{Binding Northing}" />
