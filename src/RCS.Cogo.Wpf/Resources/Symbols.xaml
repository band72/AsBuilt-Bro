<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Premium Reusable Effects -->
    <DropShadowEffect x:Key="SymbolShadow" Color="Black" Direction="315" ShadowDepth="0.2" BlurRadius="0.3" Opacity="0.7"/>

    <!-- SEWER/STORM MANHOLE -->
    <DataTemplate x:Key="Symbol_Manhole">
        <Canvas Width="28" Height="28">
            <Ellipse Width="18" Height="18" Canvas.Left="5" Canvas.Top="5" 
                     Fill="{Binding Fill, FallbackValue=#555555, TargetNullValue=#555555}" 
                     Stroke="White" StrokeThickness="1.5" Effect="{StaticResource SymbolShadow}"/>
            <!-- Diagonal Hatching lines approximation -->
            <Line X1="8"  Y1="6"  X2="22" Y2="20" Stroke="White" StrokeThickness="0.5" Opacity="0.5"/>
            <Line X1="6"  Y1="10" X2="18" Y2="22" Stroke="White" StrokeThickness="0.5" Opacity="0.5"/>
            <Line X1="10" Y1="6"  X2="22" Y2="18" Stroke="White" StrokeThickness="0.5" Opacity="0.5"/>
            <Line X1="6"  Y1="14" X2="14" Y2="22" Stroke="White" StrokeThickness="0.5" Opacity="0.5"/>
            <Line X1="14" Y1="6"  X2="22" Y2="14" Stroke="White" StrokeThickness="0.5" Opacity="0.5"/>
        </Canvas>
    </DataTemplate>
    
    <!-- CATCH BASIN / INLET (CB) -->
    <DataTemplate x:Key="Symbol_Inlet">
        <Canvas Width="28" Height="28">
            <Rectangle Width="20" Height="14" Canvas.Left="4" Canvas.Top="7" 
                       Fill="{Binding Fill, FallbackValue=#333333, TargetNullValue=#333333}" 
                       Stroke="White" StrokeThickness="1.5" Effect="{StaticResource SymbolShadow}"/>
            <Line X1="4" Y1="11" X2="24" Y2="11" Stroke="White" StrokeThickness="1"/>
            <Line X1="4" Y1="14" X2="24" Y2="14" Stroke="White" StrokeThickness="1"/>
            <Line X1="4" Y1="17" X2="24" Y2="17" Stroke="White" StrokeThickness="1"/>
            <TextBlock Text="CB" Foreground="White" FontSize="7" Canvas.Left="26" Canvas.Top="9" FontWeight="Bold"/>
        </Canvas>
    </DataTemplate>

    <!-- WATER METER (WM) -->
    <DataTemplate x:Key="Symbol_Meter">
        <Canvas Width="28" Height="28">
            <Rectangle Width="18" Height="14" Canvas.Left="5" Canvas.Top="7" 
                       Fill="{Binding Fill, FallbackValue=#333333, TargetNullValue=#333333}" 
                       Stroke="White" StrokeThickness="1.5" Effect="{StaticResource SymbolShadow}"/>
            <TextBlock Text="WM" Foreground="White" FontSize="9" Canvas.Left="6" Canvas.Top="8" FontWeight="Bold"/>
        </Canvas>
    </DataTemplate>

    <!-- WATER VALVE -->
    <DataTemplate x:Key="Symbol_WaterValve">
        <Canvas Width="28" Height="28">
            <!-- Left & Right Bowtie Polygons -->
            <Polygon Points="5,9 14,14 5,19" Fill="{Binding Fill, FallbackValue=Blue, TargetNullValue=Blue}" Stroke="White" StrokeThickness="1.5" Effect="{StaticResource SymbolShadow}"/>
            <Polygon Points="23,9 14,14 23,19" Fill="{Binding Fill, FallbackValue=Blue, TargetNullValue=Blue}" Stroke="White" StrokeThickness="1.5" Effect="{StaticResource SymbolShadow}"/>
            <TextBlock Text="W" Foreground="White" FontSize="9" Canvas.Left="10" Canvas.Top="0" FontWeight="Bold" Background="#77000000"/>
        </Canvas>
    </DataTemplate>

    <!-- FIRE HYDRANT -->
    <DataTemplate x:Key="Symbol_Hydrant">
        <Canvas Width="28" Height="28" Effect="{StaticResource SymbolShadow}">
            <!-- Horizontal Line -->
            <Line X1="2" Y1="14" X2="10" Y2="14" Stroke="White" StrokeThickness="1.5"/>
            <!-- Main Center Circle -->
            <Ellipse Width="10" Height="10" Canvas.Left="10" Canvas.Top="9" Fill="{Binding Fill, FallbackValue=Red, TargetNullValue=Red}" Stroke="White" StrokeThickness="1.5"/>
            <!-- Diagonal Divider in Circle -->
            <Line X1="11.5" Y1="10.5" X2="18.5" Y2="17.5" Stroke="White" StrokeThickness="1"/>
            <!-- Downward Valve / Bowtie -->
            <Polygon Points="13,19 17,19 15,22" Fill="White" Stroke="White" StrokeThickness="1"/>
            <Polygon Points="13,25 17,25 15,22" Fill="White" Stroke="White" StrokeThickness="1"/>
        </Canvas>
    </DataTemplate>

    <!-- GENERIC FITTING -->
    <DataTemplate x:Key="Symbol_Fitting">
        <Canvas Width="28" Height="28">
            <Ellipse Width="18" Height="18" Canvas.Left="5" Canvas.Top="5" 
                     Fill="{Binding Fill, FallbackValue=#333333, TargetNullValue=#333333}" 
                     Stroke="White" StrokeThickness="1.5" Effect="{StaticResource SymbolShadow}"/>
            <TextBlock Text="F" Foreground="White" FontSize="11" Canvas.Left="11" Canvas.Top="6" FontWeight="Bold"/>
        </Canvas>
    </DataTemplate>

    <!-- DEFAULT CAP / NOT FOUND -->
    <DataTemplate x:Key="Symbol_Default">
        <Canvas Width="28" Height="28">
            <Polygon Points="10,10 18,10 18,18" Fill="{Binding Fill, FallbackValue=Gray, TargetNullValue=Gray}" Stroke="White" StrokeThickness="1.5" Effect="{StaticResource SymbolShadow}"/>
        </Canvas>
    </DataTemplate>
    
    <!-- ELECTRIC POLE -->
    <DataTemplate x:Key="Symbol_ElectricPole">
        <Canvas Width="28" Height="28">
            <!-- Outer Pole Boundary Ring -->
            <Ellipse Width="18" Height="18" Canvas.Left="5" Canvas.Top="5" 
                     Stroke="White" StrokeThickness="1.5" Fill="{Binding Fill, FallbackValue=Red, TargetNullValue=Red}" Effect="{StaticResource SymbolShadow}"/>
            
            <!-- Central E - Vertical Spine -->
            <Line X1="11.5" Y1="10" X2="11.5" Y2="18" 
                  Stroke="White" StrokeThickness="1.5" />
                  
            <!-- Central E - Top Prong -->
            <Line X1="11.5" Y1="10" X2="17.5" Y2="10" 
                  Stroke="White" StrokeThickness="1.5" />
                  
            <!-- Central E - Middle Prong -->
            <Line X1="11.5" Y1="14" X2="15.5" Y2="14" 
                  Stroke="White" StrokeThickness="1.5" />
                  
            <!-- Central E - Bottom Prong -->
            <Line X1="11.5" Y1="18" X2="17.5" Y2="18" 
                  Stroke="White" StrokeThickness="1.5" />
        </Canvas>
    </DataTemplate>

    <!-- ELECTRIC BOX -->
    <DataTemplate x:Key="Symbol_ElectricBox">
        <Canvas Width="28" Height="28">
            <Rectangle Width="18" Height="18" Canvas.Left="5" Canvas.Top="5" 
                       Stroke="White" StrokeThickness="1.5" Fill="{Binding Fill, FallbackValue=Red, TargetNullValue=Red}" Effect="{StaticResource SymbolShadow}"/>
            
            <!-- Lightning Bolt -->
            <Polygon Points="15.5,7 9,15 15,15 11,21" Fill="White" />
        </Canvas>
    </DataTemplate>
    
    <!-- Selector -->
    <DataTemplate x:Key="StructureSymbolSelector">
        <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource SymbolSelectorService}"/>
    </DataTemplate>

</ResourceDictionary>
