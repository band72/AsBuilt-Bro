                             <DataGridTextColumn Header="PartKey" Binding="{Binding PartKey}"/>
                             <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
                             <DataGridTextColumn Header="Description" Binding="{Binding DescriptionText}"/>
                             <DataGridTextColumn Header="Script Content" Binding="{Binding ScriptContent}"/>
                         </DataGrid.Columns>
