<Window x:Class="RCS.Cogo.Wpf.Views.PipeCharacteristicsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pipe Characteristics Manage (Invert Calcs)" Height="600" Width="900"
        Background="#1E1E1E" Foreground="#D4D4D4"
        WindowStartupLocation="CenterOwner">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Add Row" Click="AddRow_Click" Padding="15,5" Margin="0,0,10,0" Background="#2D2D30" Foreground="White" ToolTip="Add a new blank specification row."/>
            <Button Content="Delete Row" Click="DeleteRow_Click" Padding="15,5" Margin="0,0,10,0" Background="#A52A2A" Foreground="White" FontWeight="Bold"/>
            <Button Content="Import CSV..." Click="Import_Click" Padding="15,5" Margin="0,0,10,0" Background="#2D2D30" Foreground="White"/>
            <Button Content="Export CSV..." Click="Export_Click" Padding="15,5" Margin="0,0,10,0" Background="#2D2D30" Foreground="White"/>
            <Button x:Name="BtnSelect" Content="Select Row" Click="SelectRow_Click" Padding="15,5" Margin="0,0,10,0" Background="#28A745" Foreground="White" FontWeight="Bold" Visibility="Collapsed"/>
            <Button Content="Save to Database" Click="Save_Click" Padding="15,5" Margin="0,0,10,0" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
            <Button Content="Close" Click="Close_Click" Padding="15,5" Background="#2D2D30" Foreground="White"/>
        </StackPanel>

        <DataGrid x:Name="SpecsGrid" Grid.Row="1" ItemsSource="{Binding Specifications}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" Background="#252526" RowBackground="#252526" Foreground="#D4D4D4"
                  BorderBrush="#3E3E42" HeadersVisibility="Column" GridLinesVisibility="All">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="5"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#252526"/>
                    <Setter Property="Foreground" Value="White"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="150"/>
                <DataGridTextColumn Header="Nor. Diameter" Binding="{Binding NominalDiameter}" Width="100"/>
                <DataGridTextColumn Header="Out. Diameter (OD)" Binding="{Binding OuterDiameter}" Width="130"/>
                <DataGridTextColumn Header="Wall Thickness" Binding="{Binding PipeThickness}" Width="110"/>
                <DataGridTextColumn Header="Inner Diameter" Binding="{Binding InnerDiameter}" Width="110"/>
                <DataGridTextColumn Header="Deflection" Binding="{Binding Deflection}" Width="90"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TxtStatus" Grid.Row="2" Margin="0,10,0,0" Foreground="LightGreen"/>
    </Grid>
</Window>
