<Window x:Class="RCS.Cogo.Wpf.Views.ReportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Configuration" Height="480" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">

    <Grid Background="{StaticResource BrBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBand}">
            <TextBlock Text="📊  Excel Export Configuration"
                       VerticalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextPrimary}"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,16,0">
            <StackPanel>

                <!-- Per-discipline GroupBoxes -->
                <GroupBox Header="Water">
                    <StackPanel>
                        <CheckBox Content="Export Water Data" IsChecked="{Binding ExportWater}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SHEET NAME"/>
                        <TextBox Text="{Binding WaterSheetName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Sewer (Sanitary)">
                    <StackPanel>
                        <CheckBox Content="Export Sewer Data" IsChecked="{Binding ExportSewer}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SHEET NAME"/>
                        <TextBox Text="{Binding SewerSheetName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Storm Drain">
                    <StackPanel>
                        <CheckBox Content="Export Storm Data" IsChecked="{Binding ExportStorm}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SHEET NAME"/>
                        <TextBox Text="{Binding StormSheetName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Gas">
                    <StackPanel>
                        <CheckBox Content="Export Gas Data" IsChecked="{Binding ExportGas}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SHEET NAME"/>
                        <TextBox Text="{Binding GasSheetName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="General">
                    <StackPanel>
                        <CheckBox Content="Include Null Values" IsChecked="{Binding IncludeNullValues}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="BEARING FORMAT"/>
                        <RadioButton Content="DMS (Degrees Minutes Seconds)"
                                     IsChecked="{Binding IsDMS}" GroupName="BearingFormat" Margin="0,3"/>
                        <RadioButton Content="DD (Decimal Degrees)"
                                     IsChecked="{Binding IsDD}" GroupName="BearingFormat" Margin="0,3"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource WindowFooterBand}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save Settings" IsDefault="True" Click="Save_Click"
                        Style="{StaticResource BtnPrimary}" Width="120" Margin="0,0,8,0"/>
                <Button Content="Cancel" IsCancel="True"
                        Style="{StaticResource BtnGhost}" Width="90"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
