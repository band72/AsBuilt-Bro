<Window x:Class="RCS.Cogo.Wpf.Views.AlignmentSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alignment Settings" Height="300" Width="400"
        Background="{StaticResource BrBg}" Foreground="{StaticResource BrTextPrimary}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Horizontal Settings -->
        <TextBlock Grid.Row="0" Text="Horizontal" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrAccent}"/>
        
        <CheckBox Grid.Row="1" Content="Show Horizontal Alignment Labels" 
                  IsChecked="{Binding ShowHorizontalAlignmentLabels}" />

        <Separator Grid.Row="2" />

        <!-- Vertical Settings -->
        <TextBlock Grid.Row="3" Text="Vertical" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrAccent}"/>
        
        <TextBlock Grid.Row="4" Text="Vertical alignment settings placeholder..." FontStyle="Italic" Foreground="Gray"/>
        
        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Close" Width="80" Height="30" Click="CloseButton_Click" Background="{StaticResource BrBorder}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
