<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Premium Reusable Effects -->
    <DropShadowEffect x:Key="SymbolShadow" Color="Black" Direction="315" ShadowDepth="0.2" BlurRadius="0.3" Opacity="0.7"/>

    <!-- Premium Manhole (Thick Ring with inner drop and sleek typography) -->
    <DataTemplate x:Key="Symbol_Manhole">
        <Grid Width="2.5" Height="2.5">
            <Ellipse Stroke="{Binding Fill}" StrokeThickness="0.4">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.3,0.3">
                        <GradientStop Color="#44FFFFFF" Offset="0"/>
                        <GradientStop Color="#11000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <StaticResource ResourceKey="SymbolShadow"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="1.5" Height="1.5" Fill="{Binding Fill}" Opacity="0.2" />
            <TextBlock Text="M" Foreground="{Binding Fill}" FontWeight="Bold" FontSize="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-0.2,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="0.1" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </DataTemplate>
    
    <!-- Premium Water Valve (Geometric Bowtie with Glassmorphic gradient style) -->
    <DataTemplate x:Key="Symbol_WaterValve">
        <Grid Width="2" Height="2">
            <Path Data="M 0,0 L 2,2 L 2,0 L 0,2 Z" Stroke="White" StrokeThickness="0.15" StrokeLineJoin="Round">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#AAFFFFFF" Offset="0.0"/>
                        <GradientStop Color="Transparent" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Path Data="M 0,0 L 2,2 L 2,0 L 0,2 Z" Fill="{Binding Fill}" Opacity="0.85" StrokeLineJoin="Round">
                <Path.Effect>
                    <StaticResource ResourceKey="SymbolShadow"/>
                </Path.Effect>
            </Path>
            <!-- Center Pivot Pin -->
            <Ellipse Width="0.5" Height="0.5" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="0.3" Height="0.3" Fill="Black" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>
    
    <!-- Premium Hydrant (Sleek Crosshair Beacon) -->
    <DataTemplate x:Key="Symbol_Hydrant">
        <Grid Width="2.2" Height="2.2">
            <Ellipse Fill="{Binding Fill}" Stroke="White" StrokeThickness="0.2">
                <Ellipse.Effect>
                    <StaticResource ResourceKey="SymbolShadow"/>
                </Ellipse.Effect>
            </Ellipse>
            <Path Data="M 1.1,0 L 1.1,2.2 M 0,1.1 L 2.2,1.1" Stroke="White" StrokeThickness="0.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Ellipse Width="0.8" Height="0.8" Fill="White" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <!-- Premium Meter (Digital Dial Box) -->
    <DataTemplate x:Key="Symbol_Meter">
        <Grid Width="2" Height="1.4">
            <Rectangle Fill="{Binding Fill}" Stroke="White" StrokeThickness="0.15" RadiusX="0.2" RadiusY="0.2">
                <Rectangle.Effect>
                    <StaticResource ResourceKey="SymbolShadow"/>
                </Rectangle.Effect>
            </Rectangle>
            <Rectangle Width="1.6" Height="0.8" Fill="#1E1E24" RadiusX="0.1" RadiusY="0.1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Text="MTR" Foreground="Aqua" FontWeight="Bold" FontSize="0.45" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>
    
    <!-- Premium Fitting (Diamond Joint) -->
    <DataTemplate x:Key="Symbol_Fitting">
        <Grid Width="1.6" Height="1.6">
             <Path Data="M 0.8,0 L 1.6,0.8 L 0.8,1.6 L 0,0.8 Z" Fill="{Binding Fill}" Stroke="White" StrokeThickness="0.2" StrokeLineJoin="Round">
                <Path.Effect>
                    <StaticResource ResourceKey="SymbolShadow"/>
                </Path.Effect>
             </Path>
             <!-- Inner Accent -->
             <Path Data="M 0.8,0.3 L 1.3,0.8 L 0.8,1.3 L 0.3,0.8 Z" Fill="#44FFFFFF" Stretch="Fill"/>
        </Grid>
    </DataTemplate>

    <!-- Premium Default Node (Glowing Orb) -->
    <DataTemplate x:Key="Symbol_Default">
        <Grid Width="1.2" Height="1.2">
            <Ellipse Fill="{Binding Fill}" Stroke="White" StrokeThickness="0.15">
                <Ellipse.Effect>
                    <StaticResource ResourceKey="SymbolShadow"/>
                </Ellipse.Effect>
            </Ellipse>
            <!-- Specular Highlight -->
            <Ellipse Width="0.4" Height="0.4" Fill="White" Opacity="0.6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0.2,0.2,0,0"/>
        </Grid>
    </DataTemplate>
    
    <!-- Selector -->
    <DataTemplate x:Key="StructureSymbolSelector">
        <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource SymbolSelectorService}"/>
    </DataTemplate>

</ResourceDictionary>
