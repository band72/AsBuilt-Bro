<Window x:Class="RCS.Cogo.Wpf.Views.AlignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alignment Editor" Height="600" Width="1000"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="*"/>    
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="Edit Alignment" FontWeight="Bold" FontSize="16" Foreground="Cyan" Margin="0,0,0,10"/>
            
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Alignment Name:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Width="150" Background="#1E1E1E" Foreground="White" Padding="2" Margin="0,0,10,0"/>
                <Button Content="Save" Padding="10,2" Background="#007ACC" Foreground="White" BorderThickness="0"/>
            </StackPanel>
            
            <TextBlock Grid.Row="2" Text="Design-Points" FontWeight="Bold" Margin="0,0,0,5"/>
            
            <DataGrid Grid.Row="3" ItemsSource="{Binding DesignPoints}" AutoGenerateColumns="False" Margin="0,0,0,10"
                      BorderThickness="1" BorderBrush="#3E3E42" Background="#1E1E1E" RowBackground="#1E1E1E" AlternatingRowBackground="#252526" Foreground="#DCDCDC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Point Number" Binding="{Binding Id}" Width="80"/>
                    <DataGridTextColumn Header="Northing" Binding="{Binding Northing, StringFormat=F3}" Width="*"/>
                    <DataGridTextColumn Header="Easting" Binding="{Binding Easting, StringFormat=F3}" Width="*"/>
                    <DataGridTextColumn Header="Elevation" Binding="{Binding Elevation, StringFormat=F3}" Width="80"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#3E3E42"/>

        <Border Grid.Column="2" Background="Black" Margin="5" CornerRadius="5" ClipToBounds="True">
            <Grid Background="Transparent"
                  MouseWheel="OnMouseWheel" 
                  MouseRightButtonDown="OnMouseRightButtonDown" 
                  MouseRightButtonUp="OnMouseRightButtonUp" 
                  MouseLeftButtonDown="OnMouseLeftButtonDown"
                  MouseLeftButtonUp="OnMouseLeftButtonUp"
                  MouseMove="OnMouseMove">
                
                <Canvas x:Name="ViewportCanvas">
                    <Canvas.RenderTransform>
                        <MatrixTransform x:Name="WorldTransform"/>
                    </Canvas.RenderTransform>
                    <ItemsControl ItemsSource="{Binding Figures}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Polyline Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeLineJoin="Round"
                                          StrokeThickness="{Binding DataContext.LineMarkerScale, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>

                <!-- Zoom Window Rectangle -->
                <Rectangle x:Name="ZoomRect" Stroke="LightBlue" StrokeThickness="1" Fill="#33ADD8E6" 
                           HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"/>

                <!-- Zoom State Text Overlay -->
                <!-- Use FallbackValue because CurrentViewScale is on the main VM which AlignmentWindow inherits -->
                <TextBlock Text="{Binding CurrentViewScale, StringFormat='Zoom Scale: {0:F4}x'}" 
                           Foreground="#88FFFFFF" FontSize="12" Margin="10"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                
                <!-- Zoom Toolbar -->
                <!-- We will bind to local window commands or use the ViewModel's commands -->
                <!-- To ensure it doesn't conflict with main window, let's create our own commands in AlignmentWindow.xaml.cs 
                     or reuse the ShellViewModel commands. Reusing ShellViewModel commands works but invokes it on Main Window too.
                     Let's use the ShellViewModel commands for now as requested. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                    <Button Command="{Binding ZoomWindowCommand}" Content="WIN" Width="40" Height="30" Margin="0,0,5,0"
                            Background="#333333" Foreground="White" FontSize="14" FontWeight="Bold" ToolTip="Zoom Window"/>
                    <Button Command="{Binding ZoomInCommand}" Content="+" Width="30" Height="30" Margin="0,0,5,0"
                            Background="#333333" Foreground="White" FontSize="18" FontWeight="Bold" ToolTip="Zoom In"/>
                    <Button Command="{Binding ZoomOutCommand}" Content="-" Width="30" Height="30" Margin="0,0,5,0"
                            Background="#333333" Foreground="White" FontSize="18" FontWeight="Bold" ToolTip="Zoom Out"/>
                    <Button Command="{Binding ZoomExtentsCommand}" Content="[ ]" Width="30" Height="30"
                            Background="#333333" Foreground="White" FontSize="14" FontWeight="Bold" ToolTip="Zoom Extents"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
