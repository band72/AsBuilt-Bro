<Window x:Class="RCS.Cogo.Wpf.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loading Project..." Height="150" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        Background="#1E1E1E" Foreground="#D4D4D4">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TxtMessage" Text="Loading Project Data. Please Wait..." HorizontalAlignment="Center" Margin="0,0,0,20" FontSize="16"/>
            <ProgressBar IsIndeterminate="True" Height="15" Margin="20,0,20,0" Foreground="#007ACC" Background="#252526" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
