<UserControl x:Class="RCS.Cogo.Wpf.Views.AsBuiltWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RCS.Cogo.Wpf.ViewModels"
             xmlns:ab="clr-namespace:RCS.Cogo.Wpf.Views.AsBuilt"
             mc:Ignorable="d"
             Background="#12121F"
             d:DesignHeight="800" d:DesignWidth="1400">

    <UserControl.Resources>

        <!-- ── Color Tokens ──────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="Surface0"   Color="#12121F"/>
        <SolidColorBrush x:Key="Surface1"   Color="#1A1A2E"/>
        <SolidColorBrush x:Key="Surface2"   Color="#22223A"/>
        <SolidColorBrush x:Key="Accent"     Color="#4A90E2"/>
        <SolidColorBrush x:Key="AccentDark" Color="#2E6CB8"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#E8E8F0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#7A7A9A"/>
        <SolidColorBrush x:Key="StatusGreen"   Color="#2ECC71"/>
        <SolidColorBrush x:Key="StatusYellow"  Color="#F39C12"/>
        <SolidColorBrush x:Key="StatusRed"     Color="#E74C3C"/>
        <SolidColorBrush x:Key="Border0"       Color="#2A2A45"/>

        <!-- ── Converters ─────────────────────────────────────────────────── -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── Phase View Templates ──────────────────────────────────────── -->
        <DataTemplate x:Key="IntakeTemplate">
            <ab:IntakePhaseView/>
        </DataTemplate>
        <DataTemplate x:Key="PointsCleanupTemplate">
            <ab:PointsPhaseView/>
        </DataTemplate>
        <DataTemplate x:Key="StructuresTemplate">
            <ab:StructuresPhaseView/>
        </DataTemplate>
        <DataTemplate x:Key="PipeRunsTemplate">
            <ab:PipeRunsPhaseView/>
        </DataTemplate>
        <DataTemplate x:Key="PartsMappingTemplate">
            <ab:PartsMappingPhaseView/>
        </DataTemplate>
        <DataTemplate x:Key="ValidationTemplate">
            <ab:ValidationPhaseView/>
        </DataTemplate>
        <DataTemplate x:Key="DeliverablesTemplate">
            <ab:DeliverablesPhaseView/>
        </DataTemplate>

        <!-- ── Phase Selector ────────────────────────────────────────────── -->
        <ab:PhaseViewSelector x:Key="PhaseSelector"
            IntakeTemplate        ="{StaticResource IntakeTemplate}"
            PointsCleanupTemplate ="{StaticResource PointsCleanupTemplate}"
            StructuresTemplate    ="{StaticResource StructuresTemplate}"
            PipeRunsTemplate      ="{StaticResource PipeRunsTemplate}"
            PartsMappingTemplate  ="{StaticResource PartsMappingTemplate}"
            ValidationTemplate    ="{StaticResource ValidationTemplate}"
            DeliverablesTemplate  ="{StaticResource DeliverablesTemplate}"
            ExportPackageTemplate ="{StaticResource DeliverablesTemplate}"/>



        <!-- ── Workflow Navigator Step Item ──────────────────────────────── -->
        <Style x:Key="NavStepStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"                    Value="0"/>
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Brd"
                                Background="Transparent"
                                CornerRadius="6"
                                Margin="4,2"
                                Padding="8,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#252545"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#1C3A6E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Deliverable Card ───────────────────────────────────────────── -->
        <DataTemplate x:Key="DeliverableCardTemplate">
            <Border Background="#1E1E35"
                    CornerRadius="8"
                    BorderThickness="1"
                    Margin="0,4"
                    Padding="14,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                <Setter Property="BorderBrush" Value="#E74C3C"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBlocked}" Value="False">
                                <Setter Property="BorderBrush" Value="#2ECC71"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Type}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,2,0,0"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="4"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                        <Setter Property="Background" Value="#4D1A1A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBlocked}" Value="False">
                                        <Setter Property="Background" Value="#1A4D2E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"   Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="Text"       Value="Blocked"/>
                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="False">
                                            <Setter Property="Text"       Value="Ready"/>
                                            <Setter Property="Foreground" Value="#2ECC71"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── Primary Action Button ──────────────────────────────────────── -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"   Value="#4A90E2"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="FontFamily"   Value="{StaticResource FfBody}"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E6CB8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#2A2A45"/>
                                <Setter Property="Foreground" Value="#4A4A6A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#2ECC71"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27AE60"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1A3D25"/>
                    <Setter Property="Foreground" Value="#2E6C47"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!--
    ═══════════════════════════════════════════════════════════════════════════
      FOUR-PANE PRODUCTION WORKSPACE
      ┌──────────┬─────────────────────────────┬──────────────────────────┐
      │          │                             │                          │
      │   LEFT   │         CENTER              │         RIGHT            │
      │ Workflow  │    Step Editor / Grid       │   Live CAD Viewer        │
      │ Navigator │                             │                          │
      │          │                             │                          │
      ├──────────┴─────────────────────────────┴──────────────────────────┤
      │                    BOTTOM — Diagnostics / Log                       │
      └───────────────────────────────────────────────────────────────────┘
    ═══════════════════════════════════════════════════════════════════════════
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>  <!-- Splitter -->
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- ══ Top three panes ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"   MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="430" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Workflow Navigator ─────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource Surface1}"
                    BorderBrush="{StaticResource Border0}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="12,14,12,8">
                        <TextBlock Text="WORKFLOW" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding Job.Identity.JobNumber, FallbackValue='New Job'}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="Segoe UI" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Step List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Steps}"
                             SelectedItem="{Binding SelectedStep}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavStepStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Step number circle -->
                                    <Border Grid.Column="0" Width="22" Height="22"
                                            CornerRadius="11"
                                            Background="#252545"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StepNumber}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe UI"/>
                                    </Border>

                                    <!-- Label -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontFamily="Segoe UI"/>
                                    </StackPanel>

                                    <!-- Status icon -->
                                    <TextBlock Grid.Column="2" Text="{Binding StatusIcon}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Bottom nav buttons -->
                    <StackPanel Grid.Row="2" Margin="8,8">
                        <Button Content="◀  Back"
                                Style="{StaticResource ActionBtn}"
                                Background="#252545"
                                Command="{Binding GoToPrevStepCommand}"
                                Margin="0,0,0,4"/>
                        <Button Content="Next  ▶"
                                Style="{StaticResource ActionBtn}"
                                Command="{Binding GoToNextStepCommand}"
                                Margin="0,0,0,8"/>
                        <!-- Separator line -->
                        <Rectangle Height="1" Fill="#2A2A45" Margin="0,0,0,8"/>
                        <!-- Exit As-Built workspace -->
                        <Button x:Name="BtnCloseWorkspace"
                                Content="✕  Close As-Built"
                                Click="BtnCloseWorkspace_Click"
                                Background="#3A1A1A"
                                Foreground="#E74C3C"
                                BorderBrush="#E74C3C"
                                BorderThickness="1"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Height="30"
                                Cursor="Hand"
                                ToolTip="Return to COGO / Piping tabs">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#5A1A1A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#2A2A45"/>

            <!-- ── CENTER: Step Editor (content swapped by phase) ─────── -->
            <Border Grid.Column="2"
                    Background="{StaticResource Surface0}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Phase header strip -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Surface1}"
                            BorderBrush="{StaticResource Border0}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedStep.Label, FallbackValue='Intake'}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text="{Binding TransitionBlockerMessage}"
                                           FontSize="11"
                                           FontFamily="Segoe UI">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <!-- Default: visible (non-empty blocker message shows) -->
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                            <Style.Triggers>
                                                <!-- Collapse when empty or null -->
                                                <DataTrigger Binding="{Binding TransitionBlockerMessage}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TransitionBlockerMessage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="▶  Run Validation"
                                    Style="{StaticResource ActionBtn}"
                                    Command="{Binding ValidateNowCommand}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- ── Phase Content (swapped by PhaseViewSelector) ───────── -->
                    <ContentControl Grid.Row="1"
                                    Content="{Binding}"
                                    ContentTemplateSelector="{StaticResource PhaseSelector}"/>
                </Grid>
            </Border>


            <GridSplitter Grid.Column="3" Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#2A2A45"/>

            <!-- ── RIGHT: Live CAD Viewer (Canvas stub) ──────────────────── -->
            <Border Grid.Column="4"
                    Background="#0D0D1A"
                    BorderBrush="{StaticResource Border0}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Surface1}"
                            BorderBrush="{StaticResource Border0}"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍"  FontSize="14" Cursor="Hand" ToolTip="Zoom Extents"    VerticalAlignment="Center" Margin="4,0"/>
                            <TextBlock Text="🎯"  FontSize="14" Cursor="Hand" ToolTip="Zoom Selection"  VerticalAlignment="Center" Margin="4,0"/>
                            <TextBlock Text="🏷"  FontSize="14" Cursor="Hand" ToolTip="Toggle Labels"   VerticalAlignment="Center" Margin="4,0"/>
                            <TextBlock Text="🌐"  FontSize="14" Cursor="Hand" ToolTip="Toggle Basemap"  VerticalAlignment="Center" Margin="4,0"/>
                            <Separator Width="1" Background="{StaticResource Border0}" Margin="4,0"/>
                            <TextBlock Text="{Binding Job.Environment}"
                                       FontSize="10" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="4,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Canvas region
                         x:Name="CanvasRegion" is wired in code-behind to the
                         existing WPF geometry rendering pipeline (figures,
                         structure glyphs, pipe run arrows).                  -->
                    <Border Grid.Row="1" x:Name="CanvasRegion"
                            Background="#0D0D1A"
                            ClipToBounds="True">
                        <!-- The live geometry canvas is injected here at runtime.
                             Placeholder watermark shown until data is loaded.  -->
                        <TextBlock Text="Live CAD Viewer"
                                   Foreground="#252545"
                                   FontSize="20" FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Horizontal splitter ──────────────────────────────────────── -->
        <GridSplitter Grid.Row="1" Height="5"
                      HorizontalAlignment="Stretch"
                      Background="#2A2A45"/>

        <!-- ══ BOTTOM: Diagnostics Panel ══════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource Surface1}"
                BorderBrush="{StaticResource Border0}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tab strip -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            Background="{StaticResource Surface2}"
                            Height="30">
                    <TextBlock Text="  Errors"   FontSize="11" FontFamily="Segoe UI"
                               Foreground="{StaticResource StatusRed}"
                               VerticalAlignment="Center" Margin="4,0" Cursor="Hand"/>
                    <TextBlock Text="  Warnings" FontSize="11" FontFamily="Segoe UI"
                               Foreground="{StaticResource StatusYellow}"
                               VerticalAlignment="Center" Margin="4,0" Cursor="Hand"/>
                    <TextBlock Text="  Log"      FontSize="11" FontFamily="Segoe UI"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="4,0" Cursor="Hand"/>
                    <TextBlock Text="  Calc Trace" FontSize="11" FontFamily="Segoe UI"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="4,0" Cursor="Hand"/>
                </StackPanel>

                <!-- Issue list -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding LastValidation.Issues}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <!-- Severity badge -->
                                <Border Grid.Column="0" CornerRadius="3" Padding="6,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Background" Value="#4D1A1A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Background" Value="#4D3D1A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                    <Setter Property="Background" Value="#1A2D4D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Severity}"
                                               FontSize="10" FontWeight="SemiBold"
                                               FontFamily="Segoe UI">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                        <Setter Property="Foreground" Value="#F39C12"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                        <Setter Property="Foreground" Value="#4A90E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <!-- Category -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Category}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="Segoe UI"
                                           VerticalAlignment="Center"
                                           Margin="8,0"/>
                                <!-- Message -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Message}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontFamily="Segoe UI"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <!-- Zoom To link -->
                                <TextBlock Grid.Column="3"
                                           Text="Zoom To"
                                           FontSize="10"
                                           Foreground="{StaticResource Accent}"
                                           FontFamily="Segoe UI"
                                           Cursor="Hand"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

    </Grid>
</UserControl>
