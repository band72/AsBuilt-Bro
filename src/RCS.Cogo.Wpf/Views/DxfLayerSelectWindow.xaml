<Window x:Class="RCS.Cogo.Wpf.Views.DxfLayerSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select DXF Layers to Import" Height="300" Width="300"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrBg}" Foreground="White">
    <Grid Background="{StaticResource BrBg}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Select Layers to Import (Max 1000 points):" Margin="0,0,0,10" FontWeight="Bold"/>
        <ListBox x:Name="lstLayers" Grid.Row="1" Background="{StaticResource BrHeader}" Foreground="White" SelectionMode="Multiple"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Import" Click="BtnImport_Click" Width="80" Margin="0,0,10,0" Background="{StaticResource BrAccentDim}" Foreground="White"/>
            <Button Content="Cancel" Click="BtnCancel_Click" Width="80" Background="{StaticResource BrBorder}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
