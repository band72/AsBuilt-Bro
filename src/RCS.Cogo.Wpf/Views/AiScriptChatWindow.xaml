<Window x:Class="RCS.Cogo.Wpf.Views.AiScriptChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Script Assistant" Height="550" Width="450"
        Background="#1E1E1E" Foreground="#D4D4D4"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Welcome to AI Script Chat" FontWeight="Bold" FontSize="16" Foreground="Cyan" HorizontalAlignment="Center"/>
            <TextBlock Text="I can review your Piping and Cogo scripts for syntax errors." FontSize="12" Foreground="#A0A0A0" HorizontalAlignment="Center"/>
            
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="API Key:" VerticalAlignment="Center" Foreground="White" Margin="0,0,5,0"/>
                <TextBox x:Name="ApiKeyBox" Grid.Column="1" Height="24" Background="#2D2D30" Foreground="White" BorderBrush="#3E3E42" Margin="0,0,10,0"/>
                
                <TextBlock Grid.Column="2" Text="Model:" VerticalAlignment="Center" Foreground="White" Margin="0,0,5,0"/>
                <ComboBox x:Name="ModelSelector" Grid.Column="3" Height="24" Background="#2D2D30" Foreground="White" BorderBrush="#3E3E42" SelectedIndex="0">
                    <ComboBoxItem Content="gemini-3.1-pro-preview"/>
                    <ComboBoxItem Content="gemini-2.5-pro"/>
                    <ComboBoxItem Content="gemini-1.5-pro"/>
                    <ComboBoxItem Content="gemini-1.5-flash"/>
                    <ComboBoxItem Content="gpt-4o"/>
                    <ComboBoxItem Content="gpt-4-turbo"/>
                </ComboBox>
            </Grid>
            <Separator Margin="0,10,0,0" Background="#333333"/>
        </StackPanel>

        <!-- Chat History -->
        <ListBox x:Name="ChatHistory" Grid.Row="1" Background="#252526" BorderBrush="#3E3E42" Margin="0,0,0,10"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding AvatarColor}" CornerRadius="15" Width="30" Height="30" VerticalAlignment="Top" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Initial}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                        <Border Grid.Column="1" Background="{Binding BubbleColor}" CornerRadius="8" Padding="10">
                            <TextBlock Text="{Binding Text}" Foreground="{Binding TextColor}" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="TypingIndicator" Grid.Row="2" Text="Agent is typing..." Foreground="#808080" FontStyle="Italic" Visibility="Collapsed" Margin="0,0,0,5"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" MinHeight="50" MaxHeight="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#2D2D30" Foreground="White" BorderBrush="#3E3E42" 
                     Padding="5" VerticalContentAlignment="Top" KeyDown="InputBox_KeyDown"/>
            <Button x:Name="SendBtn" Grid.Column="1" Content="Send" Width="80" Margin="10,0,0,0" 
                    Background="#8A2BE2" Foreground="White" FontWeight="Bold" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
