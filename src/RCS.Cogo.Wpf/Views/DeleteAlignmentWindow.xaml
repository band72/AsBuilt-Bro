<Window x:Class="RCS.Cogo.Wpf.Views.DeleteAlignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Alignment" Height="250" Width="400"
        Background="#1E1E1E" Foreground="#D4D4D4"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="TitleBlock" Grid.Row="0" Text="Select Alignment to Delete:" FontWeight="Bold" Margin="0,0,0,10" Foreground="White" FontSize="14"/>
        
        <ListBox x:Name="ItemsListBox" Grid.Row="1" Background="#252526" Foreground="White" BorderBrush="#3E3E42" 
                 DisplayMemberPath="Name" SelectionMode="Single" Margin="0,0,0,10"/>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="DELETE" Click="DeleteButton_Click" Padding="15,5" Margin="0,0,10,0" Background="#E51400" Foreground="White" FontWeight="Bold"/>
            <Button Grid.Column="2" Content="CANCEL" Click="CancelButton_Click" Padding="15,5" Background="#2D2D30" Foreground="White"/>
        </Grid>
    </Grid>
</Window>
