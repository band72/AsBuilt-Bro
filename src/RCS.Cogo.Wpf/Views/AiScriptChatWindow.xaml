<Window x:Class="RCS.Cogo.Wpf.Views.AiScriptChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Script Assistant" Height="580" Width="480"
        Background="{StaticResource BrBg}" Foreground="{StaticResource BrTextPrimary}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title, API key, model selector -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Welcome to AI Script Chat" FontWeight="Bold" FontSize="16"
                       Foreground="Cyan" HorizontalAlignment="Center"/>
            <TextBlock Text="Review scripts · attach a plat image to extract COGO automatically."
                       FontSize="12" Foreground="{StaticResource BrTextSecondary}" HorizontalAlignment="Center"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="API Key:" VerticalAlignment="Center"
                           Foreground="White" Margin="0,0,5,0"/>
                <TextBox x:Name="ApiKeyBox" Grid.Column="1" Height="24"
                         Background="{StaticResource BrHeader}" Foreground="White" BorderBrush="{StaticResource BrBorder}"
                         Margin="0,0,10,0"/>

                <TextBlock Grid.Column="2" Text="Model:" VerticalAlignment="Center"
                           Foreground="White" Margin="0,0,5,0"/>
                <ComboBox x:Name="ModelSelector" Grid.Column="3" Height="24"
                          Background="{StaticResource BrHeader}" Foreground="White" BorderBrush="{StaticResource BrBorder}"
                          SelectedIndex="0">
                    <ComboBoxItem Content="gemini-2.5-pro"/>
                    <ComboBoxItem Content="gemini-1.5-pro"/>
                    <ComboBoxItem Content="gemini-1.5-flash"/>
                    <ComboBoxItem Content="gpt-4o"/>
                    <ComboBoxItem Content="gpt-4-turbo"/>
                </ComboBox>
            </Grid>
            <Separator Margin="0,10,0,0" Background="{StaticResource BrCard}"/>
        </StackPanel>

        <!-- Chat History -->
        <ListBox x:Name="ChatHistory" Grid.Row="1" Background="{StaticResource BrSurface}"
                 BorderBrush="{StaticResource BrBorder}" Margin="0,0,0,6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding AvatarColor}" CornerRadius="15"
                                Width="30" Height="30" VerticalAlignment="Top" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Initial}" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold"/>
                        </Border>
                        <Border Grid.Column="1" Background="{Binding BubbleColor}"
                                CornerRadius="8" Padding="10">
                            <TextBlock Text="{Binding Text}" Foreground="{Binding TextColor}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Attached image status label (orange, shown when image is loaded) -->
        <TextBlock x:Name="AttachLabel" Grid.Row="2" Text="" Foreground="#FFA500"
                   FontStyle="Italic" FontSize="11" Margin="2,0,0,4"
                   Visibility="Collapsed"/>

        <!-- Typing indicator -->
        <TextBlock x:Name="TypingIndicator" Grid.Row="3" Text="Agent is thinking…"
                   Foreground="{StaticResource BrTextMuted}" FontStyle="Italic"
                   Visibility="Collapsed" Margin="0,0,0,5"/>

        <!-- Input row: TextBox | 📎 Plat | Send -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputBox" Grid.Column="0"
                     MinHeight="50" MaxHeight="150" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource BrHeader}" Foreground="White" BorderBrush="{StaticResource BrBorder}"
                     Padding="5" VerticalContentAlignment="Top"
                     KeyDown="InputBox_KeyDown"/>

            <!-- Attach plat image button -->
            <Button x:Name="AttachBtn" Grid.Column="1"
                    Content="📎 Plat" Width="68" Margin="6,0,0,0"
                    Background="#2D5A8E" Foreground="White" FontWeight="Bold"
                    ToolTip="Attach a .jpg / .png survey plat to extract COGO automatically"
                    Click="AttachImage_Click"/>

            <Button x:Name="SendBtn" Grid.Column="2"
                    Content="Send" Width="70" Margin="6,0,0,0"
                    Background="{StaticResource BrAccentDim}" Foreground="White" FontWeight="Bold"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
