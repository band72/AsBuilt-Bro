<Window x:Class="RCS.Cogo.Wpf.Views.AiAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Script Analyzer" Height="600" Width="800"
        Background="{StaticResource BrBg}" Foreground="White" WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource BrBg}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="AI Script Validation Report" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource BrAccent}"/>
        
        <DataGrid Grid.Row="1" ItemsSource="{Binding Results}" AutoGenerateColumns="False" 
                  IsReadOnly="True" Background="{StaticResource BrHeader}" RowBackground="{StaticResource BrBg}" AlternatingRowBackground="#252525"
                  Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3E3E42" 
                  BorderThickness="1" BorderBrush="{StaticResource BrBorder}">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
                <Style x:Key="WrapText" TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="Margin" Value="4"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ln" Binding="{Binding LineNumber}" Width="40" ElementStyle="{StaticResource WrapText}"/>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="70" ElementStyle="{StaticResource WrapText}"/>
                <DataGridTextColumn Header="Command Snippet" Binding="{Binding OriginalLine}" Width="150" ElementStyle="{StaticResource WrapText}"/>
                <DataGridTextColumn Header="AI Diagnosis" Binding="{Binding Message}" Width="250" ElementStyle="{StaticResource WrapText}"/>
                <DataGridTextColumn Header="Correction/Suggestion" Binding="{Binding SuggestedCorrection}" Width="*" ElementStyle="{StaticResource WrapText}"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Click="Close_Click" Width="100" Padding="5" Background="{StaticResource BrHeader}" Foreground="White" BorderBrush="{StaticResource BrBorder}" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
