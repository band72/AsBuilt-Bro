<Window x:Class="RCS.Cogo.Wpf.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RCS COGO Enterprise — Welcome"
        Width="780" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Primary action button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0F3460"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#16213E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Recent file row button -->
        <Style x:Key="RecentBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#252540"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Custom chrome drag -->
    <Border MouseDown="Border_MouseDown" CornerRadius="10"
            Background="#1A1A2E" BorderBrush="#0F3460" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT PANEL — logo + actions ────────────────────────────── -->
            <Border Grid.Column="0" Background="#0F3460" CornerRadius="10,0,0,10">
                <StackPanel VerticalAlignment="Top" Margin="24,32,24,0">
                    <!-- Logo -->
                    <TextBlock Text="RCS" FontSize="48" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Left"
                               FontFamily="Segoe UI Black"/>
                    <TextBlock Text="COGO Enterprise" FontSize="13"
                               Foreground="#A0C4FF" Margin="2,-6,0,24"
                               FontFamily="Segoe UI"/>

                    <TextBlock Text="GET STARTED" Foreground="#A0C4FF"
                               FontSize="10" FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               FontFamily="Segoe UI"/>

                    <Button x:Name="BtnNew" Content="＋  New Project"
                            Style="{StaticResource PrimaryBtn}"
                            Background="#E94560" Margin="0,0,0,8"
                            Click="OnNewProject"/>
                    <Button x:Name="BtnOpen" Content="📂  Open Project..."
                            Style="{StaticResource PrimaryBtn}"
                            Margin="0,0,0,8"
                            Click="OnOpenProject"/>
                    <Button x:Name="BtnImport" Content="📥  Import Field Data..."
                            Style="{StaticResource PrimaryBtn}"
                            Margin="0,0,0,24"
                            Click="OnImport"/>

                    <Separator Background="#1A3A6E" Margin="0,0,0,16"/>
                    <TextBlock Text="VERSION" Foreground="#607090" FontSize="9"
                               FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock x:Name="VersionLabel" Text="2.x.x"
                               Foreground="#607090" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- ── RIGHT PANEL — recent files ────────────────────────────── -->
            <Grid Grid.Column="1" Margin="24,32,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="Recent Projects"
                           FontSize="22" FontWeight="Bold"
                           Foreground="White" FontFamily="Segoe UI"
                           Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Text="Double-click any project to open it."
                           Foreground="#607090" FontSize="12" Margin="0,0,0,16"/>

                <!-- Recent list -->
                <ListView x:Name="RecentList" Grid.Row="2"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="RecentList_DoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Brd" Background="Transparent" CornerRadius="6"
                                                Padding="10,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Brd" Property="Background" Value="#252540"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Brd" Property="Background" Value="#0F3460"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding ProjectName}"
                                               Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FilePath}"
                                               Foreground="#607090" FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding LastOpened, StringFormat='{}{0:MMM d, yyyy}'}"
                                           Foreground="#607090" FontSize="10"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state -->
                <TextBlock x:Name="EmptyLabel" Grid.Row="2"
                           Text="No recent projects.&#x0a;Click 'New Project' or 'Open Project' to get started."
                           Foreground="#607090" FontSize="13" TextAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- Close without opening -->
                <Button Grid.Row="3" x:Name="BtnSkip"
                        Content="Skip — Open blank workspace"
                        HorizontalAlignment="Right"
                        Foreground="#607090" Background="Transparent"
                        BorderThickness="0" FontSize="11" Cursor="Hand"
                        Margin="0,12,0,0"
                        Click="OnSkip"/>
            </Grid>

            <!-- Close X -->
            <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Content="✕" Width="28" Height="28"
                    Background="Transparent" Foreground="#607090"
                    BorderThickness="0" FontSize="14" Cursor="Hand"
                    Margin="0,8,8,0" Click="OnClose"/>
        </Grid>
    </Border>
</Window>
