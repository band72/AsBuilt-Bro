                             <DataGridTextColumn Header="Pipe Class" Binding="{Binding PipeClass}" />
                             <DataGridTextColumn Header="Pipe Manufacturer" Binding="{Binding Manufacturer}" />
                             <DataGridTextColumn Header="Pipe Material" Binding="{Binding Material}" />
                             <DataGridTextColumn Header="Pipe Lining Manufacturer" Binding="{Binding LiningManufacturer}" />
                             <DataGridTextColumn Header="Pipe Lining Material" Binding="{Binding LiningMaterial}" />
                             <DataGridTextColumn Header="Measured Length (Feet)" Binding="{Binding Length}" />
                         </DataGrid.Columns>
                    </DataGrid>
                </Expander>
                <Expander Header="WW Points Along Pipe">
                    <DataGrid ItemsSource="{Binding WWPoints}" RowEditEnding="DataGrid_RowEditEnding">
