<UserControl x:Class="RCS.Cogo.Wpf.Views.AsBuilt.PointsPhaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#11111B" Padding="10,6"
                BorderBrush="#1E1E2E" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="MapMarker" Foreground="#CDD6F4" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Survey Points" FontSize="13" FontWeight="Bold"
                               Foreground="#CDD6F4" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <Separator Width="1" Background="#1E1E2E" Margin="12,0"/>
                    <Button x:Name="BtnImportCsv" Padding="10,4" Background="#154360" Foreground="#AED6F1" BorderBrush="#1A5276" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Margin="0,0,6,0" Command="{Binding ImportPointsListCommand}" ToolTip="Import standard PNEZD CSV points file">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Import" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Import CSV" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAddPoint" Padding="10,4" Background="#1C1C2E" Foreground="#CDD6F4" BorderBrush="#313244" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Margin="0,0,6,0" Click="BtnAddPoint_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Plus" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Add" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDeletePoint" Padding="10,4" Background="#1C1C2E" Foreground="#F38BA8" BorderBrush="#313244" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Margin="0,0,6,0" Click="BtnDeletePoint_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Remove" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnMergeDuplicates" Padding="10,4" Background="#1C1C2E" Foreground="#FAB387" BorderBrush="#313244" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Margin="0,0,6,0" Click="BtnMergeDuplicates_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CallMerge" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Merge Dupes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnFindDuplicates" Padding="10,4" Background="#1C1C2E" Foreground="#89DCEB" BorderBrush="#313244" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Margin="0,0,6,0" Click="BtnFindDuplicates_Click" ToolTip="Highlight points within 0.01 ft proximity">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Magnify" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Find Dupes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAutoFixDesc" Padding="10,4" Background="#1C1C2E" Foreground="#B2BEFF" BorderBrush="#313244" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Click="BtnAutoFixDesc_Click" ToolTip="Normalise descriptions to upper-case trimmed codes">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AutoFix" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Fix Descs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator Width="1" Background="#1E1E2E" Margin="12,0"/>
                    <TextBlock x:Name="TxtPointCount" Text="0 points"
                               FontSize="11" Foreground="#BAC2DE"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDupeCount" Text=""
                               FontSize="11" Foreground="#FAB387"
                               FontFamily="Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <!-- Live filter -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filter:" Foreground="#BAC2DE" FontSize="11"
                               FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtFilter" Width="160" Padding="4,3"
                             Background="#0F0F17" Foreground="#CDD6F4"
                             BorderBrush="#313244" BorderThickness="1"
                             FontFamily="Segoe UI" FontSize="11"
                             TextChanged="TxtFilter_TextChanged"
                             ToolTip="Filter by Point# or Description"/>
                </StackPanel>
            </Grid>
        </Border>


        <!-- Points DataGrid -->
        <DataGrid Grid.Row="1"
                  x:Name="PointsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserResizeColumns="True"
                  SelectionMode="Extended"
                  GridLinesVisibility="Horizontal"
                  Background="#0F0F17"
                  RowBackground="#11111B"
                  AlternatingRowBackground="#181825"
                  Foreground="#CDD6F4"
                  BorderThickness="0"
                  FontFamily="Consolas"
                  FontSize="12"
                  ColumnHeaderHeight="30"
                  RowHeight="26"
                  HorizontalScrollBarVisibility="Auto"
                  SelectionChanged="PointsGrid_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E1E2E"/>
                    <Setter Property="Foreground" Value="#BAC2DE"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="FontSize"   Value="10"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding"    Value="8,0"/>
                    <Setter Property="BorderBrush" Value="#1E1E2E"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Point #"    Binding="{Binding PointId}"   Width="70"/>
                <DataGridTextColumn Header="Northing"   Binding="{Binding Northing, StringFormat=F4}"  Width="110"/>
                <DataGridTextColumn Header="Easting"    Binding="{Binding Easting,  StringFormat=F4}"  Width="110"/>
                <DataGridTextColumn Header="Elevation"  Binding="{Binding Elevation, StringFormat=F4}" Width="100"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridCheckBoxColumn Header="Control" Binding="{Binding IsControl}" Width="65"/>
                <DataGridCheckBoxColumn Header="Orphan"  Binding="{Binding IsOrphan}"  Width="65"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
