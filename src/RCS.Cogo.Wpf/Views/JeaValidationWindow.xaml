<Window x:Class="RCS.Cogo.Wpf.Views.JeaValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JEA As-Built Pre-Export Validation" Height="620" Width="1050"
        WindowStartupLocation="CenterOwner"
        Background="#12151C" Foreground="White">

    <Window.Resources>
        <!-- Severity → color converter (inline style triggers) -->
        <Style x:Key="SeverityCell" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource BrError}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
                <Trigger Property="Text" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource BrAmber}"/>
                </Trigger>
                <Trigger Property="Text" Value="Info">
                    <Setter Property="Foreground" Value="{StaticResource BrInfo}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header summary bar -->
            <RowDefinition Height="Auto"/>  <!-- Filter bar -->
            <RowDefinition Height="*"/>     <!-- Issue grid -->
            <RowDefinition Height="Auto"/>  <!-- Action bar -->
        </Grid.RowDefinitions>

        <!-- ═══ Summary Banner ════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1A1D24" Padding="16,12" CornerRadius="5" Margin="8,8,8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock x:Name="StatusLabel"
                               Text="✔ Ready for JEA Export"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrSuccess}"/>
                    <TextBlock x:Name="SummaryLabel"
                               Text="Run validation to check your data."
                               FontSize="12" Foreground="#88AABB" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Error badge -->
                <Border Grid.Column="1" CornerRadius="20" Margin="8,0"
                        Background="#2A1520" BorderBrush="#FF5252" BorderThickness="1"
                        Padding="16,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⛔" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ErrorBadge" Text="0 Errors"
                                   Foreground="{StaticResource BrError}" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- Warning badge -->
                <Border Grid.Column="2" CornerRadius="20" Margin="0,0,8,0"
                        Background="#252015" BorderBrush="#FFD232" BorderThickness="1"
                        Padding="16,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock x:Name="WarnBadge" Text="0 Warnings"
                                   Foreground="{StaticResource BrAmber}" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- Info badge -->
                <Border Grid.Column="3" CornerRadius="20"
                        Background="#151825" BorderBrush="#56CCF2" BorderThickness="1"
                        Padding="16,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock x:Name="InfoBadge" Text="0 Info"
                                   Foreground="{StaticResource BrInfo}" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ Filter Bar ════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,4,8,4">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#88AABB"/>
            <ToggleButton x:Name="ShowErrors" IsChecked="True" Content="Errors" Padding="12,4"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged"
                          Background="#2A1520" Foreground="{StaticResource BrError}" BorderBrush="#FF5252"
                          FontWeight="Bold" Margin="0,0,4,0"/>
            <ToggleButton x:Name="ShowWarnings" IsChecked="True" Content="Warnings" Padding="12,4"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged"
                          Background="#252015" Foreground="{StaticResource BrAmber}" BorderBrush="#FFD232"
                          Margin="0,0,4,0"/>
            <ToggleButton x:Name="ShowInfo" IsChecked="True" Content="Info" Padding="12,4"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged"
                          Background="#151825" Foreground="{StaticResource BrInfo}" BorderBrush="#56CCF2"
                          Margin="0,0,16,0"/>
            <TextBlock Text="Sheet:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#88AABB"/>
            <ComboBox x:Name="SheetFilter" Width="220" Background="#1A1D24" Foreground="White"
                      SelectionChanged="OnFilterChanged" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ═══ Issue DataGrid ═══════════════════════════════════════ -->
        <DataGrid Grid.Row="2" x:Name="IssueGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#0E1117" RowBackground="#0E1117"
                  AlternatingRowBackground="#13171F"
                  BorderBrush="#1C2436" BorderThickness="1" Margin="8,0,8,4"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1A2030"
                  Foreground="{StaticResource BrTextPrimary}" SelectionMode="Single">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#151A24"/>
                    <Setter Property="Foreground" Value="#6A90B0"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="⚑" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SeverityIcon}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Severity"  Binding="{Binding Severity}" Width="75">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SeverityCell}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Sheet"     Binding="{Binding Sheet}"    Width="200"/>
                <DataGridTextColumn Header="Asset ID"  Binding="{Binding AssetId}"  Width="120"/>
                <DataGridTextColumn Header="Field"     Binding="{Binding Field}"    Width="165"/>
                <DataGridTextColumn Header="Issue"     Binding="{Binding Message}"  Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="0,2"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══ Action Bar ════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#1A1D24" Padding="8,10" Margin="8,0,8,8" CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <Button Content="▶  Run Validation" x:Name="RunBtn"
                        Width="150" Height="34" Padding="0,0"
                        Background="#1A3048" Foreground="{StaticResource BrInfo}"
                        BorderBrush="#2C4060" FontWeight="Bold"
                        Click="OnValidate" Margin="0,0,8,0"/>
                <Button Content="🗎  Export Report..." x:Name="ExportBtn"
                        Width="150" Height="34"
                        Background="#1A2820" Foreground="{StaticResource BrSuccess}"
                        BorderBrush="{StaticResource BrSuccess}" FontWeight="Bold"
                        Click="OnExportReport" Margin="0,0,8,0" IsEnabled="False"/>
                <Button Content="✔  Looks Good — Export JEA Now" x:Name="ExportJeaBtn"
                        Height="34" Padding="16,0"
                        Background="#163025" Foreground="{StaticResource BrSuccess}"
                        BorderBrush="{StaticResource BrSuccess}" FontWeight="Bold"
                        Click="OnProceedExport" IsEnabled="False"/>

                <TextBlock x:Name="CountLabel" Text="0 issues shown"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="#556677" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
