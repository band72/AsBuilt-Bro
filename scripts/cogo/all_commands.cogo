// Comprehensive Test Script for RCS COGO - Version 2
// Tests: NE, NEZ, STN, BS, BD, AZ, DIST, ANG, AZAZ, BB, LNLN, Figures, MapCheck, DEL, HELP, CLEAR

// 0. Initial Clear
CLEAR

// 1. Establish Control
NE 100 5000.0000 5000.0000 "Start Point"
NE 200 6000.0000 6000.0000 "Reference Point"
NEZ 300 7000.0000 5000.0000 100.00 "Elevation Point"

STN 100
BS 200

// 2. Test Point Creation
BD 101 1 45.0000 500.00 "BD Point 1"
BD 102 2 45.0000 500.00 "BD Point 2"

// 3. Test Info Commands
AZ 100 200
DIST 100 200
ANG 200 100 300

// 4. Test Intersections
AZAZ 103 100 0.0000 200 270.0000 "Intersection AZAZ"
BB 104 100 1 45.0000 102 4 45.0000 "Intersection BB"
LNLN 105 100 200 10.0 101 102 0.0 "Offset Intersection"

// 5. Figure and MapCheck
BEG TEST_FIG
CONT 100
CONT 101
CONT 103
END
MAPCHECK TEST_FIG

// 6. Test Deletion
DEL 300
// Info "Point 300 deleted."

// 7. Verify List
// STN 300 (Should fail if used, or just checking INV)
// INV 100 300 (Error: Point 300 not found)

// 8. Help
HELP

// 9. Save
// SAVE all_test_v2.cogo
