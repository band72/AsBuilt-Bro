<Application x:Class="RCS.Cogo.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RCS.Cogo.Wpf"
             StartupUri="Views/ShellWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ── Master design system — must be first ── -->
                <ResourceDictionary Source="pack://application:,,,/RCS.Cogo.Wpf;component/Resources/RcsTheme.xaml"/>
                <!-- ── Symbol icon library ── -->
                <ResourceDictionary Source="pack://application:,,,/RCS.Cogo.Wpf;component/Resources/Symbols.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Symbol image data templates (used in ViewPort + SymbolManager) -->
            <DataTemplate x:Key="ImageSymbolTemplateString">
                <Image Source="{Binding}" Width="28" Height="28" Stretch="Uniform"/>
            </DataTemplate>
            <DataTemplate x:Key="ImageSymbolTemplateEntity">
                <Image Source="{Binding Symbol}" Width="28" Height="28" Stretch="Uniform"/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
