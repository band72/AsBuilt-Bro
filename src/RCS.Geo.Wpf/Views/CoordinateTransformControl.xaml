<UserControl x:Class="RCS.Geo.Wpf.Views.CoordinateTransformControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RCS.Geo.Wpf.Views"
             xmlns:vm="clr-namespace:RCS.Geo.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance vm:CoordinateTransformViewModel}">
    <Border BorderBrush="#333" BorderThickness="1" CornerRadius="4" Padding="12" Background="#1E1E1E" TextElement.Foreground="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="State Plane to Lat/Lon Projection" FontSize="16" FontWeight="Bold"/>

            <!-- Source CRS -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Select Source Zone:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,5" Padding="5" 
                      ItemsSource="{Binding AvailableCrs}" 
                      DisplayMemberPath="DisplayName" 
                      SelectedItem="{Binding SelectedSourceCrs}" />

            <!-- Input Easting -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Input Easting:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,5" Padding="4" Text="{Binding InputEasting, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Input Northing -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Input Northing:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,5" Padding="4" Text="{Binding InputNorthing, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Outputs -->
            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,15,0,0">
                <TextBlock Text="Converted Geographic Coordinates (WGS84 Lat/Lon):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                
                <Grid Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Decimal Degrees" Foreground="#7A7A9A" FontSize="10" Margin="0,0,4,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="DMS" Foreground="#7A7A9A" FontSize="10" Margin="0,0,0,2"/>

                    <!-- Latitude -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Latitude:" VerticalAlignment="Center" Margin="0,2"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,2,4,2" IsReadOnly="True"
                               Background="#333" Foreground="#98C379" Text="{Binding OutputLatitude}"/>
                    <TextBox   Grid.Row="1" Grid.Column="2" Margin="0,2" IsReadOnly="True"
                               Background="#333" Foreground="#98C379" Text="{Binding OutputLatitudeDms}"/>

                    <!-- Longitude -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Longitude:" VerticalAlignment="Center" Margin="0,2"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,2,4,2" IsReadOnly="True"
                               Background="#333" Foreground="#61AFEF" Text="{Binding OutputLongitude}"/>
                    <TextBox   Grid.Row="3" Grid.Column="2" Margin="0,2" IsReadOnly="True"
                               Background="#333" Foreground="#61AFEF" Text="{Binding OutputLongitudeDms}"/>
                </Grid>

                <!-- Copy button + error -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                               Foreground="#E06C75" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="📋  Copy to Clipboard"
                            Command="{Binding CopyToClipboardCommand}"
                            Padding="10,6" Margin="8,0,0,0"
                            Background="#2D4A3E" Foreground="#98C379"
                            BorderBrush="#3E6B5A" BorderThickness="1"
                            FontFamily="Segoe UI" FontSize="11"
                            ToolTip="Copy Lat / Lon and DMS to clipboard"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
