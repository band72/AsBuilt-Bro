<Window x:Class="RCS.Cogo.Wpf.Views.InvertCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invert Calculator" Height="640" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBand}">
            <TextBlock Text="📐  Invert Calculator"
                       VerticalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextPrimary}"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,14">

                <!-- Part lookup -->
                <TextBlock Style="{StaticResource TbSection}" Text="SPECIFICATION LOOKUP"/>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPartNumber"
                                 Text="{Binding PartNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Load Specs" Click="LoadSpecs_Click"
                                Style="{StaticResource BtnPrimary}" Width="90"/>
                    </Grid>
                </Border>

                <!-- Measurements -->
                <TextBlock Style="{StaticResource TbSection}" Text="PIPE MEASUREMENTS"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="TOP OUTSIDE WALL ELEVATION"/>
                        <TextBox x:Name="TxtTopElev"
                                 Text="{Binding TopOutsideWallElev, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:F3\}}"
                                 Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="OUTER DIAMETER (OD)"/>
                                <TextBox x:Name="TxtOuterDia"
                                         Text="{Binding OuterDiameter, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:F3\}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="NOMINAL DIAMETER"/>
                                <TextBox x:Name="TxtNominalDia"
                                         Text="{Binding NominalDiameter, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:F3\}}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="WALL THICKNESS (TOP)"/>
                        <TextBox x:Name="TxtThickness"
                                 Text="{Binding OuterWallThicknessTop, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:F3\}}"
                                 Margin="0,0,0,10"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="INNER DIAMETER"/>
                        <TextBox x:Name="TxtInnerDia"
                                 Text="{Binding InnerDiameter, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:F3\}}"
                                 Margin="0,0,0,10"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="DEFLECTION (optional)"/>
                        <TextBox x:Name="TxtDeflection"
                                 Text="{Binding Deflection, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:F3\}}"
                                 Margin="0,0,0,10"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="PART NOTE"/>
                        <TextBox x:Name="TxtNote"
                                 Text="{Binding PartNote, UpdateSourceTrigger=PropertyChanged}"
                                 Height="44" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </Border>

                <!-- Result -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="COMPUTED INVERT"
                                   Foreground="{StaticResource BrAccent}"/>
                        <TextBlock x:Name="TxtResult"
                                   Text="{Binding EstimatedInvert, Mode=OneWay, StringFormat=\{0:F3\}}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource BrSuccess}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource WindowFooterBand}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click"
                        Style="{StaticResource BtnGhost}" Width="90" Margin="0,0,8,0"/>
                <Button Content="Apply &amp; Save" Click="Apply_Click"
                        Style="{StaticResource BtnPrimary}" Width="130"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
