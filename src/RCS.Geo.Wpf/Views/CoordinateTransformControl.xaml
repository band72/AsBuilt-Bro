<UserControl x:Class="RCS.Geo.Wpf.Views.CoordinateTransformControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:RCS.Geo.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="430"
             d:DataContext="{d:DesignInstance vm:CoordinateTransformViewModel}">

    <Border BorderBrush="#2A2A45" BorderThickness="1" CornerRadius="6"
            Background="#13132A" TextElement.Foreground="#D4D4F0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,14,14,18" >

                <!-- ─── Header ──────────────────────────────────────────── -->
                <TextBlock Text="🌐  GPS Coordinate Transform"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#A0B4FF" Margin="0,0,0,10"/>

                <!-- ─── Direction toggle ─────────────────────────────────── -->
                <Border Background="#1D1D3A" CornerRadius="6"
                        BorderBrush="#2E2E55" BorderThickness="1" Padding="8,6" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding DirectionLabel}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#C8D8FF" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="⇄  Flip"
                                Command="{Binding FlipDirectionCommand}"
                                Padding="10,5" FontSize="11"
                                Background="#252545" Foreground="#A0B4FF"
                                BorderBrush="#3A3A65" BorderThickness="1"
                                Cursor="Hand" ToolTip="Toggle direction: State Plane ↔ Lat/Lon"/>
                    </Grid>
                </Border>

                <!-- ─── Zone selector ──────────────────────────────────── -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Zone:" VerticalAlignment="Center"
                               Foreground="#9090B0" FontSize="11"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableCrs}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedSourceCrs}"
                              Background="#1D1D3A" Foreground="#D4D4F0"
                              BorderBrush="#2E2E55" Padding="6,4" FontSize="11"/>
                </Grid>

                <!-- ─── Input 1 ───────────────────────────────────────── -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding InputLabel1}"
                               VerticalAlignment="Center" Foreground="#9090B0" FontSize="11"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding Input1, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1A1A30" Foreground="#E0E8FF"
                             BorderBrush="#2E2E55" Padding="6,4"
                             FontFamily="Consolas" FontSize="12"
                             ToolTip="Enter Easting (State Plane) or Latitude (decimal or DMS)"/>
                </Grid>

                <!-- ─── Input 2 ───────────────────────────────────────── -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding InputLabel2}"
                               VerticalAlignment="Center" Foreground="#9090B0" FontSize="11"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding Input2, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1A1A30" Foreground="#E0E8FF"
                             BorderBrush="#2E2E55" Padding="6,4"
                             FontFamily="Consolas" FontSize="12"
                             ToolTip="Enter Northing (State Plane) or Longitude (decimal or DMS)"/>
                </Grid>

                <!-- ─── Outputs ──────────────────────────────────────── -->
                <Border Background="#0F1728" CornerRadius="5"
                        BorderBrush="#1F2E50" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Column headers -->
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="Decimal" Foreground="#556080" FontSize="10" Margin="0,0,4,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="DMS" Foreground="#556080" FontSize="10" Margin="0,0,0,2"/>

                        <!-- Output 1 -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding OutputLabel1}"
                                   FontSize="11" Foreground="#8090B0" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox   Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Output1}" IsReadOnly="True"
                                   Background="#1A2535" Foreground="#98C379"
                                   BorderBrush="#1F2E50" Padding="4,2" FontSize="11" Margin="0,2,4,2"/>
                        <TextBox   Grid.Row="1" Grid.Column="2"
                                   Text="{Binding Output1Dms}" IsReadOnly="True"
                                   Background="#1A2535" Foreground="#98C379"
                                   BorderBrush="#1F2E50" Padding="4,2" FontSize="11" Margin="0,2"/>

                        <!-- Output 2 -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="{Binding OutputLabel2}"
                                   FontSize="11" Foreground="#8090B0" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox   Grid.Row="3" Grid.Column="1"
                                   Text="{Binding Output2}" IsReadOnly="True"
                                   Background="#1A2535" Foreground="#61AFEF"
                                   BorderBrush="#1F2E50" Padding="4,2" FontSize="11" Margin="0,2,4,2"/>
                        <TextBox   Grid.Row="3" Grid.Column="2"
                                   Text="{Binding Output2Dms}" IsReadOnly="True"
                                   Background="#1A2535" Foreground="#61AFEF"
                                   BorderBrush="#1F2E50" Padding="4,2" FontSize="11" Margin="0,2"/>
                    </Grid>
                </Border>

                <!-- ─── Error / status ────────────────────────────────── -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#E06C75" TextWrapping="Wrap"
                           FontSize="11" Margin="0,0,0,4"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#98C379" TextWrapping="Wrap"
                           FontSize="11" Margin="0,0,0,8"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}"/>

                <!-- ─── Single-point clipboard copy ───────────────────── -->
                <Button Content="📋  Copy Result to Clipboard"
                        Command="{Binding CopyToClipboardCommand}"
                        HorizontalAlignment="Right"
                        Padding="12,6" Margin="0,0,0,10"
                        Background="#1D2E3E" Foreground="#98C379"
                        BorderBrush="#2E6B5A" BorderThickness="1" FontSize="11"
                        ToolTip="Copy decimal + DMS result to clipboard"/>

                <!-- ─── Separator ─────────────────────────────────────── -->
                <Separator Background="#2A2A45" Margin="0,4,0,10"/>

                <!-- ─── Bulk Apply ────────────────────────────────────── -->
                <Border Background="#1A2A1A" CornerRadius="5"
                        BorderBrush="#2A4A2A" BorderThickness="1"
                        Padding="10,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="🔁  Bulk Transform — Drawing Points"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#90C090" Margin="0,0,0,6"/>
                        <TextBlock Text="Applies the selected zone and direction to ALL PointRows in the active job."
                                   FontSize="10" Foreground="#607060"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="⚡  Apply to All Points"
                                Command="{Binding BulkApplyCommand}"
                                Padding="12,7" FontSize="11"
                                Background="#1E3E1E" Foreground="#98C379"
                                BorderBrush="#3A6A3A" BorderThickness="1"
                                HorizontalAlignment="Stretch"
                                ToolTip="Transform every PointRow Northing/Easting using the selected zone"/>
                    </StackPanel>
                </Border>

                <!-- ─── GPS CSV Import / Export ───────────────────────── -->
                <Border Background="#1A1A2E" CornerRadius="5"
                        BorderBrush="#2A2A50" BorderThickness="1"
                        Padding="10,8" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="📂  GPS File Import / Export"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#90A0D0" Margin="0,0,0,6"/>

                        <!-- Import -->
                        <Button Content="📥  Import GPS CSV / TXT"
                                Command="{Binding ImportGpsCsvCommand}"
                                Padding="12,7" FontSize="11" Margin="0,0,0,6"
                                Background="#1D1D3A" Foreground="#C8D4FF"
                                BorderBrush="#3A3A65" BorderThickness="1"
                                HorizontalAlignment="Stretch"
                                ToolTip="Import a CSV or TXT file with Lat,Lon columns and add points to the drawing"/>

                        <!-- Export full CSV -->
                        <Button Content="📤  Export Full GPS CSV"
                                Command="{Binding ExportGpsCsvCommand}"
                                Padding="12,7" FontSize="11" Margin="0,0,0,6"
                                Background="#1D1D3A" Foreground="#C8D4FF"
                                BorderBrush="#3A3A65" BorderThickness="1"
                                HorizontalAlignment="Stretch"
                                ToolTip="Export all drawing points with Northing, Easting, Latitude, Longitude, DMS, and Description"/>

                        <!-- Export compact TXT -->
                        <Button Content="📄  Export Compact Lat/Lon TXT"
                                Command="{Binding ExportLatLonTxtCommand}"
                                Padding="12,7" FontSize="11"
                                Background="#1D1D3A" Foreground="#C8D4FF"
                                BorderBrush="#3A3A65" BorderThickness="1"
                                HorizontalAlignment="Stretch"
                                ToolTip="Export a compact Pt,Lat,Lon,Desc TXT file for GPS units or GIS tools"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
