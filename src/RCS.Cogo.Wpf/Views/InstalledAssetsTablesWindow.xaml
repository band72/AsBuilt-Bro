<Window x:Class="RCS.Cogo.Wpf.Views.InstalledAssetsTablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installed Assets Tables" Height="650" Width="1300"
        Background="#0D1B2A" Foreground="#E0F7FA"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Shared header style for column headers -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#003344"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#005577"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0A1520"/>
            <Setter Property="RowBackground" Value="#0D1B2A"/>
            <Setter Property="AlternatingRowBackground" Value="#0A1520"/>
            <Setter Property="Foreground" Value="#B2EBF2"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1A3A4A"/>
            <Setter Property="VerticalGridLinesBrush" Value="#1A3A4A"/>
            <Setter Property="BorderBrush" Value="#005577"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Full"/>
            <Setter Property="RowHeight" Value="22"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#004D60"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#0D2030"/>
            <Setter Property="Foreground" Value="#80DEEA"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="BorderBrush" Value="#005577"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#003344"/>
                    <Setter Property="Foreground" Value="#00E5FF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- ╔═══════════════════ HEADER BANNER ═══════════════════════╗ -->
        <Border Grid.Row="0" Background="#001825" BorderBrush="#00E5FF" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="JEA INSTALLED ASSETS — FIELD TABLE REPORTS"
                               FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                               Foreground="#00E5FF"/>
                    <TextBlock x:Name="TxtProjectLabel" Text="No project loaded"
                               FontFamily="Segoe UI" FontSize="11" Foreground="#80DEEA"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnExportCsv" Content="📐 Export Tab → DXF"
                            Click="BtnExportCsv_Click"
                            Padding="12,6" Margin="0,0,10,0"
                            Background="#003344" Foreground="#00E5FF"
                            BorderBrush="#00E5FF" BorderThickness="1"
                            FontFamily="Segoe UI" FontWeight="Bold" FontSize="11"
                            Cursor="Hand"/>
                    <Button x:Name="BtnRefresh" Content="↻ Refresh"
                            Click="BtnRefresh_Click"
                            Padding="12,6"
                            Background="#002030" Foreground="#80DEEA"
                            BorderBrush="#005577" BorderThickness="1"
                            FontFamily="Segoe UI" FontSize="11"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ╔═══════════════════ RECORD COUNTS ═══════════════════════╗ -->
        <Border Grid.Row="1" Background="#001020" Padding="15,4">
            <TextBlock x:Name="TxtCounts" Text="Loading…"
                       FontFamily="Consolas" FontSize="10" Foreground="#546E7A"/>
        </Border>

        <!-- ╔═══════════════════ TAB CONTROL ═══════════════════════╗ -->
        <TabControl x:Name="MainTabs" Grid.Row="2"
                    Background="#0D1B2A" BorderBrush="#005577" BorderThickness="1">

            <!-- ══════════════ TAB 1: FORCE MAIN FITTING ══════════════ -->
            <TabItem Header="Force Main Fittings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#002030" BorderBrush="#00E5FF" BorderThickness="0,0,0,1">
                        <TextBlock Text="FORCE MAIN FITTING LOCATION TABLE"
                                   FontFamily="Consolas" FontWeight="Bold" FontSize="11"
                                   Foreground="#00E5FF" VerticalAlignment="Center" Margin="10,0"/>
                    </Border>
                    <DataGrid x:Name="GridForceFittings" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NO." Binding="{Binding No}" Width="40"/>
                            <DataGridTextColumn Header="FITTING&#10;DESCRIPTION" Binding="{Binding Subtype}" Width="120"/>
                            <DataGridTextColumn Header="FACILITY&#10;OWNER" Binding="{Binding FacilityOwner}" Width="80"/>
                            <DataGridTextColumn Header="FITTING SIZE&#10;PRIMARY (INCH)" Binding="{Binding Size}" Width="85"/>
                            <DataGridTextColumn Header="FITTING SIZE&#10;SECONDARY (INCH)" Binding="{Binding SizeSecondary}" Width="95"/>
                            <DataGridTextColumn Header="FITTING TYPE" Binding="{Binding FeatureType}" Width="110"/>
                            <DataGridTextColumn Header="MANUFACTURER" Binding="{Binding Manufacturer}" Width="110"/>
                            <DataGridTextColumn Header="FITTING&#10;MATERIAL" Binding="{Binding Material}" Width="80"/>
                            <DataGridTextColumn Header="LINING&#10;MATERIAL" Binding="{Binding LiningMaterial}" Width="80"/>
                            <DataGridTextColumn Header="TOP FITTING&#10;ELEVATION (FEET)" Binding="{Binding TopElevation, StringFormat=F2}" Width="95"/>
                            <DataGridTextColumn Header="FINISH&#10;GRADE" Binding="{Binding GradeElevation, StringFormat=F2}" Width="65"/>
                            <DataGridTextColumn Header="DEPTH&#10;(FEET)" Binding="{Binding Depth, StringFormat=F2}" Width="60"/>
                            <DataGridTextColumn Header="EASTING" Binding="{Binding Easting, StringFormat=F2}" Width="90"/>
                            <DataGridTextColumn Header="NORTHING" Binding="{Binding Northing, StringFormat=F2}" Width="90"/>
                            <DataGridTextColumn Header="LATITUDE&#10;(DECIMAL DEGREE)" Binding="{Binding Latitude, StringFormat=F6}" Width="110"/>
                            <DataGridTextColumn Header="LONGITUDE&#10;(DECIMAL DEGREES)" Binding="{Binding Longitude, StringFormat=F6}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══════════════ TAB 2: SANITARY MANHOLES ══════════════ -->
            <TabItem Header="Sanitary Manholes">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#002030" BorderBrush="#00E5FF" BorderThickness="0,0,0,1">
                        <TextBlock Text="SANITARY MANHOLES"
                                   FontFamily="Consolas" FontWeight="Bold" FontSize="11"
                                   Foreground="#00E5FF" VerticalAlignment="Center" Margin="10,0"/>
                    </Border>
                    <DataGrid x:Name="GridManholes" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NO." Binding="{Binding No}" Width="40"/>
                            <DataGridTextColumn Header="MANHOLE&#10;SUBTYPE" Binding="{Binding Subtype}" Width="100"/>
                            <DataGridTextColumn Header="FACILITY&#10;OWNER" Binding="{Binding FacilityOwner}" Width="80"/>
                            <DataGridTextColumn Header="MANHOLE&#10;TYPE" Binding="{Binding ManholeType}" Width="100"/>
                            <DataGridTextColumn Header="MANHOLE&#10;DROP TYPE" Binding="{Binding DropType}" Width="90"/>
                            <DataGridTextColumn Header="MANUFACTURER&#10;OR SUPPLIER" Binding="{Binding Manufacturer}" Width="120"/>
                            <DataGridTextColumn Header="MANHOLE&#10;SIZE" Binding="{Binding Size}" Width="80"/>
                            <DataGridTextColumn Header="MANHOLE LINING&#10;MATERIAL" Binding="{Binding LiningMaterial}" Width="110"/>
                            <DataGridTextColumn Header="RIM&#10;ELEVATION" Binding="{Binding RimElevation, StringFormat=F2}" Width="80"/>
                            <DataGridTextColumn Header="INVERT ELEVATIONS&#10;&amp; DIRECTIONS" Binding="{Binding InvertElevationsWithDirections}" Width="140"/>
                            <DataGridTextColumn Header="NORTHING" Binding="{Binding Northing, StringFormat=F2}" Width="90"/>
                            <DataGridTextColumn Header="EASTING" Binding="{Binding Easting, StringFormat=F2}" Width="90"/>
                            <DataGridTextColumn Header="LATITUDE" Binding="{Binding Latitude, StringFormat=F6}" Width="95"/>
                            <DataGridTextColumn Header="LONGITUDE" Binding="{Binding Longitude, StringFormat=F6}" Width="105"/>
                            <DataGridTextColumn Header="EXTERIOR JOINT TAPE&#10;TYPE &amp; MANUFACTURER" Binding="{Binding ExteriorJointTape}" Width="150"/>
                            <DataGridTextColumn Header="RFID / BARCODE&#10;NUMBER" Binding="{Binding RfidBarcode}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══════════════ TAB 3: WATER MAIN FITTINGS ══════════════ -->
            <TabItem Header="Water Main Fittings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#002030" BorderBrush="#00E5FF" BorderThickness="0,0,0,1">
                        <TextBlock Text="WATER MAIN FITTING LOCATION TABLE"
                                   FontFamily="Consolas" FontWeight="Bold" FontSize="11"
                                   Foreground="#00E5FF" VerticalAlignment="Center" Margin="10,0"/>
                    </Border>
                    <DataGrid x:Name="GridWaterFittings" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NO." Binding="{Binding No}" Width="40"/>
                            <DataGridTextColumn Header="FITTING&#10;DESCRIPTION" Binding="{Binding Subtype}" Width="120"/>
                            <DataGridTextColumn Header="FACILITY&#10;OWNER" Binding="{Binding FacilityOwner}" Width="80"/>
                            <DataGridTextColumn Header="FITTING SIZE&#10;PRIMARY (INCH)" Binding="{Binding Size}" Width="85"/>
                            <DataGridTextColumn Header="FITTING SIZE&#10;SECONDARY (INCH)" Binding="{Binding SizeSecondary}" Width="95"/>
                            <DataGridTextColumn Header="FITTING TYPE" Binding="{Binding FeatureType}" Width="110"/>
                            <DataGridTextColumn Header="MANUFACTURER" Binding="{Binding Manufacturer}" Width="110"/>
                            <DataGridTextColumn Header="FITTING&#10;MATERIAL" Binding="{Binding Material}" Width="80"/>
                            <DataGridTextColumn Header="LINING&#10;MATERIAL" Binding="{Binding LiningMaterial}" Width="80"/>
                            <DataGridTextColumn Header="TOP FITTING&#10;ELEVATION (FEET)" Binding="{Binding TopElevation, StringFormat=F2}" Width="95"/>
                            <DataGridTextColumn Header="FINISH&#10;GRADE" Binding="{Binding GradeElevation, StringFormat=F2}" Width="65"/>
                            <DataGridTextColumn Header="DEPTH&#10;(FEET)" Binding="{Binding Depth, StringFormat=F2}" Width="60"/>
                            <DataGridTextColumn Header="EASTING" Binding="{Binding Easting, StringFormat=F2}" Width="90"/>
                            <DataGridTextColumn Header="NORTHING" Binding="{Binding Northing, StringFormat=F2}" Width="90"/>
                            <DataGridTextColumn Header="LATITUDE&#10;(DECIMAL DEGREE)" Binding="{Binding Latitude, StringFormat=F6}" Width="110"/>
                            <DataGridTextColumn Header="LONGITUDE&#10;(DECIMAL DEGREES)" Binding="{Binding Longitude, StringFormat=F6}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══════════════ TAB 4: WATER VALVE DETAIL ══════════════ -->
            <TabItem Header="Water Valve Detail">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#002030" BorderBrush="#00E5FF" BorderThickness="0,0,0,1">
                        <TextBlock Text="WATER VALVE DETAIL TABLE"
                                   FontFamily="Consolas" FontWeight="Bold" FontSize="11"
                                   Foreground="#00E5FF" VerticalAlignment="Center" Margin="10,0"/>
                    </Border>
                    <DataGrid x:Name="GridWaterValves" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NO." Binding="{Binding No}" Width="40"/>
                            <DataGridTextColumn Header="VALVE TYPE" Binding="{Binding Subtype}" Width="100"/>
                            <DataGridTextColumn Header="FACILITY&#10;OWNER" Binding="{Binding FacilityOwner}" Width="80"/>
                            <DataGridTextColumn Header="VALVE SIZE&#10;(INCH)" Binding="{Binding Size}" Width="75"/>
                            <DataGridTextColumn Header="DIRECTION&#10;TO OPEN" Binding="{Binding OpenDirection}" Width="85"/>
                            <DataGridTextColumn Header="NO. TURNS&#10;TO OPEN" Binding="{Binding TurnsToOpen, StringFormat=F1}" Width="80"/>
                            <DataGridTextColumn Header="TOP NUT" Binding="{Binding NutElevation, StringFormat=F2}" Width="70"/>
                            <DataGridTextColumn Header="FINISH&#10;GRADE" Binding="{Binding GradeElevation, StringFormat=F2}" Width="65"/>
                            <DataGridTextColumn Header="DEPTH&#10;TO NUT" Binding="{Binding DepthToNut, StringFormat=F2}" Width="70"/>
                            <DataGridTextColumn Header="MANUFACTURER" Binding="{Binding Manufacturer}" Width="120"/>
                            <DataGridTextColumn Header="NORTHING /&#10;LATITUDE" Binding="{Binding Northing, StringFormat=F2}" Width="90"/>
                            <DataGridTextColumn Header="EASTING /&#10;LONGITUDE" Binding="{Binding Easting, StringFormat=F2}" Width="90"/>
                            <DataGridTextColumn Header="LATITUDE&#10;(DECIMAL DEGREES)" Binding="{Binding Latitude, StringFormat=F6}" Width="115"/>
                            <DataGridTextColumn Header="LONGITUDE&#10;(DECIMAL DEGREES)" Binding="{Binding Longitude, StringFormat=F6}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══════════════ TAB 5: HYDRANT ══════════════ -->
            <TabItem Header="Hydrant Table">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#002030" BorderBrush="#00E5FF" BorderThickness="0,0,0,1">
                        <TextBlock Text="HYDRANT TABLE"
                                   FontFamily="Consolas" FontWeight="Bold" FontSize="11"
                                   Foreground="#00E5FF" VerticalAlignment="Center" Margin="10,0"/>
                    </Border>
                    <DataGrid x:Name="GridWaterHydrants" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NO." Binding="{Binding No}" Width="40"/>
                            <DataGridTextColumn Header="HYDRANT&#10;SUBTYPE" Binding="{Binding Subtype}" Width="120"/>
                            <DataGridTextColumn Header="FACILITY&#10;OWNER" Binding="{Binding FacilityOwner}" Width="90"/>
                            <DataGridTextColumn Header="YEAR&#10;MANUFACTURED" Binding="{Binding YearManufactured}" Width="95"/>
                            <DataGridTextColumn Header="MANUFACTURER" Binding="{Binding Manufacturer}" Width="130"/>
                            <DataGridTextColumn Header="EASTING" Binding="{Binding Easting, StringFormat=F2}" Width="100"/>
                            <DataGridTextColumn Header="NORTHING" Binding="{Binding Northing, StringFormat=F2}" Width="100"/>
                            <DataGridTextColumn Header="LATITUDE&#10;(DECIMAL DEGREES)" Binding="{Binding Latitude, StringFormat=F6}" Width="130"/>
                            <DataGridTextColumn Header="LONGITUDE" Binding="{Binding Longitude, StringFormat=F6}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══════════════ TAB 6: WATER SERVICES ══════════════ -->
            <TabItem Header="Water Services">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#002030" BorderBrush="#00E5FF" BorderThickness="0,0,0,1">
                        <TextBlock Text="WATER SERVICES"
                                   FontFamily="Consolas" FontWeight="Bold" FontSize="11"
                                   Foreground="#00E5FF" VerticalAlignment="Center" Margin="10,0"/>
                    </Border>
                    <DataGrid x:Name="GridWaterServices" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NO." Binding="{Binding No}" Width="40"/>
                            <DataGridTextColumn Header="SERVICE&#10;TYPE" Binding="{Binding Subtype}" Width="110"/>
                            <DataGridTextColumn Header="METER BOX&#10;SUBTYPE" Binding="{Binding FeatureType}" Width="110"/>
                            <DataGridTextColumn Header="FACILITY&#10;OWNER" Binding="{Binding FacilityOwner}" Width="90"/>
                            <DataGridTextColumn Header="METER BOX&#10;MANUFACTURER" Binding="{Binding Manufacturer}" Width="130"/>
                            <DataGridTextColumn Header="METER BOX&#10;MATERIAL" Binding="{Binding Material}" Width="100"/>
                            <DataGridTextColumn Header="NORTHING&#10;LATITUDE" Binding="{Binding Northing, StringFormat=F2}" Width="100"/>
                            <DataGridTextColumn Header="EASTING&#10;LONGITUDE" Binding="{Binding Easting, StringFormat=F2}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══════════════ TAB 7: LOCATE WIRE BOX ══════════════ -->
            <TabItem Header="Locate Wire Boxes">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#002030" BorderBrush="#00E5FF" BorderThickness="0,0,0,1">
                        <TextBlock Text="LOCATE WIRE BOX TABLE"
                                   FontFamily="Consolas" FontWeight="Bold" FontSize="11"
                                   Foreground="#00E5FF" VerticalAlignment="Center" Margin="10,0"/>
                    </Border>
                    <DataGrid x:Name="GridLocateBoxes" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NO." Binding="{Binding No}" Width="40"/>
                            <DataGridTextColumn Header="LOCATE BOX&#10;SUBTYPE" Binding="{Binding Subtype}" Width="160"/>
                            <DataGridTextColumn Header="NORTHING" Binding="{Binding Northing, StringFormat=F2}" Width="110"/>
                            <DataGridTextColumn Header="EASTING" Binding="{Binding Easting, StringFormat=F2}" Width="110"/>
                            <DataGridTextColumn Header="LATITUDE" Binding="{Binding Latitude, StringFormat=F6}" Width="130"/>
                            <DataGridTextColumn Header="LONGITUDE" Binding="{Binding Longitude, StringFormat=F6}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ╔═══════════════════ STATUS BAR ═══════════════════════╗ -->
        <Border Grid.Row="3" Background="#001020" BorderBrush="#005577" BorderThickness="0,1,0,0"
                Padding="15,0">
            <TextBlock x:Name="TxtStatus" Text="Ready"
                       FontFamily="Consolas" FontSize="10" Foreground="#546E7A"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
