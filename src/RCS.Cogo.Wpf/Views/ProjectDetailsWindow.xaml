<Window x:Class="RCS.Cogo.Wpf.Views.ProjectDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Details" Height="660" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        MinWidth="520" MinHeight="500">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ───────────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBand}">
            <TextBlock Text="📁  Project Details"
                       VerticalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextPrimary}"/>
        </Border>

        <!-- ── Form ─────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,0">
            <StackPanel>

                <TextBlock Style="{StaticResource FieldLabel}" Text="PROJECT NAME  (Required)"/>
                <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="AVAILABILITY NUMBER (AvailNo)"/>
                <TextBox Text="{Binding AvailNo, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="UTILITY TYPE"/>
                        <ComboBox SelectedItem="{Binding Utility}" ItemsSource="{Binding UtilityTypes}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="UNITS"/>
                        <ComboBox SelectedItem="{Binding Units}" ItemsSource="{Binding UnitTypes}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource FieldLabel}" Text="REVISION"/>
                <TextBox Text="{Binding Revision, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="SAVE LOCATION  (auto-generates folder)"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SaveLocation, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="…" Height="32"
                            Click="BrowseFolder_Click"
                            Style="{StaticResource BtnGhost}"
                            FontSize="16"/>
                </Grid>

                <!-- Deliverables -->
                <TextBlock Style="{StaticResource TbSection}" Text="DELIVERABLES CHECKLIST"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Content="Certification Report (PDF)"
                                  IsChecked="{Binding Settings.RequirePdfReport}"
                                  Margin="0,0,0,6"/>
                        <CheckBox Content="LandXML Export"
                                  IsChecked="{Binding Settings.RequireLandXml}"
                                  Margin="0,0,0,6"/>
                        <CheckBox Content="CSV Point Export"
                                  IsChecked="{Binding Settings.RequireCsv}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer ───────────────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource WindowFooterBand}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save Details" IsDefault="True" Click="Save_Click"
                        Style="{StaticResource BtnPrimary}"
                        Width="120" Margin="0,0,10,0"/>
                <Button Content="Cancel" IsCancel="True"
                        Style="{StaticResource BtnGhost}"
                        Width="90"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
