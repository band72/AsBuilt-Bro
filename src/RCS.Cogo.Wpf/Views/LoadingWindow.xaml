<Window x:Class="RCS.Cogo.Wpf.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loading…" Height="140" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="False">

    <Border Background="{StaticResource BrSurface}"
            BorderBrush="{StaticResource BrBorder}"
            BorderThickness="1">
        <StackPanel VerticalAlignment="Center" Margin="28,20">
            <TextBlock x:Name="TxtMessage"
                       Text="Loading Project Data — Please Wait…"
                       HorizontalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextPrimary}"
                       Margin="0,0,0,16"/>
            <ProgressBar IsIndeterminate="True" Height="5" Margin="0"/>
        </StackPanel>
    </Border>
</Window>
