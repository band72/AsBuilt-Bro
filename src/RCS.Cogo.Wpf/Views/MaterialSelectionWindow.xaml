<Window x:Class="RCS.Cogo.Wpf.Views.MaterialSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Material" Height="500" Width="860"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Grid Background="{StaticResource BrBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBand}">
            <TextBlock Text="📦  Schedule of Materials"
                       VerticalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextPrimary}"/>
        </Border>

        <!-- Search bar -->
        <Border Grid.Row="1" Background="{StaticResource BrSurface}"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Search:" VerticalAlignment="Center"
                           Foreground="{StaticResource BrTextSecondary}"
                           Margin="0,0,10,0"/>
                <TextBox x:Name="SearchBox" Width="240"
                         TextChanged="SearchBox_TextChanged"/>
            </StackPanel>
        </Border>

        <!-- Grid -->
        <DataGrid x:Name="MaterialsGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Margin="10,6,10,0"
                  MouseDoubleClick="MaterialsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Part Key"     Binding="{Binding PartKey}"     Width="*"/>
                <DataGridTextColumn Header="Discipline"   Binding="{Binding Discipline}"   Width="100"/>
                <DataGridTextColumn Header="Feature Type" Binding="{Binding FeatureType}"  Width="100"/>
                <DataGridTextColumn Header="Size"         Binding="{Binding Size}"         Width="70"/>
                <DataGridTextColumn Header="Material"     Binding="{Binding Material}"     Width="80"/>
                <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="120"/>
                <DataGridTextColumn Header="Model"        Binding="{Binding Model}"        Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource WindowFooterBand}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click"
                        Style="{StaticResource BtnGhost}" Width="90" Margin="0,0,8,0"/>
                <Button Content="Select" Click="Select_Click"
                        Style="{StaticResource BtnPrimary}" Width="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
