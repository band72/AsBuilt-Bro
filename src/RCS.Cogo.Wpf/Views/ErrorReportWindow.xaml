<Window x:Class="RCS.Cogo.Wpf.Views.ErrorReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report an Issue" Height="400" Width="500"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Bug Report / Error Submission" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <TextBlock Grid.Row="1" Text="Severity:" Margin="0,5,0,0"/>
        <ComboBox x:Name="CmbSeverity" Grid.Row="1" Margin="60,5,0,5" Width="150" HorizontalAlignment="Left" Background="#2D2D30" Foreground="White">
            <ComboBoxItem Content="Low"/>
            <ComboBoxItem Content="Medium" IsSelected="True"/>
            <ComboBoxItem Content="High"/>
            <ComboBoxItem Content="Critical"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Text="Describe what you were doing and the error message:" Margin="0,15,0,5"/>
        <TextBox x:Name="TxtDescription" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" Background="#2D2D30" Foreground="White" BorderBrush="#3E3E42" Padding="5"/>

        <Grid Grid.Row="4" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" Grid.Column="0" Foreground="LightGreen" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Cancel" Width="80" Padding="5,5" Margin="0,0,10,0" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="BtnCancel_Click"/>
            <Button Grid.Column="2" x:Name="BtnSubmit" Content="Submit Report" Width="120" Padding="5,5" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSubmit_Click"/>
        </Grid>
    </Grid>
</Window>
