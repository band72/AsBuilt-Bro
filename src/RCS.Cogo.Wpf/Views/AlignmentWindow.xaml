<Window x:Class="RCS.Cogo.Wpf.Views.AlignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alignment Editor" Height="720" Width="1100"
        WindowStartupLocation="CenterOwner" Background="#1A1D24" Foreground="White">
    <Grid Background="{StaticResource BrBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT PANEL ═══ -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Alignment Editor" FontWeight="Bold" FontSize="16"
                       Foreground="{StaticResource BrInfo}" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Alignment:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#B0C4DE"/>
                <TextBox x:Name="AlignmentNameBox" Width="140" Background="#252D3C" Foreground="White"
                         Padding="4,2" Margin="0,0,8,0" BorderBrush="#3A4A60"/>
                <Button Content="Save HA" Padding="10,3" Background="#1A3048" Foreground="{StaticResource BrInfo}"
                        BorderBrush="#3A4A60" Click="OnSaveHa" ToolTip="Save Horizontal Alignment"/>
                <Button Content="Save VA" Padding="10,3" Background="#1A3048" Foreground="{StaticResource BrAmber}"
                        BorderBrush="#3A4A60" Margin="4,0,0,0" Click="OnSaveVa" ToolTip="Save Vertical Alignment"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Design Points" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#B0C4DE"/>

            <DataGrid Grid.Row="3" ItemsSource="{Binding Points}"
                      AutoGenerateColumns="False"
                      BorderThickness="1" BorderBrush="#2C3E54"
                      Background="#14181F" RowBackground="#14181F"
                      AlternatingRowBackground="#1A2030" Foreground="{StaticResource BrTextPrimary}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#252D3C"
                      ColumnHeaderHeight="28">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1C2430"/>
                        <Setter Property="Foreground" Value="#6A90B0"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Pt #"     Binding="{Binding Id}"                    Width="50"/>
                    <DataGridTextColumn Header="Northing" Binding="{Binding Northing, StringFormat=F3}" Width="*"/>
                    <DataGridTextColumn Header="Easting"  Binding="{Binding Easting,  StringFormat=F3}" Width="*"/>
                    <DataGridTextColumn Header="Elev"     Binding="{Binding Elevation, StringFormat=F3}" Width="70"/>
                    <DataGridTextColumn Header="Desc"     Binding="{Binding Description}"            Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#2C3E54"/>

        <!-- ═══ RIGHT PANEL: Plan (top) + Profile (bottom) ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="150"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="220" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- ── Plan View ── -->
            <Border Grid.Row="0" Background="#0D1117" Margin="5,5,5,0" CornerRadius="5" ClipToBounds="True">
                <Grid Background="Transparent"
                      MouseWheel="OnMouseWheel"
                      MouseRightButtonDown="OnMouseRightButtonDown"
                      MouseRightButtonUp="OnMouseRightButtonUp"
                      MouseLeftButtonDown="OnMouseLeftButtonDown"
                      MouseLeftButtonUp="OnMouseLeftButtonUp"
                      MouseMove="OnMouseMove">

                    <Canvas x:Name="ViewportCanvas">
                        <Canvas.RenderTransform>
                            <MatrixTransform x:Name="WorldTransform"/>
                        </Canvas.RenderTransform>
                        <ItemsControl ItemsSource="{Binding Figures}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Polyline Points="{Binding Points}" Stroke="{Binding Stroke}"
                                              StrokeLineJoin="Round"
                                              StrokeThickness="{Binding DataContext.LineMarkerScale,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>

                    <!-- Zoom rectangle -->
                    <Rectangle x:Name="ZoomRect" Stroke="LightBlue" StrokeThickness="1"
                               Fill="#33ADD8E6" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Visibility="Collapsed" IsHitTestVisible="False"/>

                    <!-- PLAN label -->
                    <TextBlock Text="PLAN VIEW" Foreground="#22446A" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4"
                               IsHitTestVisible="False"/>

                    <!-- Scale text -->
                    <TextBlock Text="{Binding CurrentViewScale, StringFormat='Scale: {0:F4}x'}"
                               Foreground="#66FFFFFF" FontSize="11" Margin="8"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>

                    <!-- Zoom buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                        <Button Command="{Binding ZoomWindowCommand}" Content="WIN" Width="38" Height="28"
                                Background="#1C2430" Foreground="White" FontSize="10" Margin="0,0,4,0"
                                ToolTip="Zoom Window"/>
                        <Button Command="{Binding ZoomInCommand}"  Content="+"  Width="28" Height="28"
                                Background="#1C2430" Foreground="White" FontSize="16" Margin="0,0,4,0"/>
                        <Button Command="{Binding ZoomOutCommand}" Content="-"  Width="28" Height="28"
                                Background="#1C2430" Foreground="White" FontSize="16" Margin="0,0,4,0"/>
                        <Button Command="{Binding ZoomExtentsCommand}" Content="[ ]" Width="28" Height="28"
                                Background="#1C2430" Foreground="White" FontSize="10"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Horizontal Splitter ── -->
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#2C3E54" Margin="5,0"/>

            <!-- ── Profile View ── -->
            <Border Grid.Row="2" Background="#0A0D12" Margin="5,0,5,5" CornerRadius="5" ClipToBounds="True">
                <Grid>
                    <!-- Profile Canvas (drawn from code-behind on render) -->
                    <Canvas x:Name="ProfileCanvas" SizeChanged="OnProfileCanvasSizeChanged"
                            Background="Transparent"/>

                    <!-- PROFILE label -->
                    <TextBlock Text="PROFILE VIEW  (EG = blue  |  FG = yellow  |  grade labels between VPIs)"
                               Foreground="#22446A" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4"
                               IsHitTestVisible="False"/>

                    <!-- Refresh button -->
                    <Button Content="⟳ Refresh Profile" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,4,8,0" Padding="8,3" Background="#1A3048" Foreground="{StaticResource BrInfo}"
                            BorderBrush="#2C3E54" FontSize="10" Click="OnRefreshProfile"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
