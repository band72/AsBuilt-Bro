<UserControl x:Class="RCS.Cogo.Wpf.Views.InstalledAssetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:RCS.Cogo.Wpf.Views"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="800">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Installed Assets Data" FontWeight="Bold" Foreground="#D4D4D4" Margin="10,10,10,4" FontSize="16"/>

        <!-- ── Quick-Filter bar ────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AssetsFilterBox"
                     Grid.Column="0"
                     Background="#252526" Foreground="#D4D4D4"
                     BorderBrush="#555" Padding="5,3"
                     FontSize="12"
                     TextChanged="AssetsFilterBox_TextChanged"
                     ToolTip="Filter by section name (e.g. Water, Manhole, Valve)"/>
            <Button Grid.Column="1"
                    Content="✕" Width="28" Height="22"
                    Margin="4,0,0,0"
                    Background="#3E3E42" Foreground="#D4D4D4"
                    BorderThickness="0" FontSize="11" Cursor="Hand"
                    Click="ClearAssetsFilter_Click"
                    ToolTip="Clear filter"/>
        </Grid>
        
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                         <Setter Property="Foreground" Value="#D4D4D4"/>
                         <Setter Property="BorderBrush" Value="#3E3E42"/>
                         <Setter Property="Background" Value="#252526"/>
                         <Setter Property="IsExpanded" Value="False"/>
                         <Setter Property="Margin" Value="0,1"/>
                    </Style>
                    <Style TargetType="DataGrid">
                        <EventSetter Event="MouseDoubleClick" Handler="DataGrid_MouseDoubleClick"/>
                        <EventSetter Event="SelectionChanged" Handler="DataGrid_SelectionChanged"/>
                        <Setter Property="MaxHeight" Value="300"/>
                        <Setter Property="Background" Value="#252526"/>
                        <Setter Property="RowBackground" Value="#252526"/>
                        <Setter Property="Foreground" Value="#D4D4D4"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="AutoGenerateColumns" Value="False"/>
                        <Setter Property="CanUserAddRows" Value="True"/>
                        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                        <Setter Property="ColumnWidth" Value="Auto"/>
                    </Style>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#3E3E42"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </StackPanel.Resources>

                <!-- Figure Assets -->
                <Expander Header="Figure Assets">
                    <DataGrid ItemsSource="{Binding FigureAssets}" RowEditEnding="DataGrid_RowEditEnding">
                         <DataGrid.Columns>
                             <DataGridTextColumn Header="PartKey" Binding="{Binding PartKey}"/>
                             <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
                             <DataGridTextColumn Header="Subtype" Binding="{Binding Subtype}"/>
                             <DataGridTextColumn Header="Discipline" Binding="{Binding Discipline}"/>
                             <DataGridTextColumn Header="FeatureType" Binding="{Binding FeatureType}"/>
                             <DataGridTextColumn Header="Material" Binding="{Binding Material}"/>
                             <DataGridTextColumn Header="Size" Binding="{Binding Size}"/>
                             <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}"/>
                             <DataGridTextColumn Header="Model" Binding="{Binding ManufacturerPartNo}"/>
                             <DataGridTextColumn Header="Year" Binding="{Binding YearManufactured}"/>
                             <DataGridTextColumn Header="Facility Owner" Binding="{Binding FacilityOwner}"/>
                             <DataGridTextColumn Header="Layer" Binding="{Binding Layer}"/>
                             <DataGridTextColumn Header="Description" Binding="{Binding DescriptionText}"/>
                             <DataGridTextColumn Header="Script Content" Binding="{Binding ScriptContent}" Visibility="Collapsed"/>
                         </DataGrid.Columns>
                    </DataGrid>
                </Expander>
                
                <!-- Pipe Crossing -->
                <Expander Header="Pipe Crossing">
                    <DataGrid ItemsSource="{Binding PipeCrossings}" RowEditEnding="DataGrid_RowEditEnding">
                         <DataGrid.Columns>
                             <DataGridTextColumn Header="Crossing Number" Binding="{Binding CrossingNumber}" />
                             <DataGridTextColumn Header="Upper Pipe Type" Binding="{Binding UpperPipeType}" />
                             <DataGridTextColumn Header="Upper Pipe Size (Inches)" Binding="{Binding UpperPipeSize}" />
                             <DataGridTextColumn Header="Finished Grade Elevation (Feet)" Binding="{Binding GradeElevation}" />
                             <DataGridTextColumn Header="Upper Pipe Top Elevation (Feet)" Binding="{Binding UpperPipeTopElevation}" />
                             <DataGridTextColumn Header="Cover to Top of Upper Pipe (Feet)" Binding="{Binding UpperCover}" />
                             <DataGridTextColumn Header="Upper Pipe Bottom Elevation (Feet)" Binding="{Binding UpperPipeBottomElevation}" />
                             <DataGridTextColumn Header="Lower Pipe Type" Binding="{Binding LowerPipeType}" />
                             <DataGridTextColumn Header="Lower Pipe Size (Inches)" Binding="{Binding LowerPipeSize}" />
                             <DataGridTextColumn Header="Lower Pipe Top Elevation (Feet)" Binding="{Binding LowerPipeTopElevation}" />
                             <DataGridTextColumn Header="Cover to Top of Lower Pipe (Feet)" Binding="{Binding LowerCover}" />
                             <DataGridTextColumn Header="Separation Between Pipes (Feet)" Binding="{Binding Separation}" />
                             <DataGridTextColumn Header="X Coord (State Plane Easting Feet)" Binding="{Binding Easting}" />
                             <DataGridTextColumn Header="Y Coord (State Plane Northing Feet)" Binding="{Binding Northing}" />
                             <DataGridTextColumn Header="Latitude (Decimal Degrees)" Binding="{Binding Latitude}" />
                             <DataGridTextColumn Header="Longitude (Decimal Degrees)" Binding="{Binding Longitude}" />
                         </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <!-- Water Section -->
                <StackPanel Orientation="Horizontal" Margin="10,5">
                    <TextBlock Text="W" Foreground="CornflowerBlue" FontWeight="Bold" Margin="0,0,5,0"/>
                    <TextBlock Text="Water" FontWeight="Bold" Foreground="White" />
                </StackPanel>
                
                <Expander Header="Water Pipe Run">
                    <DataGrid ItemsSource="{Binding WaterPipes}" RowEditEnding="DataGrid_RowEditEnding">
