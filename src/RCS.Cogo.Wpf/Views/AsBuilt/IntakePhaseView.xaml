<UserControl x:Class="RCS.Cogo.Wpf.Views.AsBuilt.IntakePhaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,12">
        <StackPanel>
            <!-- ── Header ─────────────────────────────────────── -->
            <TextBlock Text="📥  Import Field / Design Data"
                       FontSize="15" FontWeight="Bold"
                       Foreground="#CDD6F4" FontFamily="Segoe UI"
                       Margin="0,0,0,16"/>

            <!-- ── Import cards ──────────────────────────────── -->
            <!-- PNEZD / CSV -->
            <Border Background="#181825" CornerRadius="8"
                    BorderBrush="#1E1E2E" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PNEZD / CSV Point File"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#CDD6F4" FontFamily="Segoe UI"/>
                        <TextBlock Text="Point#, Northing, Easting, Elevation, Description"
                                   FontSize="11" Foreground="#BAC2DE"
                                   FontFamily="Segoe UI" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Command="{Binding DataContext.ImportPointsListCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="12,6"
                            Background="#1C1C2E" Foreground="#CDD6F4"
                            BorderBrush="#313244" BorderThickness="1"
                            FontFamily="Segoe UI" FontSize="11"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- COGO Script -->
            <Border Background="#181825" CornerRadius="8"
                    BorderBrush="#1E1E2E" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="COGO Script (.cogo / .txt)"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#CDD6F4" FontFamily="Segoe UI"/>
                        <TextBlock Text="ST / BD / PIPE commands — full batch script"
                                   FontSize="11" Foreground="#BAC2DE"
                                   FontFamily="Segoe UI" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Command="{Binding DataContext.ImportBatchCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="12,6"
                            Background="#1C1C2E" Foreground="#CDD6F4"
                            BorderBrush="#313244" BorderThickness="1"
                            FontFamily="Segoe UI" FontSize="11"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- JEA Excel Template -->
            <Border Background="#181825" CornerRadius="8"
                    BorderBrush="#1E1E2E" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="🏛  JEA As-Built Template (.xlsx)"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#89DCEB" FontFamily="Segoe UI"/>
                        <TextBlock Text="Import filled JEA Excel as-built form"
                                   FontSize="11" Foreground="#BAC2DE"
                                   FontFamily="Segoe UI" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Command="{Binding DataContext.ImportJeaTemplateCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="12,6"
                            Background="#1C1C2E" Foreground="#89DCEB"
                            BorderBrush="#313244" BorderThickness="1"
                            FontFamily="Segoe UI" FontSize="11"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- DXF Linework -->
            <Border Background="#181825" CornerRadius="8"
                    BorderBrush="#1E1E2E" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Import DXF Linework"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#CDD6F4" FontFamily="Segoe UI"/>
                        <TextBlock Text="Read polylines from existing CAD drawing"
                                   FontSize="11" Foreground="#BAC2DE"
                                   FontFamily="Segoe UI" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Command="{Binding DataContext.ImportDxfCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="12,6"
                            Background="#1C1C2E" Foreground="#CDD6F4"
                            BorderBrush="#313244" BorderThickness="1"
                            FontFamily="Segoe UI" FontSize="11"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- AI Blueprint Scan -->
            <Border Background="#1A1525" CornerRadius="8"
                    BorderBrush="#6C3483" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="🤖" FontSize="14" Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="AI Blueprint Scanner  (Gemini Vision)"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#C39BDA" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Drop a PDF / PNG scan — AI extracts structures &amp; pipe runs automatically"
                                   FontSize="11" Foreground="#9B59B6"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Scan…"
                            Command="{Binding DataContext.ImportBlueprintCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="12,6"
                            Background="#2C1840" Foreground="#C39BDA"
                            BorderBrush="#6C3483" BorderThickness="1"
                            FontFamily="Segoe UI" FontSize="11"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Project meta ──────────────────────────────── -->
            <Rectangle Fill="#1E1E2E" Height="1" Margin="0,16,0,12"/>
            <TextBlock Text="PROJECT IDENTITY"
                       FontSize="9" FontWeight="SemiBold"
                       Foreground="#BAC2DE" FontFamily="Segoe UI"
                       Margin="0,0,0,10"/>

            <!-- Job Number -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Job Number"
                           FontSize="12" Foreground="#BAC2DE"
                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Job.Identity.JobNumber, UpdateSourceTrigger=PropertyChanged}"
                         Background="#11111B" Foreground="#CDD6F4"
                         BorderBrush="#313244" BorderThickness="1"
                         FontFamily="Segoe UI" FontSize="12" Padding="6,4"/>
            </Grid>

            <!-- Contractor -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Contractor"
                           FontSize="12" Foreground="#BAC2DE"
                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Job.Identity.Contractor, UpdateSourceTrigger=PropertyChanged}"
                         Background="#11111B" Foreground="#CDD6F4"
                         BorderBrush="#313244" BorderThickness="1"
                         FontFamily="Segoe UI" FontSize="12" Padding="6,4"/>
            </Grid>

            <!-- Description -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Description"
                           FontSize="12" Foreground="#BAC2DE"
                           FontFamily="Segoe UI" VerticalAlignment="Top"
                           Margin="0,4,0,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Job.Identity.Description, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="60"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="#11111B" Foreground="#CDD6F4"
                         BorderBrush="#313244" BorderThickness="1"
                         FontFamily="Segoe UI" FontSize="12" Padding="6,4"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
