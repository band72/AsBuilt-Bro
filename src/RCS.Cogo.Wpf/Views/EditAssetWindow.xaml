<Window x:Class="RCS.Cogo.Wpf.Views.EditAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="Edit Installed Asset" Height="800" Width="600"
        Background="{StaticResource BrBg}" Foreground="{StaticResource BrTextPrimary}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- BoolToVis converter is global — defined in RcsTheme.xaml -->
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Edit Asset Record" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="PartKey:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" Text="{Binding PartKey}" IsReadOnly="False" Background="#333" Foreground="White" Padding="5"/>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource BrBorder}" BorderThickness="1" CornerRadius="4" Margin="0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <!-- Dynamic form rows -->
                    <StackPanel>
                        <TextBlock Text="Discipline:" Margin="0,5,0,0"/>
                        <ComboBox Text="{Binding Discipline}" ItemsSource="{Binding DisciplineList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Feature Type:" Margin="0,5,0,0"/>
                        <TextBox Text="{Binding FeatureType}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Size:" Margin="0,5,0,0"/>
                        <ComboBox Text="{Binding Size}" ItemsSource="{Binding PipeSizeList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Material:" Margin="0,5,0,0"/>
                        <ComboBox Text="{Binding Material}" ItemsSource="{Binding MaterialsList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5"/>
                    </StackPanel>

                    <!-- Core Added JEA Common Fields -->
                    <StackPanel>
                        <TextBlock Text="Subtype:" Margin="0,5,0,0"/>
                        <ComboBox Text="{Binding Subtype}" ItemsSource="{Binding SubtypesList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Facility Owner:" Margin="0,5,0,0"/>
                        <ComboBox Text="{Binding FacilityOwner}" ItemsSource="{Binding FacilityOwnersList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Size Secondary:" Margin="0,5,0,0"/>
                        <TextBox Text="{Binding SizeSecondary}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Pipe Class:" Margin="0,5,0,0"/>
                        <ComboBox Text="{Binding PipeClass}" ItemsSource="{Binding PipeClassList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Lining Manufacturer:" Margin="0,5,0,0"/>
                        <ComboBox Text="{Binding LiningManufacturer}" ItemsSource="{Binding LiningManufacturerList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Lining Material:" Margin="0,5,0,0"/>
                        <ComboBox Text="{Binding LiningMaterial}" ItemsSource="{Binding LiningMaterialList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Orientation:" Margin="0,5,0,0"/>
                        <ComboBox Text="{Binding Orientation}" ItemsSource="{Binding OrientationsList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Pipe Type:" Margin="0,5,0,0"/>
                        <ComboBox Text="{Binding PipeRole}" ItemsSource="{Binding PipeRoleList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Drop Type:" Margin="0,5,0,0"/>
                        <ComboBox Text="{Binding DropType}" ItemsSource="{Binding DropTypeList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Invert Elevations w/ Directions:" Margin="0,5,0,0"/>
                        <TextBox Text="{Binding InvertElevationsWithDirections}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                    </StackPanel>
                    
                    <StackPanel>
                        <TextBlock Text="Tape Type:" Margin="0,5,0,0"/>
                        <ComboBox Text="{Binding ExteriorJointTapeType}" ItemsSource="{Binding TapeTypeList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5"/>
                    </StackPanel>
                    
                    <StackPanel>
                        <TextBlock Text="Exterior Joint Tape Mfr:" Margin="0,5,0,0"/>
                        <ComboBox Text="{Binding ExteriorJointTapeManufacturer}" ItemsSource="{Binding ExteriorJointTapeManufacturerList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5"/>
                    </StackPanel>

                    <!-- Point Geometry (Structures, Valves, Meters, etc) -->
                    <Grid Margin="0,5,0,0" Visibility="{Binding Path=IsPointGeometry, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Northing:"/>
                            <TextBox Text="{Binding Northing, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                            <TextBlock Text="Easting:"/>
                            <TextBox Text="{Binding Easting, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="5,0,0,0">
                            <TextBlock Text="Top/Grade Elev:"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding TopElevation, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5" Margin="0,0,2,0"/>
                                <TextBox Grid.Column="1" Text="{Binding GradeElevation, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5" Margin="2,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Line Geometry (Pipes) -->
                    <Grid Margin="0,15,0,0" Visibility="{Binding Path=IsPipe, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Upstream Invert:"/>
                            <TextBox Text="{Binding UpstreamInvert, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                            <TextBlock Text="Upstream Grade:"/>
                            <TextBox Text="{Binding UpstreamGrade, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="5,0,0,0">
                            <TextBlock Text="Length / Slope:"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Length, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5" Margin="0,0,2,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Slope, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5" Margin="2,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,5,0,0" Visibility="{Binding Path=IsPipe, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Downstream Invert:"/>
                            <TextBox Text="{Binding DownstreamInvert, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                            <TextBlock Text="Downstream Grade:"/>
                            <TextBox Text="{Binding DownstreamGrade, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="5,0,0,0">
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,5,0,0" Visibility="{Binding Path=IsPointGeometry, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Quantity:"/>
                        <TextBox Text="{Binding Quantity}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                    </StackPanel>

                    <!-- Pipe Crossing Geometry -->
                    <StackPanel Visibility="{Binding Path=IsPipeCrossing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Crossing Specific Info" FontWeight="Bold" Foreground="LimeGreen" Margin="0,15,0,5"/>

                        <StackPanel Margin="0,5,0,0">
                            <TextBlock Text="Crossing Number:"/>
                            <TextBox Text="{Binding CrossingNumber}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                        </StackPanel>
                        
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Upper Pipe Type:"/>
                                <TextBox Text="{Binding UpperPipeType}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Lower Pipe Type:"/>
                                <TextBox Text="{Binding LowerPipeType}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Upper Pipe Size:"/>
                                <TextBox Text="{Binding UpperPipeSize}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Lower Pipe Size:"/>
                                <TextBox Text="{Binding LowerPipeSize}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,5,0,0">
                            <TextBlock Text="Finished Grade Elevation (Feet):"/>
                            <TextBox Text="{Binding GradeElevation, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                        </StackPanel>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Upper Pipe Top Elev:"/>
                                <TextBox Text="{Binding UpperPipeTopElevation, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Lower Pipe Top Elev:"/>
                                <TextBox Text="{Binding LowerPipeTopElevation, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Cover to Top of Upper Pipe:"/>
                                <TextBox Text="{Binding UpperCover, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Cover to Top of Lower Pipe:"/>
                                <TextBox Text="{Binding LowerCover, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Upper Pipe Bottom Elev:"/>
                                <TextBox Text="{Binding UpperPipeBottomElevation, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Separation Between Pipes:"/>
                                <TextBox Text="{Binding Separation, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Northing:"/>
                                <TextBox Text="{Binding Northing, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Easting:"/>
                                <TextBox Text="{Binding Easting, StringFormat=\{0:F3\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Latitude:"/>
                                <TextBox Text="{Binding Latitude, StringFormat=\{0:F6\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Longitude:"/>
                                <TextBox Text="{Binding Longitude, StringFormat=\{0:F6\}}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Manufacturer info -->
                    <StackPanel Margin="0,15,0,0">
                        <TextBlock Text="Manufacturer:" FontWeight="Bold" Foreground="CornflowerBlue"/>
                        <ComboBox Text="{Binding Manufacturer}" ItemsSource="{Binding ManufacturerList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,5,0,0">
                        <TextBlock Text="Model / Part No:"/>
                        <ComboBox Text="{Binding ManufacturerPartNo}" ItemsSource="{Binding HydrantModelList, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" Background="White" Foreground="Black" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,5,0,0">
                        <TextBlock Text="Year Manufactured:"/>
                        <TextBox Text="{Binding YearManufactured}" Background="{StaticResource BrSurface}" Foreground="White" Padding="5"/>
                    </StackPanel>
                    <!-- Figure Vertices (Figures) -->
                    <Grid Margin="0,15,0,0" Visibility="{Binding Path=IsFigure, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Figure Vertices:" FontWeight="Bold" Foreground="{StaticResource BrAccent}" Margin="0,0,0,5"/>
                            <DataGrid ItemsSource="{Binding Path=FigureVertices, RelativeSource={RelativeSource AncestorType=Window}}" 
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="200"
                                      Background="{StaticResource BrSurface}" RowBackground="{StaticResource BrSurface}" Foreground="{StaticResource BrTextPrimary}" BorderThickness="1" BorderBrush="{StaticResource BrBorder}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Order" Binding="{Binding OrderIndex}" IsReadOnly="True" Width="50"/>
                                    <DataGridTextColumn Header="Point ID" Binding="{Binding PointId}" IsReadOnly="True" Width="80"/>
                                    <DataGridTextColumn Header="Northing" Binding="{Binding Point.Northing, StringFormat=\{0:F3\}}" Width="100"/>
                                    <DataGridTextColumn Header="Easting" Binding="{Binding Point.Easting, StringFormat=\{0:F3\}}" Width="100"/>
                                    <DataGridTextColumn Header="Bulge" Binding="{Binding Bulge, StringFormat=\{0:F4\}}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <TextBlock x:Name="MsgTxt" Grid.Row="3" Foreground="LightGreen" Margin="0,0,0,10"/>
        
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Materials" Click="Materials_Click" Padding="10,5" Margin="0,0,10,0" Background="{StaticResource BrHeader}" Foreground="White"/>
                <Button Content="Universal" Click="Universal_Click" Padding="10,5" Margin="0,0,10,0" Background="{StaticResource BrHeader}" ToolTip="Apply these metadata settings to all other records in the current grid" Foreground="White"/>
                <Button Content="Delete" Click="Delete_Click" Padding="10,5" Margin="0,0,10,0" Background="{StaticResource BrHeader}" Foreground="White"/>
                <Button Content="Cancel" Click="Cancel_Click" Padding="10,5" Margin="0,0,10,0" Background="{StaticResource BrHeader}" Foreground="White"/>
                <Button Content="Save" Click="Save_Click" Padding="10,5" Background="{StaticResource BrHeader}" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
