<Window x:Class="RCS.Cogo.Wpf.Views.ReportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Configuration" Height="450" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#D4D4D4">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Exel Export Configuration" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                <GroupBox Header="Water">
                    <StackPanel>
                        <CheckBox Content="Export Water Data" IsChecked="{Binding ExportWater}"/>
                        <TextBlock Text="Sheet Name:"/>
                        <TextBox Text="{Binding WaterSheetName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Sewer (Sanitary)">
                    <StackPanel>
                        <CheckBox Content="Export Sewer Data" IsChecked="{Binding ExportSewer}"/>
                        <TextBlock Text="Sheet Name:"/>
                        <TextBox Text="{Binding SewerSheetName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Storm Drain">
                    <StackPanel>
                        <CheckBox Content="Export Storm Data" IsChecked="{Binding ExportStorm}"/>
                        <TextBlock Text="Sheet Name:"/>
                        <TextBox Text="{Binding StormSheetName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Gas">
                    <StackPanel>
                        <CheckBox Content="Export Gas Data" IsChecked="{Binding ExportGas}"/>
                        <TextBlock Text="Sheet Name:"/>
                        <TextBox Text="{Binding GasSheetName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>
                
                <GroupBox Header="General" Margin="0,10,0,0">
                    <StackPanel>
                        <CheckBox Content="Include Null Values" IsChecked="{Binding IncludeNullValues}"/>
                        
                        <TextBlock Text="Bearing Format" FontWeight="Bold" Margin="0,10,0,5"/>
                        <RadioButton Content="DMS (Degrees Minutes Seconds)" IsChecked="{Binding IsDMS}" GroupName="BearingFormat" Margin="0,2" Foreground="#D4D4D4"/>
                        <RadioButton Content="DD (Decimal Degrees)" IsChecked="{Binding IsDD}" GroupName="BearingFormat" Margin="0,2" Foreground="#D4D4D4"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save Settings" IsDefault="True" Click="Save_Click" Width="100" Margin="0,0,10,0" Background="#007ACC" Foreground="White" BorderThickness="0" Padding="5"/>
            <Button Content="Cancel" IsCancel="True" Width="80" Background="#3E3E42" Foreground="White" BorderThickness="0" Padding="5"/>
        </StackPanel>
    </Grid>
</Window>
