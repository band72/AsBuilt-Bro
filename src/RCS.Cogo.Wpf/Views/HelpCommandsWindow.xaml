<Window x:Class="RCS.Cogo.Wpf.Views.HelpCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COGO Command Reference" Height="500" Width="700"
        Background="{StaticResource BrBg}" Foreground="{StaticResource BrTextPrimary}"
        WindowStartupLocation="CenterOwner">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="COGO Command Reference" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="White" HorizontalAlignment="Center"/>
        
        <TextBox Grid.Row="1" x:Name="SearchBox" TextChanged="SearchBox_TextChanged" 
                 Background="{StaticResource BrCard}" Foreground="White" BorderBrush="#555555" 
                 Padding="8" Margin="0,0,0,10" Height="30" Width="300" HorizontalAlignment="Right"
                 ToolTip="Search commands..."/>
        <TextBlock Grid.Row="1" Text="🔍 Search:" Foreground="{StaticResource BrTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,310,10"/>
        
        <DataGrid Grid.Row="2" x:Name="CommandsGrid" ItemsSource="{Binding FilteredCommands}" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Command" Binding="{Binding Name}" Width="150" FontWeight="Bold">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#4DA6FF"/>
                            <Setter Property="FontFamily" Value="{StaticResource FfMono}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Description / Usage" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <Button Grid.Row="3" Content="Close" Click="CloseButton_Click" Width="100" Height="30" Margin="0,15,0,0"
                HorizontalAlignment="Right" Background="{StaticResource BrBorder}" Foreground="White" BorderThickness="0"/>
    </Grid>
</Window>
