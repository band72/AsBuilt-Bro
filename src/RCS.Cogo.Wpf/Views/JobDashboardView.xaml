<UserControl x:Class="RCS.Cogo.Wpf.Views.JobDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RCS.Cogo.Wpf.ViewModels">

    <Grid Background="{StaticResource BrBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header banner -->
            <RowDefinition Height="*"/>      <!-- Content area -->
            <RowDefinition Height="Auto"/>   <!-- Version footer -->
        </Grid.RowDefinitions>

        <!-- ── Header Banner ────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource BrHeaderGradient}"
                BorderBrush="{StaticResource BrAccent}"
                BorderThickness="0,0,0,2"
                Padding="40,28">
            <StackPanel>
                <TextBlock Text="RCS COGO ENTERPRISE"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrAccent}"
                           Margin="0,0,0,6"/>

                <TextBlock Text="As-Built Production Workspace"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrTextPrimary}"/>
                <TextBlock Text="Job-centered · Survey-grade · Deliverable-ready"
                           FontSize="12"
                           Foreground="{StaticResource BrTextMuted}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── Main Content ──────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>  <!-- Action panel -->
                    <ColumnDefinition Width="32"/>   <!-- Gap -->
                    <ColumnDefinition Width="*"/>    <!-- Recent jobs -->
                </Grid.ColumnDefinitions>

                <!-- ── Left: Action Buttons ─────────────────────────────────── -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="GET STARTED"
                               Style="{StaticResource TbSection}"
                               Margin="0,0,0,14"/>

                    <!-- New Job -->
                    <Button Command="{Binding NewJobCommand}"
                            Height="52"
                            Margin="0,0,0,10"
                            Style="{StaticResource BtnPrimary}"
                            ToolTip="Create a new as-built job with guided wizard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="New Job" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Start guided wizard" FontSize="10" Foreground="#AACCFF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Open Existing -->
                    <Button Command="{Binding OpenJobCommand}"
                            Height="44"
                            Margin="0,0,0,8"
                            ToolTip="Open a saved .rcsj job file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Open Existing Job" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Import Data -->
                    <Button Command="{Binding ImportDataCommand}"
                            Height="44"
                            Margin="0,0,0,8"
                            ToolTip="Import PNEZD, DXF, LandXML, or pipe data directly">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Import Field / Design Data" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Templates -->
                    <Button Command="{Binding TemplatesCommand}"
                            Height="44"
                            Style="{StaticResource BtnGhost}"
                            Margin="0,0,0,24"
                            ToolTip="Browse project templates and standards">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Templates / Standards" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Pending issues warning -->
                    <Border Visibility="{Binding HasPendingIssues, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource ChipWarn}"
                            Padding="12,8"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="⚠ Pending Issues"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrAmber}"
                                       FontSize="11"/>
                            <TextBlock Text="{Binding PendingSummary}"
                                       Foreground="{StaticResource BrTextSecondary}"
                                       FontSize="10"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Right: Recent Jobs ───────────────────────────────────── -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="RECENT JOBS"
                               Style="{StaticResource TbSection}"
                               Margin="0,0,0,14"/>

                    <!-- Empty state -->
                    <Border Visibility="{Binding NoRecentJobs, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource Card}"
                            Padding="24,20">
                        <TextBlock Text="No recent jobs. Create your first job to get started."
                                   Foreground="{StaticResource BrTextMuted}"
                                   FontStyle="Italic"/>
                    </Border>

                    <!-- Job cards -->
                    <ItemsControl ItemsSource="{Binding RecentJobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Cursor="Hand"
                                        Margin="0,0,0,8">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                                    </Border.InputBindings>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Job info -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{StaticResource BrTextPrimary}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="{StaticResource BrAccentGlow}"
                                                        BorderBrush="{StaticResource BrAccent}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="6,1"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding RevLabel}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource BrAccent}"
                                                               FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding ModifiedLabel}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource BrTextMuted}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Issue badge -->
                                        <Border Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Padding="10,4"
                                                CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                                            <Setter Property="Background" Value="#3A280A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding IssueLabel}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize"   Value="11"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="{StaticResource BrSuccess}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BrAmber}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ── Footer ───────────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource BrHeader}"
                BorderBrush="{StaticResource BrBorder}"
                BorderThickness="0,1,0,0"
                Padding="40,8">
            <TextBlock Text="{Binding AppVersion}"
                       FontSize="10"
                       Foreground="{StaticResource BrTextMuted}"/>
        </Border>
    </Grid>
</UserControl>
