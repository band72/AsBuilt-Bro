<UserControl x:Class="RCS.Cogo.Wpf.Views.AsBuilt.ValidationPhaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header / summary bar -->
            <RowDefinition Height="Auto"/>   <!-- Category filter -->
            <RowDefinition Height="*"/>      <!-- Issue list -->
        </Grid.RowDefinitions>

        <!-- ── Summary bar ────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="16,12"
                BorderBrush="#1E1E2E" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#11111B"/>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Counters -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="VALIDATION CENTER" FontSize="9" FontWeight="SemiBold"
                               Foreground="#BAC2DE" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="BadgeErrors" Background="#4D1A1A" CornerRadius="4"
                                Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtErrorCount" Text="0"
                                           FontSize="22" FontWeight="Bold" Foreground="#F38BA8"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text=" Errors" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#F38BA8" FontFamily="Segoe UI"
                                           VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="BadgeWarnings" Background="#4D3D1A" CornerRadius="4"
                                Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtWarnCount" Text="0"
                                           FontSize="22" FontWeight="Bold" Foreground="#FAB387"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text=" Warnings" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#FAB387" FontFamily="Segoe UI"
                                           VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="BadgePassed" Background="#1A3D1A" CornerRadius="4"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtPassCount" Text="0"
                                           FontSize="22" FontWeight="Bold" Foreground="#A6E3A1"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text=" Passed" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#A6E3A1" FontFamily="Segoe UI"
                                           VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <Border x:Name="ExportGateBadge" CornerRadius="6" Padding="14,8" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#4D1A1A"/>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="CloseCircle" Width="14" Height="14" Foreground="#F38BA8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtExportGate" Text="Export Blocked"
                                       FontSize="13" FontWeight="Bold" Foreground="#F38BA8"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource BtnPhaseActionBlue}" Click="BtnRunValidation_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Play" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Run Validation Now" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Category filter strip ──────────────────────────────────── -->
        <Border Grid.Row="1" Background="#0F0F17" Padding="10,6"
                BorderBrush="#1E1E2E" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter:" FontSize="11" Foreground="#BAC2DE"
                           FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="BtnFilterAll" Content="All" Tag="All" Click="FilterBtn_Click"
                        Padding="10,4" Background="#1C1C2E" Foreground="#CDD6F4"
                        BorderBrush="#89B4FA" BorderThickness="1"
                        FontFamily="Segoe UI" FontSize="11" Margin="0,0,5,0"/>
                <Button Content="Geometry"     Tag="Geometry"     Click="FilterBtn_Click" Padding="10,4" Background="#1C1C2E" Foreground="#BAC2DE" BorderBrush="#1E1E2E" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Margin="0,0,5,0"/>
                <Button Content="Structures"   Tag="Structures"   Click="FilterBtn_Click" Padding="10,4" Background="#1C1C2E" Foreground="#BAC2DE" BorderBrush="#1E1E2E" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Margin="0,0,5,0"/>
                <Button Content="Runs"         Tag="Runs"         Click="FilterBtn_Click" Padding="10,4" Background="#1C1C2E" Foreground="#BAC2DE" BorderBrush="#1E1E2E" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Margin="0,0,5,0"/>
                <Button Content="Parts"        Tag="PartsMapping" Click="FilterBtn_Click" Padding="10,4" Background="#1C1C2E" Foreground="#BAC2DE" BorderBrush="#1E1E2E" BorderThickness="1" FontFamily="Segoe UI" FontSize="11" Margin="0,0,5,0"/>
                <Button Content="Coordinates"  Tag="Coordinates"  Click="FilterBtn_Click" Padding="10,4" Background="#1C1C2E" Foreground="#BAC2DE" BorderBrush="#1E1E2E" BorderThickness="1" FontFamily="Segoe UI" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- ── Issue list ─────────────────────────────────────────────── -->
        <ListBox Grid.Row="2" x:Name="IssueList"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="IssueList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="8,2" CornerRadius="6" Padding="12,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#11111B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                        <Setter Property="Background" Value="#1F0D0D"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                        <Setter Property="Background" Value="#1F1A0D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Severity badge -->
                            <Border Grid.Column="0" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                <Setter Property="Background" Value="#4D1A1A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                <Setter Property="Background" Value="#4D3D1A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                <Setter Property="Background" Value="#1A2D4D"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="SemiBold"
                                           FontFamily="Segoe UI" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Foreground" Value="#F38BA8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Foreground" Value="#FAB387"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                    <Setter Property="Foreground" Value="#89B4FA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Category -->
                            <TextBlock Grid.Column="1" Text="{Binding Category}"
                                       FontSize="10" Foreground="#BAC2DE"
                                       FontFamily="Segoe UI" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Message -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Message}"
                                           FontSize="12" Foreground="#CDD6F4"
                                           FontFamily="Segoe UI" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SuggestedFix, StringFormat='Fix: {0}'}"
                                           FontSize="10" Foreground="#BAC2DE"
                                           FontFamily="Segoe UI" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SuggestedFix}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Action buttons -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource BtnActionSmallBlue}" Margin="0,0,4,0" Tag="{Binding}" Click="BtnZoomTo_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Magnify" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Zoom" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Tag="{Binding}" Click="BtnAutoFix_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Check" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Fix" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnActionSmallGreen}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AutoFixable}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
