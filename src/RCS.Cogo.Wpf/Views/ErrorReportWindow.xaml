<Window x:Class="RCS.Cogo.Wpf.Views.ErrorReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report an Issue" Height="420" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBand}">
            <TextBlock Text="🐛  Bug Report / Error Submission"
                       VerticalAlignment="Center"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextPrimary}"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,16">
            <TextBlock Style="{StaticResource FieldLabel}" Text="SEVERITY"/>
            <ComboBox x:Name="CmbSeverity" Width="180" HorizontalAlignment="Left"
                      Margin="0,0,0,16">
                <ComboBoxItem Content="Low"/>
                <ComboBoxItem Content="Medium" IsSelected="True"/>
                <ComboBoxItem Content="High"/>
                <ComboBoxItem Content="Critical"/>
            </ComboBox>

            <TextBlock Style="{StaticResource FieldLabel}"
                       Text="DESCRIBE WHAT YOU WERE DOING AND THE ERROR"/>
            <TextBox x:Name="TxtDescription"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     Height="180" VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource MonoTextBox}"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource WindowFooterBand}">
            <Grid>
                <TextBlock x:Name="TxtStatus"
                           Foreground="{StaticResource BrSuccess}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="BtnCancel_Click"
                            Style="{StaticResource BtnGhost}" Width="90" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSubmit" Content="Submit Report" Click="BtnSubmit_Click"
                            Style="{StaticResource BtnPrimary}" Width="130"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
