<Application x:Class="RCS.Cogo.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RCS.Cogo.Wpf"
             StartupUri="Views/ShellWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RCS.Cogo.Wpf;component/Resources/Symbols.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="#E0E0E0"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="BorderBrush" Value="Gray"/>
                <Setter Property="IsEditable" Value="True"/>
                <Setter Property="IsReadOnly" Value="True"/>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="#E0E0E0"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            
            <DataTemplate x:Key="ImageSymbolTemplateString">
                <Image Source="{Binding}" Width="28" Height="28" Stretch="Uniform"/>
            </DataTemplate>
            <DataTemplate x:Key="ImageSymbolTemplateEntity">
                <Image Source="{Binding Symbol}" Width="28" Height="28" Stretch="Uniform"/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
